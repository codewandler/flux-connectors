{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codewandler.com/flux-connectors/migration/conformance-v1.schema.json",
  "title": "Flux legacy-plugin versus Exchange conformance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "adapter", "connector", "surface", "evidence", "cases"],
  "properties": {
    "format": { "const": "flux-connectors-conformance/v1" },
    "adapter": { "$ref": "#/$defs/id" },
    "connector": { "$ref": "#/$defs/id" },
    "surface": { "$ref": "#/$defs/surface" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "resource"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 }
      }
    },
    "authority_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/authority" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "schema"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "schema": {}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_id",
        "replacement_id",
        "input_schema",
        "output_schema",
        "errors",
        "host_effects",
        "semantic_effects",
        "risk",
        "idempotency",
        "capability_subjects"
      ],
      "properties": {
        "legacy_id": { "$ref": "#/$defs/id" },
        "replacement_id": { "$ref": "#/$defs/id" },
        "input_schema": {},
        "output_schema": {},
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        },
        "host_effects": { "$ref": "#/$defs/string_list" },
        "semantic_effects": { "$ref": "#/$defs/string_list" },
        "risk": { "enum": ["low", "medium", "high", "destructive"] },
        "idempotency": { "enum": ["idempotent", "repeatable", "non_repeatable"] },
        "capability_subjects": { "$ref": "#/$defs/authority_list" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_id",
        "replacement_id",
        "payload_schema",
        "host_effects",
        "semantic_effects",
        "capability_subjects"
      ],
      "properties": {
        "legacy_id": { "$ref": "#/$defs/id" },
        "replacement_id": { "$ref": "#/$defs/id" },
        "payload_schema": {},
        "host_effects": { "$ref": "#/$defs/string_list" },
        "semantic_effects": { "$ref": "#/$defs/string_list" },
        "capability_subjects": { "$ref": "#/$defs/authority_list" }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_schema", "terminal_schema"],
      "properties": {
        "item_schema": {},
        "terminal_schema": {}
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquire", "renew", "release"],
      "properties": {
        "acquire": { "type": "string", "minLength": 1 },
        "renew": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "cancellation", "stream", "lease"],
      "properties": {
        "mode": { "enum": ["one_shot", "stream", "lease"] },
        "cancellation": { "enum": ["not_applicable", "bounded"] },
        "stream": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/stream" }
          ]
        },
        "lease": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/lease" }
          ]
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "events", "lifecycle"],
      "properties": {
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "evidence_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "source_commit", "captured_at", "raw_sha256"],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "captured_at": { "type": "string", "minLength": 1 },
        "raw_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "nullable_evidence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/evidence_identity" }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy", "exchange"],
      "properties": {
        "legacy": { "$ref": "#/$defs/nullable_evidence" },
        "exchange": { "$ref": "#/$defs/nullable_evidence" }
      }
    },
    "member": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "legacy_id", "replacement_id"],
          "properties": {
            "kind": { "const": "operation" },
            "legacy_id": { "$ref": "#/$defs/id" },
            "replacement_id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "legacy_id", "replacement_id"],
          "properties": {
            "kind": { "const": "event" },
            "legacy_id": { "$ref": "#/$defs/id" },
            "replacement_id": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "topology"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "topology": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "returned" },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code", "error"],
          "properties": {
            "kind": { "const": "declared_error" },
            "code": { "type": "string", "minLength": 1 },
            "error": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "class", "code", "status", "sent", "retryable"],
          "properties": {
            "kind": { "const": "refused" },
            "class": { "enum": ["runtime", "topology", "authority", "input", "policy"] },
            "code": { "type": "string", "minLength": 1 },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "sent": { "enum": ["no", "maybe"] },
            "retryable": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "payload"],
          "properties": {
            "kind": { "const": "event" },
            "payload": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sequence", "value"],
          "properties": {
            "kind": { "const": "stream_item" },
            "sequence": { "type": "integer", "minimum": 0 },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code"],
          "properties": {
            "kind": { "const": "cancelled" },
            "code": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "lease"],
          "properties": {
            "kind": { "const": "lease_acquired" },
            "lease": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "lease"],
          "properties": {
            "kind": { "const": "lease_renewed" },
            "lease": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "lease"],
          "properties": {
            "kind": { "const": "lease_released" },
            "lease": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status", "value"],
          "properties": {
            "kind": { "const": "terminal" },
            "status": { "type": "string", "minLength": 1 },
            "value": {}
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_effects", "semantic_effects", "capability_subjects", "transcript"],
      "properties": {
        "host_effects": { "$ref": "#/$defs/string_list" },
        "semantic_effects": { "$ref": "#/$defs/string_list" },
        "capability_subjects": { "$ref": "#/$defs/authority_list" },
        "transcript": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        }
      }
    },
    "nullable_observation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/observation" }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member", "input", "exchange_execution", "legacy", "exchange"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "member": { "$ref": "#/$defs/member" },
        "input": {},
        "exchange_execution": { "$ref": "#/$defs/execution" },
        "legacy": { "$ref": "#/$defs/nullable_observation" },
        "exchange": { "$ref": "#/$defs/nullable_observation" }
      }
    }
  }
}
