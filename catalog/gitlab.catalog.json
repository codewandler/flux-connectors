  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "GitLab personal access token sent as a bearer. A token scoped to read_api is enough for every read below; the api scope is required for gitlab-issue-create",
      "env": [
        "GITLAB_TOKEN"
      ],
      "name": "gitlab.token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "user"
    },
    {
      "description": "GitLab OAuth2 access token obtained on behalf of a signed-in user. Bounded by that user's own permissions, never by the application's",
      "name": "gitlab.oauth_token",
      "oauth2": {
        "authorize_path": "/oauth/authorize",
        "endpoint": "login",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "scopes": [
          "read_api",
          "read_user",
          "read_repository"
        ],
        "token_path": "/oauth/token"
      },
      "scheme": {
        "kind": "bearer"
      },
      "subject": "user"
    }
  ],
  "authority": "com.gitlab.api",
  "config": [
    {
      "also_services": [
        "login"
      ],
      "approval": "operator",
      "binds": "endpoint.origin",
      "default": "https://gitlab.com",
      "docs_url": "https://docs.gitlab.com/administration/",
      "example": "https://gitlab.company.example",
      "format": "origin",
      "help": "The HTTPS origin only, without `/api/v4` or another path. Leave the default for GitLab.com; a self-managed origin requires deployment/operator approval before it becomes active",
      "label": "GitLab origin",
      "level": "connection",
      "name": "origin",
      "required": false,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.client_id",
      "docs_url": "https://docs.gitlab.com/integration/oauth_provider/",
      "example": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2",
      "format": "text",
      "help": "Create an application under Admin -> Applications (self-managed) or User Settings -> Applications (gitlab.com), with the redirect URI your deployment serves. This is the application id, which is public",
      "label": "GitLab OAuth application id",
      "level": "operator",
      "name": "oauth_client_id",
      "required": false,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.redirect_uri",
      "docs_url": "https://docs.gitlab.com/integration/oauth_provider/",
      "example": "https://exchange.internal/api/oauth/callback",
      "format": "url",
      "help": "The callback address this deployment serves, registered as a redirect URI on the application above. GitLab matches it exactly, so it must be the same string in both places — including the scheme, any port, and no trailing slash",
      "label": "GitLab OAuth redirect URI",
      "level": "operator",
      "name": "oauth_redirect_uri",
      "required": false,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.client_secret",
      "docs_url": "https://docs.gitlab.com/integration/oauth_provider/",
      "format": "token",
      "help": "The application secret issued beside the id above. Supplied once by whoever runs this deployment, never by an end user",
      "label": "GitLab OAuth application secret",
      "level": "operator",
      "name": "oauth_client_secret",
      "required": false,
      "secret": true,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.gitlab.token",
      "docs_url": "https://docs.gitlab.com/ee/user/profile/personal_access_tokens.html",
      "format": "token",
      "help": "Create one in the selected GitLab installation's User Settings -> Access Tokens. Grant read_api for every read below, or api if you also want gitlab-issue-create to work",
      "label": "GitLab personal access token",
      "level": "connection",
      "name": "token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
