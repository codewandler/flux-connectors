      "description": "List the zones (domains) this API token can see, with each zone's id, name, status and assigned Cloudflare name servers. Returns Cloudflare's first page only; this connector declares no page or filter parameters (see the connector's header note). The zone `id` returned here is the value an operator pins as this connection's `zone_id`; every other operation in this connector is already scoped to that one zone and does not take it as an argument",
      "direction": "read",
      "expose": true,
      "id": "cloudflare-zone-list",
      "idempotency": "idempotent",
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errors/0/code",
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/zones"
      },
      "response_schema": {
        "properties": {
          "errors": {
            "items": {
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "result": {
            "items": {
              "properties": {
                "id": {
                  "description": "The zone's id, 32 lowercase hex characters — pass this as `zone_id` to every other operation",
                  "pattern": "^[0-9a-f]{32}$",
                  "type": "string"
                },
                "name": {
                  "description": "The registrable domain, e.g. example.com",
                  "type": "string"
                },
                "name_servers": {
                  "description": "The Cloudflare name servers this zone's registrar should point at",
