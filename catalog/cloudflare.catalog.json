      ],
      "description": "Purge every cached asset for a zone, immediately, for every visitor worldwide. There is no partial or selective purge in this connector (see its header note) — every call empties the whole zone's edge cache. Repeating it changes nothing further, but each call can spike load on the origin as the cache refills, so it should not be called more often than a real cache-affecting change warrants",
      "direction": "write",
      "endpoint": {
        "zone_id": [
          "path"
        ]
      },
      "expose": true,
      "id": "cloudflare-cache-purge",
      "idempotency": "conditional",
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errors/0/code",
          "message_pointer": "/errors/0/message"
        }
      },
      "repeatability_condition": "`purge_everything` names a target state rather than applying a delta, so a repeat leaves the zone exactly where the first call left it — purging an already-empty edge cache is a no-op. Conditional rather than idempotent because the cache refills from origin between calls, so a stored result must never be served in place of running it",
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "purge_everything": true
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/zones/{zone_id}/purge_cache"
