    {
      "auth": [
        [
          "calendly.access_token"
        ]
      ],
      "description": "List a scheduled event's invitees. Each invitee is personal data about a named third party — their name, email and any answers they gave to the event type's custom questions. Read it only for what the calling flow needs and do not persist or repeat it beyond that",
      "direction": "read",
      "expose": true,
      "id": "calendly-invitee-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The event's bare UUID — the last path segment of its own `uri`. Pass only the UUID here, never the full URI",
          "name": "uuid",
          "position": "path",
          "required": true,
          "schema": {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        {
          "description": "Filter to `active` (not canceled) or `canceled` invitees",
          "name": "status",
          "position": "query",
          "required": false,
          "schema": {
            "enum": [
              "active",
              "canceled"
            ],
            "type": "string"
          }
        },
        {
          "description": "Results per page; Calendly caps this at 100",
          "name": "count",
          "position": "query",
          "required": false,
          "schema": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/title",
          "message_pointer": "/message"
        }
      },
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "count",
            "value": {
              "$param": "count"
            }
          },
          {
            "name": "status",
            "value": {
              "$param": "status"
            }
          }
        ],
        "url": "{base}/scheduled_events/{uuid}/invitees"
      },
      "response_schema": {
        "properties": {
          "collection": {
            "description": "The event's invitees — personal data",
            "items": {
              "properties": {
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "email": {
                  "description": "The invitee's own email address — personal data, never an example value",
                  "type": "string"
                },
                "name": {
                  "description": "The invitee's own name — personal data, never an example value",
                  "type": "string"
                },
                "questions_and_answers": {
                  "description": "The invitee's free-text answers to the event type's custom booking questions — personal data, shape not enumerated further",
                  "type": "array"
                },
                "status": {
                  "description": "`active` or `canceled`",
                  "type": "string"
                },
                "timezone": {
                  "description": "IANA timezone name the invitee booked in",
                  "type": "string"
                },
                "updated_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                }
              },
              "required": [
                "uri",
                "email",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "pagination": {
            "description": "Cursor pagination; see calendly-event-type-list's response_schema comment for why no cursor parameter is declared",
            "type": "object"
          }
        },
        "required": [
          "collection"
        ],
        "type": "object"
      },
      "risk": "low",
