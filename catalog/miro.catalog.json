    {
      "auth": [
        [
          "miro.access_token"
        ]
      ],
      "description": "Update a sticky note's text content. The content sent replaces what was there, so setting the same content twice ends in the same state. The updated note is in the response",
      "direction": "write",
      "expose": true,
      "id": "miro-sticky-note-update",
      "idempotency": "conditional",
      "params": [
        {
          "description": "The board's id, as returned by miro-board-list",
          "name": "board_id",
          "position": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "The sticky note's id, as returned by miro-board-item-list or miro-sticky-note-create",
          "name": "item_id",
          "position": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "The sticky note's new text content, as HTML, replacing the existing content entirely",
          "name": "content",
          "position": "body",
          "required": true,
          "schema": {
            "type": "string"
          },
          "wire": "data.content"
        }
      ],
      "repeatability_condition": "the request carries the note's whole content as an absolute value rather than a delta, so re-sending the same body leaves the note in the state the caller asked for, however many times it runs",
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "data": {
              "content": {
                "$param": "content"
              }
            }
          }
        },
        "headers": {
