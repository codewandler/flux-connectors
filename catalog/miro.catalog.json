                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "type": {
                      "const": "text",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "type": "object"
                },
                {
                  "description": "A frame — a container other items reference by `parent.id`; a frame never embeds its members' bodies",
                  "properties": {
                    "data": {
                      "properties": {
                        "title": {
                          "type": "string"
