                  "type": "object"
                },
                {
                  "description": "A shape",
                  "properties": {
                    "data": {
                      "properties": {
                        "content": {
                          "type": "string"
                        },
                        "shape": {
                          "description": "e.g. rectangle, circle, triangle",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "geometry": {
                      "properties": {
                        "height": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "id": {
                      "type": "string"
                    },
                    "parent": {
                      "nullable": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "position": {
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "type": {
                      "const": "shape",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "type": "object"
                },
                {
                  "description": "A text item",
                  "properties": {
                    "data": {
                      "properties": {
                        "content": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "geometry": {
                      "properties": {
                        "height": {
                          "type": "number"
