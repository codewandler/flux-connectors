    {
      "auth": [
        [
          "miro.access_token"
        ]
      ],
      "description": "Create a sticky note on a board. Miro does not deduplicate: creating the same content twice makes two sticky notes, so this is not idempotent. The created note, with its assigned id, is in the response",
      "direction": "write",
      "expose": true,
      "id": "miro-sticky-note-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The board's id, as returned by miro-board-list",
          "name": "board_id",
          "position": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "The sticky note's text content, as HTML",
          "name": "content",
          "position": "body",
          "required": true,
          "schema": {
            "type": "string"
          },
          "wire": "data.content"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "data": {
              "content": {
                "$param": "content"
              }
            }
