                    "geometry": {
                      "properties": {
                        "height": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "id": {
                      "type": "string"
                    },
                    "position": {
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "type": {
                      "const": "frame",
