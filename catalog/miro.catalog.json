{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Miro access token (a personal access token or an OAuth2 access token), sent as a bearer token, scoped to read and write boards, board items and sticky notes",
      "env": [
        "MIRO_ACCESS_TOKEN"
      ],
      "name": "miro.access_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.miro.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.miro.access_token",
      "docs_url": "https://developers.miro.com/docs/getting-started-with-oauth",
      "format": "token",
      "help": "Create one at your Miro app's settings (developers.miro.com) or from a personal access token under a board's Settings -> Apps, scoped to boards:read and boards:write. Miro shows the token once",
      "label": "Miro access token",
      "level": "connection",
      "name": "access_token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "miro",
  "default_auth": [
    [
      "miro.access_token"
    ]
  ],
  "description": "Miro boards and board items: discover boards, read items of any type, and create, update and delete sticky notes",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "miro.access_token"
        ]
      ],
      "description": "List the boards this access token can see, with each board's id, name and description. Returns Miro's first page only; this connector declares no cursor or limit parameter (see the connector's header note). The board `id` returned here is what every other operation in this connector needs as `board_id`",
      "direction": "read",
      "expose": true,
      "id": "miro-board-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/boards"
      },
      "response_schema": {
        "properties": {
          "cursor": {
            "description": "Opaque pagination token for the next page; not usable by this connector (see the header note)",
            "type": "string"
          },
          "data": {
            "items": {
              "properties": {
                "createdAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "description": {
                  "description": "The board's description, empty string when none",
                  "type": "string"
                },
                "id": {
                  "description": "The board's id — pass this as `board_id` to every other operation",
                  "type": "string"
                },
                "modifiedAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "name": {
                  "description": "The board's display name",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "miro.access_token"
        ]
      ],
      "description": "List the items on a board, of any type (sticky note, shape, text or frame). Each item's shape depends on its `type`: sticky notes and text carry `data.content`, shapes carry `data.content` and `data.shape`, frames carry `data.title`. Returns Miro's first page only; this connector declares no cursor or limit parameter (see the connector's header note)",
