                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "encoding",
            "fields"
          ],
          "type": "object"
        }
      ]
    },
    "body_template": {
      "description": "A JSON body: literals, nested objects and arrays, `$param` splices at caller leaves. Nothing else has a spelling.",
      "oneOf": [
        {
          "$ref": "#/$defs/param_splice"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/body_template"
          },
          "not": {
            "required": [
              "$param"
            ]
          },
          "type": "object"
        },
        {
          "items": {
            "$ref": "#/$defs/body_template"
          },
          "type": "array"
        },
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    },
