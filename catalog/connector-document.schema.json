  "$id": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One canonical, deterministic catalog document per provider (Decision 0022, C-536): the complete published connector surface, including an explicit request template per operation. The template vocabulary is closed and total — literal values, `{var}` interpolation over caller parameters and endpoint slots, and `$param` splices — and the oauth2 object deliberately has no field for a registration value: the client identifier and secret are per-deployment, published only as operator-level configuration requirements through the `binds` grammar.",
  "properties": {
    "$schema": {
      "const": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json"
    },
    "auth": {
      "items": {
        "$ref": "#/$defs/auth"
      },
      "type": "array"
    },
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/channel"
      },
      "type": "array"
    },
    "config": {
      "items": {
        "$ref": "#/$defs/config_field"
      },
      "type": "array"
    },
    "connector": {
      "minLength": 1,
      "type": "string"
    },
    "default_auth": {
      "$ref": "#/$defs/requirements"
    },
    "description": {
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/event"
      },
      "type": "array"
    },
    "generator": {
      "minLength": 1,
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/operation"
      },
      "type": "array"
    },
    "runtime": {
      "enum": [
        "http",
        "socket",
        "process",
        "container",
        "plugin",
        "remote"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "services": {
      "items": {
        "$ref": "#/$defs/service"
      },
      "minItems": 1,
      "type": "array"
    },
    "vendor": {
      "type": "string"
    },
    "verify": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "generator",
    "connector",
    "runtime",
    "services",
    "operations"
  ],
  "title": "flux-connectors canonical catalog document",
  "type": "object"
}
