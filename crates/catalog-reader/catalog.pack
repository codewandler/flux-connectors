  "description": "Confluence Cloud wiki: find spaces, list the pages in one, read a page's metadata, publish a new page, and comment on one. Page and comment *content* cannot be read back — see the connector's notes",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "confluence.api_token"
        ]
      ],
      "description": "List the spaces on the Confluence site, with the id, key and name of each. Takes no argument, and is this connector's `verify`: a bounded read that runs unattended and needs nothing configured beyond the credential. Returns only Confluence's first page of 25 spaces — paging needs the `cursor` and `limit` query parameters this connector cannot send, so a site with more spaces is truncated with no further signal than a `_links.next` this connector cannot follow",
      "direction": "read",
      "endpoint": {
        "site": [
          "host"
        ]
      },
      "expose": true,
      "id": "confluence-space-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/api/v2/spaces"
      },
      "response_schema": {
        "properties": {
          "_links": {
            "description": "Pagination envelope. `next` holds the RELATIVE URL of the following page with an opaque cursor embedded in it (`/wiki/api/v2/spaces?limit=25&cursor=…`). **This connector cannot follow it** — the cursor is a query parameter it cannot send (C-30), and the value is a URL rather than the bare token a cursor quirk would need. Its presence means only that more spaces exist",
            "properties": {
              "base": {
                "description": "The Confluence site's base URL, for resolving the relative links above",
                "format": "uri",
                "type": "string"
              },
              "next": {
                "description": "Unusable here; see this field's own description. Absent when there is no further page",
                "type": "string"
              }
            },
            "type": "object"
          },
          "results": {
            "description": "This page's spaces — at most 25, and there is no way to fetch the rest",
            "items": {
              "properties": {
                "_links": {
                  "description": "Carries `webui`, the space's path in the Confluence UI — append it to the site URL to give a human a link",
                  "type": "object"
                },
                "authorId": {
                  "description": "Account id of whoever created the space. An `accountId`, never a username or email",
                  "type": "string"
                },
                "createdAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "description": {
                  "description": "EMPTY IN THIS RESPONSE. Populating it needs the `description-format` query parameter, which this connector cannot send",
                  "type": "object"
                },
                "homepageId": {
                  "description": "The space's home page, as a page id — pass it to `confluence-page-get`. This is the usual entry point into a space's content",
                  "type": "string"
                },
                "icon": {
                  "description": "The space's icon, when it has one and `include-icon` was requested — which this connector cannot do, so absent",
                  "type": "object"
                },
                "id": {
                  "description": "The space's id, as a string. This is what `confluence-space-get` and `confluence-space-pages` address it by — **not** the `key`",
                  "type": "string"
                },
                "key": {
                  "description": "The space key, e.g. `ENG`. The short code that appears in a Confluence URL. Human-facing and stable, but the v2 API addresses spaces by `id`",
                  "type": "string"
                },
                "name": {
                  "description": "The space's display name",
                  "type": "string"
                },
                "status": {
                  "description": "`current` for a live space or `archived`",
                  "type": "string"
                },
                "type": {
                  "description": "`global` for an ordinary space or `personal` for a user's own space",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "key",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
