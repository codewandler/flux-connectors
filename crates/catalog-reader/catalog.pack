    {
      "auth": [
        [
          "intercom.access_token"
        ]
      ],
      "description": "Get one conversation by id, with its state, the contacts on it and its message parts in Intercom's default rendering",
      "direction": "read",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "intercom-conversation-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The conversation's Intercom id — a decimal string such as `123`, as it appears in the inbox URL",
          "name": "conversation_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errors/0/code",
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/conversations/{conversation_id}"
      },
      "response_schema": {
        "properties": {
          "admin_assignee_id": {
            "description": "The assigned admin, or null when unassigned",
            "type": "integer"
          },
          "ai_agent_participated": {
            "description": "Whether Intercom's own AI agent replied in this conversation, which is worth knowing before a second automation replies too",
            "type": "boolean"
          },
          "contacts": {
            "description": "The customers on the conversation, as `{type, contacts: […]}` — a wrapper, not an array",
            "type": "object"
          },
          "conversation_parts": {
            "description": "THE MESSAGES, nested twice: `{type, conversation_parts: […], total_count}`. Each part carries `part_type` (`comment`, `note`, `assignment`, `close`), `body` as HTML, `author` and `created_at`. Only a page of them is returned — check `total_count`",
            "type": "object"
          },
          "conversation_rating": {
            "description": "The customer's rating of the conversation, or null: `{rating, remark, created_at, contact, teammate}`",
            "type": "object"
          },
          "created_at": {
            "description": "Unix seconds",
            "type": "integer"
          },
          "custom_attributes": {
            "type": "object"
          },
          "id": {
            "description": "The conversation id, a decimal string",
            "type": "string"
          },
          "open": {
            "description": "True while the conversation is unresolved — **including while it is snoozed**. Use with `state` rather than instead of it",
            "type": "boolean"
          },
          "priority": {
            "description": "`priority` or `not_priority` — Intercom's own two-valued flag, not a severity scale",
            "type": "string"
          },
          "read": {
            "description": "Whether a teammate has read it",
            "type": "boolean"
          },
          "snoozed_until": {
            "description": "Unix seconds when a snoozed conversation reopens, or null",
            "type": "integer"
          },
          "source": {
            "description": "How it started: `{type, id, delivered_as, subject, body, author, attachments}` — the first message, and `author` is who sent it",
            "type": "object"
          },
          "state": {
            "description": "The inbox state. `snoozed` is a *kind of open*: see `open` beside it",
            "enum": [
              "open",
              "closed",
              "snoozed"
            ],
            "type": "string"
          },
          "statistics": {
            "description": "Timing aggregates — first response time, last close time and so on — or null",
            "type": "object"
          },
          "tags": {
            "description": "The paginated wrapper shape — tags at `.data`",
            "type": "object"
          },
          "team_assignee_id": {
            "description": "The assigned team, or null",
            "type": "integer"
          },
          "teammates": {
            "description": "The admins on it, same wrapper shape, or null",
            "type": "object"
          },
          "title": {
            "description": "The subject, or null — most conversations have none",
            "type": "string"
          },
          "type": {
            "const": "conversation"
          },
          "updated_at": {
            "description": "Unix seconds",
            "type": "integer"
          },
          "waiting_since": {
            "description": "Unix seconds since the customer has been waiting for a reply, or null when they are not. This is the SLA-relevant field",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "id",
          "state"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "intercom.access_token"
        ]
      ],
      "description": "Reply to a conversation as an admin. With message_type `comment` the reply is delivered to the end user by email or in-app message and cannot be un-sent; with `note` it is an internal comment only teammates see",
      "direction": "write",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "intercom-conversation-reply",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The conversation to reply to",
          "name": "conversation_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "`comment` to reply to the end user, who receives it by email or in-app message, or `note` for an internal comment only teammates see. There is no default: state which audience you mean",
          "name": "message_type",
          "position": "body",
          "required": true,
          "schema": {
            "enum": [
              "comment",
              "note"
            ],
            "type": "string"
          }
        },
        {
          "description": "The id of the admin the reply is attributed to. The customer sees this teammate's name and avatar, so it must be an admin the operator is entitled to write as",
          "name": "admin_id",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The reply text as HTML; must not be blank. Intercom renders it in the customer's inbox or messenger",
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errors/0/code",
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "admin_id": {
              "$param": "admin_id"
            },
            "body": {
              "$param": "body"
            },
            "message_type": {
              "$param": "message_type"
            },
            "type": "admin"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/conversations/{conversation_id}/reply"
      },
      "response_schema": {
        "properties": {
          "admin_assignee_id": {
            "type": "integer"
          },
          "contacts": {
            "description": "`{type, contacts: […]}` — who the reply went to, when `message_type` was `comment`",
            "type": "object"
          },
          "conversation_parts": {
            "description": "WHERE THE SENT REPLY IS: `{type, conversation_parts: […], total_count}`, and the reply is the last entry. Its `part_type` is `comment` (delivered to the customer) or `note` (internal), which is the only confirmation of which audience was written to",
            "type": "object"
          },
          "created_at": {
            "description": "Unix seconds — of the conversation, not of this reply",
            "type": "integer"
          },
          "custom_attributes": {
            "type": "object"
          },
          "id": {
            "description": "The conversation's id, unchanged by the reply",
            "type": "string"
          },
          "open": {
            "description": "True while unresolved, including while snoozed",
            "type": "boolean"
          },
          "priority": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "snoozed_until": {
            "type": "integer"
          },
          "source": {
            "description": "The conversation's first message, not this reply",
            "type": "object"
          },
          "state": {
            "description": "The state after the reply. An admin comment on a closed conversation reopens it",
            "enum": [
              "open",
              "closed",
              "snoozed"
            ],
            "type": "string"
          },
          "statistics": {
            "type": "object"
          },
          "tags": {
            "type": "object"
          },
          "team_assignee_id": {
            "type": "integer"
          },
          "type": {
            "const": "conversation"
          },
          "updated_at": {
            "description": "Unix seconds, moved by this reply",
            "type": "integer"
          },
          "waiting_since": {
            "description": "Null after an admin reply, since the customer is no longer waiting",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "id",
          "state"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "intercom.access_token"
        ]
      ],
      "description": "Add an internal note to a contact, visible to teammates in the workspace and never to the contact. Adding the same note twice adds two notes",
      "direction": "write",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "intercom-contact-note-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The contact to note",
          "name": "contact_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The note text as HTML; must not be blank",
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The id of the admin the note is attributed to. Intercom treats this as optional; this operation requires it so every note has an author",
          "name": "admin_id",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errors/0/code",
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "admin_id": {
              "$param": "admin_id"
            },
            "body": {
              "$param": "body"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/contacts/{contact_id}/notes"
      },
      "response_schema": {
        "properties": {
          "author": {
            "description": "The admin it is attributed to: `{type, id, name, email, job_title, away_mode_enabled}`. This is what the required `admin_id` produced",
            "type": "object"
          },
          "body": {
            "description": "The note as stored, HTML",
            "type": "string"
          },
          "contact": {
            "description": "The contact it was attached to, as `{type, id}` — **nullable** in Intercom's schema, so confirm it rather than assuming the note landed on a person",
            "type": "object"
          },
          "created_at": {
            "description": "Unix seconds — an integer, e.g. 1674589321",
            "type": "integer"
          },
          "id": {
            "description": "The note's own id",
            "type": "string"
          },
          "type": {
            "const": "note"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "base_url": "https://{host}",
