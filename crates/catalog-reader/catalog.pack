          "name": "maxSilenceSeconds",
          "position": "query",
          "required": false,
          "schema": {
            "default": 0,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "description": "Action to take if a recording with the same name already exists.",
          "name": "ifExists",
          "position": "query",
