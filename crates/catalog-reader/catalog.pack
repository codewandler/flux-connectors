        "url": "{base}/conversations/{conversation_id}/messages"
      },
      "response_schema": {
        "properties": {
          "_pagination": {
            "description": "Carries `next`, a full absolute URL to the following page. This connector cannot follow it — see front-conversation-list's own response_schema for why — so a non-null `next` means more messages exist beyond this first page only",
            "properties": {
              "next": {
                "description": "Unusable here; see this field's own description",
                "type": "string"
              }
            },
            "type": "object"
          },
          "_results": {
            "description": "This page's messages, each `{id, type, is_inbound, author, recipients, subject, body, text, created_at}`",
            "items": {
              "properties": {
                "author": {
                  "description": "The teammate who sent this message — absent (`null`) on an inbound message, since nobody on the team authored it",
                  "properties": {
                    "id": {
                      "pattern": "^tea_[0-9a-z]+$",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "body": {
                  "description": "The message content, HTML for most channels",
                  "type": "string"
                },
                "created_at": {
                  "description": "Unix timestamp, seconds",
                  "type": "number"
                },
                "id": {
                  "description": "The message's id, prefixed `msg_`",
                  "pattern": "^msg_[0-9a-z]+$",
                  "type": "string"
                },
                "is_inbound": {
                  "description": "True for a message received from the outside party, false for one sent from Front",
                  "type": "boolean"
                },
                "recipients": {
                  "description": "Each `{name, handle, role}`; `role` is one of `from`, `to`, `cc`, `bcc` or `reply-to`",
                  "items": {
                    "properties": {
                      "handle": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "text": {
                  "description": "A plain-text rendering of `body`",
                  "type": "string"
                },
                "type": {
                  "description": "The channel kind this message travelled over, e.g. `email`, `sms` or `intercom`",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "front.api_token"
        ]
      ],
      "description": "Reply to a conversation, using its own existing recipients, channel and sender identity — this connector cannot override any of those (see providers/front.toml's header comment). Front queues delivery: the response is an acknowledgement, not the sent message, and is not visible to the recipient until Front actually delivers it",
      "direction": "write",
      "expose": true,
      "id": "front-conversation-reply",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The conversation's id, an opaque string prefixed `cnv_` (e.g. `cnv_55c8c149`) that a model must not invent — discover it from front-conversation-list or front-verify",
          "name": "conversation_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^cnv_[0-9a-z]+$",
            "type": "string"
          }
        },
        {
          "description": "The reply's content. Sent as-is to the conversation's existing recipients over its existing channel — this operation cannot redirect it to a different recipient list, channel or sender (C-56; see providers/front.toml's header comment)",
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/_error/status",
          "message_pointer": "/_error/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "body": {
              "$param": "body"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/conversations/{conversation_id}/messages"
      },
      "response_schema": {
        "description": "An acknowledgement that Front accepted the reply for delivery, not the sent message itself",
        "properties": {
          "message_uid": {
            "description": "A resource alias for the queued message. Not a `msg_`-prefixed id and not usable as one — Front assigns the real id only once delivery completes",
            "type": "string"
          },
          "status": {
            "const": "accepted"
          }
        },
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "front.api_token"
        ]
      ],
      "description": "Apply one or more existing tags to a conversation. Applying a tag the conversation already carries changes nothing — Front does not duplicate it. Answers 204 with an empty body on success",
      "direction": "write",
      "expose": true,
      "id": "front-conversation-tag-add",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The conversation's id, an opaque string prefixed `cnv_` (e.g. `cnv_55c8c149`) that a model must not invent — discover it from front-conversation-list or front-verify",
          "name": "conversation_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^cnv_[0-9a-z]+$",
            "type": "string"
          }
        },
        {
          "description": "The existing tag ids to apply, each an opaque string prefixed `tag_` that a model must not invent — discover them from a conversation's own `tags` field (front-conversation-get) or from Front's tag settings",
          "name": "tag_ids",
          "position": "body",
          "required": true,
          "schema": {
            "items": {
              "pattern": "^tag_[0-9a-z]+$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/_error/status",
          "message_pointer": "/_error/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "tag_ids": {
              "$param": "tag_ids"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/conversations/{conversation_id}/tags"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    }
