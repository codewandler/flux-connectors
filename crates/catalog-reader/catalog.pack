          },
          "currency": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "latest_charge": {
            "type": "string"
          },
          "object": {
            "const": "payment_intent"
          },
          "status": {
            "description": "`succeeded` after a successful capture",
            "type": "string"
          }
        },
        "required": [
