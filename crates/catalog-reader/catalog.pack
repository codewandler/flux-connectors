            "value": {
              "$param": "maxDurationSeconds"
            }
          },
          {
            "name": "maxSilenceSeconds",
            "value": {
              "$param": "maxSilenceSeconds"
            }
          },
          {
            "name": "name",
            "value": {
              "$param": "name"
            }
          },
          {
            "name": "recorder_format",
            "value": {
              "$param": "recorder_format"
            }
          },
          {
            "name": "terminateOn",
            "value": {
              "$param": "terminateOn"
            }
          }
        ],
        "url": "{base}/bridges/{bridgeId}/record"
