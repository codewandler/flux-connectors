      ],
      "description": "Read one contact by record id. Returns only HubSpot's default contact properties — name, email and record timestamps; a custom property needs a `properties` projection this connector cannot express yet",
      "direction": "read",
      "expose": true,
      "id": "hubspot-contact-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The contact's HubSpot record id (`hs_object_id`), e.g. 512",
          "name": "contact_id",
          "position": "path",
          "required": true,
          "schema": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/category",
          "message_pointer": "/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/crm/v3/objects/contacts/{contact_id}"
      },
      "response_schema": {
        "properties": {
          "archived": {
            "description": "True for a record in the recycle bin",
            "type": "boolean"
          },
          "archivedAt": {
            "description": "Present only on an archived record",
            "format": "date-time",
            "type": "string"
          },
          "associations": {
            "description": "Related records — companies, deals, tickets — keyed by object type. Returned only when asked for. Present on this read schema and absent from the create's",
            "type": "object"
          },
          "createdAt": {
            "description": "When the record was created — an ISO timestamp here, unlike the epoch-milliseconds string the equivalent `createdate` property carries",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The record id (`hs_object_id`) **as a string**, even though this operation takes it as a number",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The contact's property values, keyed by HubSpot's internal property name (`email`, `firstname`, `lastname`, `createdate`, `lastmodifieddate`, `hs_object_id`). EVERY VALUE IS A STRING regardless of the property's configured type — a number is `\"17\"`, a checkbox `\"false\"`, a date the epoch-milliseconds string `\"1572480000000\"`. Which keys are present depends on the portal's own property set and on the `properties` projection this connector cannot send",
            "type": "object"
          },
          "propertiesWithHistory": {
            "additionalProperties": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "description": "Previous values per property, each an array of `{value, timestamp, sourceType}`. Returned only when asked for, which this connector cannot do",
            "type": "object"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "properties",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "hubspot.access_token"
        ]
      ],
      "description": "Create a contact from an email address. HubSpot treats email as the contact's unique identifier and rejects a duplicate with 409. The new record is visible to everyone in the portal and can be enrolled by a workflow, which may send it marketing email",
      "direction": "write",
      "expose": true,
      "id": "hubspot-contact-create",
      "idempotency": "non_idempotent",
      "params": [
