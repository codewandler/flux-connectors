            "type": "array"
          },
          "limit": {
            "type": "integer"
          },
          "skip": {
            "type": "integer"
          },
          "sys": {
            "description": "The envelope's own type marker, e.g. `{\"type\": \"Array\"}`",
            "type": "object"
          },
          "total": {
            "description": "Total matching entries in the space, not just this page",
            "type": "integer"
          }
        },
        "required": [
          "sys",
          "total",
          "items"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "delivery"
    },
    {
      "auth": [
        [
          "contentful.delivery_token"
        ]
      ],
      "description": "Get one published asset (an uploaded file, e.g. an image) by id, with its metadata resolved to one locale",
      "direction": "read",
      "endpoint": {
