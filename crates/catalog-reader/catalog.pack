          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Message text, in Slack's mrkdwn syntax",
          "name": "text",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The `ts` of a parent message to reply to, threading the reply under it. Omit to post at channel level",
          "name": "thread_ts",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/error"
