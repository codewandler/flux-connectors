      "direction": "read",
      "expose": true,
      "id": "stripe-billing-meter-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
