          "position": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "description": "0-based page number",
          "name": "page",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "description": "Sort field",
          "name": "order_by",
          "position": "query",
          "required": false,
          "schema": {
            "enum": [
