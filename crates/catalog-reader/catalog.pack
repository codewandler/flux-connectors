    {
      "auth": [
        [
          "zendesk.messaging_key"
        ]
      ],
      "description": "List the participants of one conversation without exposing deep-object pagination",
      "direction": "read",
      "endpoint": {
        "appId": [
          "path"
        ],
        "subdomain": [
          "host"
        ]
      },
      "expose": true,
      "id": "zendesk-messaging-participant-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Identifies the conversation.",
          "name": "conversationId",
          "position": "path",
          "required": true,
          "schema": {
            "example": "redacted-opaque",
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/v2/apps/{appId}/conversations/{conversationId}/participants"
      },
      "response_schema": {
        "description": "List of returned participants.",
        "properties": {
          "links": {
            "description": "Previous and next page links, if they exist.",
            "properties": {
              "next": {
                "description": "A link to the next page. Not specified if there are no subsequent pages.",
                "example": "https://{subdomain}.zendesk.com/sc/v2/apps?page[after]=5ea868f862cdd24abf010b38",
                "type": "string"
              },
              "prev": {
                "description": "A link to the previous page. Not specified if there are no previous pages.",
                "example": "https://{subdomain}.zendesk.com/sc/v2/apps?page[before]=fcafad804c39a39648004af9",
                "type": "string"
              }
            },
            "type": "object"
          },
          "meta": {
            "description": "Response metadata.",
            "properties": {
              "afterCursor": {
                "description": "A record id that can be used as a `page[after]` parameter in a new request to get the next page.\nNot specified if there are no subsequent pages.\n",
                "example": "redacted-opaque",
                "type": "string"
              },
              "beforeCursor": {
                "description": "A record id that can be used as a `page[before]` parameter in a new request to get the previous page.\nNot specified if there are no previous pages.\n",
                "example": "redacted-opaque",
                "type": "string"
              },
              "hasMore": {
                "description": "A flag that indicates if there are more records that can be fetched.",
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "participants": {
            "items": {
              "properties": {
                "clientAssociations": {
                  "description": "Represents the clients that are active in the conversation for a particular\nuser. A participant can have multiple clientAssociations in the case of\nchannel transfer, business initiated conversations, or identified users.\nThe order of the array indicates how recently a client has interacted with\nthe conversation, with the most recent client first. The first item in the\narray is considered to be the user's primary client for that conversation,\nand will be selected first for message delivery.\n",
                  "items": {
                    "properties": {
                      "clientId": {
                        "description": "The id of the client being referenced.",
                        "example": "redacted-opaque",
                        "type": "string"
                      },
                      "type": {
                        "description": "The type of integration that the client represents. Can be any of the supported integration types, or sdk for integrations of type ios, android, unity and web.",
                        "enum": [
                          "apple",
                          "gbm",
                          "googlercs",
                          "instagram",
                          "kakao",
                          "line",
                          "mailgun",
                          "messagebird",
                          "messenger",
                          "slackconnect",
                          "sdk",
                          "telegram",
                          "twilio",
                          "twitter",
                          "viber",
                          "wechat",
                          "whatsapp"
                        ],
                        "example": "telegram",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "id": {
                  "description": "The unique ID of the participant.",
                  "example": "redacted-opaque",
                  "type": "string"
                },
                "lastRead": {
                  "description": "A datetime string with the format YYYY-MM-DDThh:mm:ss.SSSZ representing the latest message the user has read.",
                  "example": "2019-01-14T18:55:12.515Z",
                  "nullable": true,
                  "type": "string"
                },
                "unreadCount": {
                  "description": "Number of messages the user has not yet read.",
                  "example": 0,
                  "type": "integer"
                },
                "userExternalId": {
                  "description": "The externalId of the associated user.",
                  "example": "your-own-id",
                  "nullable": true,
                  "type": "string"
                },
                "userId": {
                  "description": "The id of the associated user.",
                  "example": "redacted-opaque",
                  "type": "string"
                }
              },
              "type": "object",
              "x-resourceId": "Participants"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
