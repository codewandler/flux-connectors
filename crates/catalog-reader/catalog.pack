        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/crm/v3/objects/contacts"
      },
      "response_schema": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The new record's id, as a string. This is the `contact_id` for a following update — and the update's parameter is a number, so it has to be converted",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The created record's properties, keyed by internal name, EVERY VALUE A STRING. HubSpot fills in more than was sent — `createdate`, `lastmodifieddate` and `hs_object_id` at minimum",
            "type": "object"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "warnings": {
            "description": "Non-fatal complaints about the create — a property HubSpot ignored, for instance. Present only on the create schema, and worth reading: the call still succeeded",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "properties",
          "createdAt",
          "updatedAt",
          "archived"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "hubspot.access_token"
        ]
      ],
      "description": "Overwrite a contact's first and last name. Both are written on every call — this operation replaces them rather than merging, so re-send the one you are not changing (read it first with hubspot-contact-get). The change is visible to everyone in the portal and can trigger a workflow",
