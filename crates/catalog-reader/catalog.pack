      "direction": "read",
      "expose": true,
      "id": "github-repo-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The repository owner — a user or organisation login",
          "name": "owner",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The repository name, without the owner prefix",
          "name": "repo",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/vnd.github+json"
        },
        "method": "GET",
        "url": "{base}/repos/{owner}/{repo}"
      },
      "response_schema": {
        "properties": {
          "archived": {
            "description": "An archived repository is read-only — a write against it fails, so check this before `github-issue-create`",
            "type": "boolean"
          },
          "default_branch": {
            "type": "string"
          },
          "description": {
            "description": "Null when the repository has none",
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "fork": {
            "type": "boolean"
          },
          "full_name": {
            "description": "`owner/repo`, which is how every other operation here addresses it",
            "type": "string"
          },
          "html_url": {
            "format": "uri",
            "type": "string"
          },
          "id": {
            "description": "The repository's global id, stable across renames",
            "type": "integer"
          },
          "language": {
            "description": "The dominant language, or null",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "open_issues_count": {
            "description": "Open issues **and** open pull requests, since GitHub counts a PR as an issue",
            "type": "integer"
          },
          "owner": {
            "description": "The owning user or organisation: `login`, `id`, `type` (`User` or `Organization`), `avatar_url`, `html_url`",
            "type": "object"
          },
          "permissions": {
            "description": "What the authenticated token can do here: `admin`, `push` and `pull` are always present, `maintain` and `triage` only sometimes. Absent entirely for an unauthenticated read",
            "type": "object"
          },
          "private": {
            "type": "boolean"
          },
          "pushed_at": {
            "format": "date-time",
            "type": "string"
          },
          "stargazers_count": {
            "type": "integer"
          },
          "visibility": {
            "description": "`public` or `private` per the reference; an enterprise repository can also be `internal`, so this is deliberately not a closed enum",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "full_name",
          "private",
          "owner"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
