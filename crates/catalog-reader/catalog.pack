          "description": "Timeout (in seconds) before giving up dialing, or -1 for no timeout.",
          "name": "timeout",
          "position": "query",
          "required": false,
          "schema": {
            "default": 30,
            "format": "int32",
            "type": "integer"
          }
        },
        {
          "description": "The unique id to assign the channel on creation.",
          "name": "channelId",
          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
