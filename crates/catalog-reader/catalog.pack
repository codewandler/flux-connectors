      ],
      "description": "List the signed-in user's Outlook master categories with the Microsoft Graph MailboxSettings.Read permission",
      "direction": "read",
      "expose": true,
      "id": "microsoft_graph-calendar-category-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Show only the first n items",
          "name": "$top",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "description": "Skip the first n items",
          "name": "$skip",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "$skip",
            "value": {
              "$param": "$skip"
            }
          },
          {
            "name": "$top",
