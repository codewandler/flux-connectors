                          }
                        },
                        "type": "object"
                      },
                      "rel": {
                        "nullable": true,
                        "type": "string"
                      },
                      "to": {
                        "properties": {
                          "address": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
