        [
          "asterisk.password"
        ]
      ],
      "description": "Create a new bridge.",
      "direction": "write",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "asterisk-ari-bridges-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "Comma separated list of bridge type attributes (mixing, holding, dtmf_events, proxy_media, video_sfu, video_single, sdp_label).",
          "name": "type",
          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Unique ID to give to the bridge being created.",
          "name": "bridgeId",
          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Name to give to the bridge being created.",
          "name": "name",
          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "variables",
          "position": "body",
          "required": false,
          "schema": {
            "additionalProperties": true,
            "type": "object"
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "variables": {
              "$param": "variables"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "query": [
          {
            "name": "bridgeId",
            "value": {
              "$param": "bridgeId"
            }
          },
          {
            "name": "name",
            "value": {
              "$param": "name"
            }
          },
          {
            "name": "type",
            "value": {
              "$param": "type"
            }
          }
        ],
        "url": "{base}/bridges"
      },
      "response_schema": {
        "description": "The merging of media from one or more channels.\n\nEveryone on the bridge receives the same audio.",
        "properties": {
          "bridge_class": {
            "description": "Bridging class",
            "type": "string"
          },
          "bridge_type": {
            "description": "Type of bridge technology",
            "enum": [
              "mixing",
              "holding"
            ],
            "type": "string"
          },
          "bridgevars": {
            "additionalProperties": true,
            "description": "Bridge variables",
            "type": "object"
          },
          "channels": {
            "description": "Ids of channels participating in this bridge",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "creationtime": {
            "description": "Timestamp when bridge was created",
            "format": "date-time",
            "type": "string"
          },
          "creator": {
            "description": "Entity that created the bridge",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for this bridge",
            "type": "string"
          },
          "name": {
            "description": "Name the creator gave the bridge",
            "type": "string"
          },
          "technology": {
            "description": "Name of the current bridging technology",
            "type": "string"
          },
          "video_mode": {
            "description": "The video mode the bridge is using. One of 'none', 'talker', 'sfu', or 'single'.",
            "type": "string"
          },
          "video_source_id": {
            "description": "The ID of the channel that is the source of video in this bridge, if one exists.",
            "type": "string"
          }
        },
        "required": [
          "bridge_class",
          "bridge_type",
          "channels",
          "creationtime",
          "creator",
          "id",
          "name",
          "technology"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
