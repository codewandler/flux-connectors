          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "The format name capability list to use if originator is not specified. Ex. \"ulaw,slin16\".  Format names can be found with \"core show codecs\".",
          "name": "formats",
          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "variables",
          "position": "body",
          "required": false,
