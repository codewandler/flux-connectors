{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Front API token sent as a bearer",
      "env": [
        "FRONT_API_TOKEN"
      ],
      "name": "front.api_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.frontapp.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.front.api_token",
      "docs_url": "https://dev.frontapp.com/docs/authentication",
      "format": "token",
      "help": "In Front, open Settings → API & Integrations → API, and create a new token. A token is scoped to the teammate who creates it and to the scopes granted when it is created — replying and tagging require write scopes, not just read ones",
      "label": "API token",
      "level": "connection",
      "name": "api_token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "front",
  "default_auth": [
    [
      "front.api_token"
    ]
  ],
  "description": "Front shared inbox: read and reply to conversations, and tag them",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "front.api_token"
        ]
      ],
      "description": "List one conversation, confirming the token resolves and carries at least read access. Takes no parameters other than the page bound",
      "direction": "read",
      "expose": true,
      "id": "front-verify",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Records to fetch; one is enough to prove the credential works",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "default": 1,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/_error/status",
          "message_pointer": "/_error/message"
        }
      },
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          }
        ],
        "url": "{base}/conversations"
      },
      "response_schema": {
        "properties": {
          "_results": {
            "description": "Up to `limit` conversations. Empty is still a successful credential check — a company can genuinely have none yet",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "front.api_token"
        ]
      ],
      "description": "List the company's conversations in reverse chronological order (most recently updated first), first page only — this connector cannot follow Front's next-page link (see providers/front.toml's header comment). Front's structured search filter (`q`) is not accepted here: it is a bracket-notation object this pipeline cannot encode as a query string",
      "direction": "read",
      "expose": true,
      "id": "front-conversation-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Max conversations to return in this one page, up to Front's own cap of 100. Does not change how many pages exist, only how large this one is",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/_error/status",
          "message_pointer": "/_error/message"
        }
      },
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          }
        ],
        "url": "{base}/conversations"
      },
      "response_schema": {
        "properties": {
          "_pagination": {
            "description": "Carries `next`, a full absolute URL to the following page when more conversations exist. This connector cannot follow it — Front's cursor is an opaque, server-issued token unconstructable by a caller, and unencodable here regardless (C-30) — so a non-null `next` means more conversations exist beyond this first page only",
            "properties": {
              "next": {
                "description": "Unusable here; see this field's own description",
                "type": "string"
              }
            },
            "type": "object"
          },
          "_results": {
            "description": "This page's conversations, each `{id, subject, status, assignee, recipient, tags, created_at, ...}`",
            "items": {
              "properties": {
                "created_at": {
                  "description": "Unix timestamp, seconds",
                  "type": "number"
                },
                "id": {
                  "description": "The conversation's id, prefixed `cnv_`",
                  "pattern": "^cnv_[0-9a-z]+$",
                  "type": "string"
                },
                "is_private": {
                  "type": "boolean"
                },
                "status": {
                  "description": "Front's own conversation status, e.g. `assigned`, `unassigned`, `archived` or `deleted`",
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "front.api_token"
