          "statusDateTime": {
            "format": "date-time",
            "type": "string"
          },
          "uri": {
            "description": "This envelope's own resource path",
            "type": "string"
          }
        },
        "required": [
          "envelopeId",
          "status"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "docusign.access_token"
        ]
      ],
      "description": "Void an envelope: cancel it permanently. Every recipient who has not yet finished signing is immediately locked out, and no further signing action is possible on this envelope id. Irreversible",
      "direction": "write",
      "endpoint": {
        "account_host": [
          "host"
        ],
        "account_id": [
          "path"
        ]
      },
      "expose": true,
      "id": "docusign-envelope-void",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The envelope's DocuSign id (a GUID) to void",
          "name": "envelope_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Why this envelope is being voided. DocuSign shows this to any recipient who already opened the envelope, so avoid putting anything sensitive in it",
          "name": "voidedReason",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errorCode",
          "message_pointer": "/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "status": "voided",
            "voidedReason": {
              "$param": "voidedReason"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PUT",
        "url": "{base}/envelopes/{envelope_id}"
      },
      "response_schema": {
        "properties": {
          "envelopeId": {
            "type": "string"
          },
          "status": {
            "description": "voided on success",
            "type": "string"
          }
        },
        "required": [
          "envelopeId",
          "status"
        ],
        "type": "object"
      },
      "risk": "destructive",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "v2.1",
      "base_url": "https://{account_host}/restapi/v2.1/accounts/{account_id}",
      "gid": "com.docusign.api:v2.1",
      "name": "default",
      "tags": [
        "e-signature"
      ]
    }
  ],
  "vendor": "DocuSign",
  "verify": "docusign-verify"
