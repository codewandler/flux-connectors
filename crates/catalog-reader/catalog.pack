{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "OpenRouter API key, sent as a bearer token",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "name": "openrouter.api_key",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "ai.openrouter.api",
  "connector": "openrouter",
  "default_auth": [
    [
      "openrouter.api_key"
    ]
  ],
  "description": "OpenRouter model router: list models and their endpoints, create chat completions, and read credit balance",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "openrouter.api_key"
        ]
      ],
      "description": "List every model OpenRouter routes to, with its context length, modalities and per-token pricing",
      "direction": "read",
      "expose": true,
      "id": "openrouter-models-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/api/v1/models"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "One entry per model, each carrying at least `id` (`<author>/<slug>`), `name`, `created`, `description`, `context_length`, an `architecture` object and a `pricing` object whose per-token prices are decimal strings, not numbers",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "openrouter.api_key"
        ]
      ],
      "description": "List the upstream provider endpoints serving one model, with each one's pricing, context length and quantization",
      "direction": "read",
      "expose": true,
      "id": "openrouter-model-endpoints-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The model's author or organization, the part of a model id before the `/` — e.g. `openai`, `anthropic`, `meta-llama`",
          "name": "author",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The model slug, the part of a model id after the `/` — e.g. `gpt-4`, `claude-3.5-sonnet`",
          "name": "slug",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/api/v1/models/{author}/{slug}/endpoints"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "The model, with an `endpoints` array nested inside it — one entry per upstream provider serving it, each carrying its own `name`/`provider_name`, `context_length`, `pricing`, `quantization` and `supported_parameters`. This is a single object, not an array",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "openrouter.api_key"
        ]
      ],
      "description": "Create a chat completion through OpenRouter, routed to the named model. Billed per input and output token, so the caller must state a token budget via max_completion_tokens",
      "direction": "write",
      "expose": true,
      "id": "openrouter-chat-completion",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The model to route to, as `<author>/<slug>` — e.g. `openai/gpt-4o` or `anthropic/claude-3.5-sonnet`",
          "name": "model",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The conversation so far: a list of `{role, content}` objects, where role is one of system, developer, user, assistant or tool",
          "name": "messages",
          "position": "body",
          "required": true,
          "schema": {
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        {
          "description": "Upper bound on generated tokens, including reasoning tokens. Required by this connector so that every call states its cost bound",
          "name": "max_completion_tokens",
          "position": "body",
          "required": true,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "max_completion_tokens": {
              "$param": "max_completion_tokens"
            },
            "messages": {
              "$param": "messages"
            },
            "model": {
              "$param": "model"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/v1/chat/completions"
      },
      "response_schema": {
        "properties": {
          "choices": {
            "description": "One entry per completion; this connector never sets `n`, so there is exactly one",
            "items": {
              "properties": {
                "error": {
                  "description": "Present when the upstream provider failed *after* routing succeeded: `{code, message, metadata}`, delivered with HTTP 200 and no content. Check for it before reading `message`",
                  "type": "object"
                },
                "finish_reason": {
                  "description": "The normalized reason generation stopped — `stop`, `length`, `tool_calls`, `content_filter`. Branch on this one",
                  "type": "string"
                },
                "message": {
                  "description": "The assistant's turn: `role`, `content`, and `tool_calls` when the model called a tool",
                  "type": "object"
                },
                "native_finish_reason": {
                  "description": "The upstream provider's own unmapped reason, whose vocabulary varies by provider",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "created": {
            "description": "Unix seconds",
            "type": "integer"
          },
          "id": {
            "description": "The generation's id, which is also what `GET /api/v1/generation` would be queried by — an operation this connector cannot express (C-30)",
            "type": "string"
          },
          "model": {
            "description": "The model that actually served the request. It can differ from the one asked for when routing falls back",
            "type": "string"
          },
          "object": {
            "const": "chat.completion"
          },
          "provider": {
            "description": "The upstream provider that served it, e.g. `Anthropic` or `Together`. OpenRouter's own addition to the OpenAI shape and not part of the documented response schema, so it is recorded as optional",
            "type": "string"
          },
          "usage": {
            "description": "`prompt_tokens`, `completion_tokens`, `total_tokens`, and OpenRouter's own `cost` — what the call charged in credits, the same unit `openrouter-credits-get` reports",
            "type": "object"
          }
        },
        "required": [
          "id",
          "model",
          "choices"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "openrouter.api_key"
        ]
      ],
      "description": "Read the account's total purchased credits and total usage, in credit units",
      "direction": "read",
      "expose": true,
      "id": "openrouter-credits-get",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/api/v1/credits"
      },
      "response_schema": {
        "properties": {
          "data": {
            "properties": {
              "total_credits": {
                "description": "Credits ever purchased on this account — a cumulative total, not a remaining balance",
                "type": "number"
              },
              "total_usage": {
                "description": "Credits ever spent. The remaining balance is `total_credits - total_usage`",
                "type": "number"
              }
            },
            "required": [
              "total_credits",
              "total_usage"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "v1",
      "base_url": "https://openrouter.ai",
      "gid": "ai.openrouter.api:v1",
      "name": "default",
      "tags": [
        "ai"
      ]
    }
  ],
  "vendor": "OpenRouter"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "PagerDuty REST API access key, sent as the Authorization header after the literal `Token token=`. A read-only key satisfies the four read operations; the two incident writes need a full-access key",
      "env": [
        "PAGERDUTY_API_TOKEN"
      ],
      "name": "pagerduty.api_token",
      "scheme": {
        "kind": "header",
        "name": "Authorization",
        "prefix": "Token token="
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.pagerduty.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.pagerduty.api_token",
      "docs_url": "https://developer.pagerduty.com/docs/authentication",
      "format": "token",
      "help": "Create a REST API key in PagerDuty under Integrations, then API Access Keys. A read-only key is enough to list incidents, services and on-calls; acknowledging or resolving an incident needs a full-access key. PagerDuty shows the key once, when it is created",
      "label": "PagerDuty API access key",
      "level": "connection",
      "name": "api_token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "pagerduty",
  "default_auth": [
    [
      "pagerduty.api_token"
    ]
  ],
  "description": "PagerDuty incident response: read incidents, services and who is on call, and acknowledge or resolve an incident",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "pagerduty.api_token"
        ]
      ],
      "description": "List the incidents this key can see, across every service it has access to. Returns one page; read `more` to learn whether another page exists, and page by adding `limit` to `offset`. No status, service, team or time filter is offered by this connector — see pagerduty-incident-get to inspect one incident in full",
      "direction": "read",
      "expose": true,
      "id": "pagerduty-incident-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Maximum number of incidents to return in this page. PagerDuty caps this at 100",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Number of incidents to skip before this page begins. To read the next page, add the `limit` just used to the `offset` just used — this is not a page number",
          "name": "offset",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/vnd.pagerduty+json;version=2"
        },
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          },
          {
            "name": "offset",
            "value": {
              "$param": "offset"
            }
          }
        ],
        "url": "{base}/incidents"
      },
      "response_schema": {
        "properties": {
          "incidents": {
            "description": "This page's incidents",
            "items": {
              "properties": {
                "acknowledgements": {
                  "description": "Who has acknowledged the incident and when, each `{at, acknowledger}`. Empty unless status is acknowledged",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "alert_counts": {
                  "description": "How many alerts rolled up into this incident, `{all, triggered, resolved}`",
                  "type": "object"
                },
                "assignments": {
                  "description": "Who the incident is currently assigned to, each `{at, assignee}` where `assignee` is a user reference",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "escalation_policy": {
                  "description": "A reference to the escalation policy governing this incident",
                  "type": "object"
                },
                "html_url": {
                  "description": "The PagerDuty web UI URL a human would open",
                  "type": "string"
                },
                "id": {
                  "description": "The incident's own id — pass this as `id` to pagerduty-incident-get, -acknowledge or -resolve",
                  "type": "string"
                },
                "incident_key": {
                  "description": "The deduplication key the triggering integration supplied, when it supplied one",
                  "type": "string"
                },
                "incident_number": {
                  "description": "The account-scoped sequence number PagerDuty displays, distinct from `id`",
                  "type": "integer"
                },
                "last_status_change_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "priority": {
                  "description": "A reference to the account's configured priority level, when the account uses priorities; null otherwise",
                  "type": "object"
                },
                "resolved_at": {
                  "description": "Null until the incident is resolved",
                  "format": "date-time",
                  "type": "string"
                },
                "self": {
                  "description": "The API URL of this incident",
                  "type": "string"
                },
                "service": {
                  "description": "A reference to the service this incident is on: `{id, type, summary, self, html_url}`. Pass its `id` to nothing here — pagerduty-service-list returns the full representation",
                  "type": "object"
                },
                "status": {
                  "description": "triggered means nobody has taken it; acknowledged means somebody is working it and escalation has paused; resolved is terminal",
                  "enum": [
                    "triggered",
                    "acknowledged",
                    "resolved"
                  ],
                  "type": "string"
                },
                "summary": {
                  "description": "A short human-readable label for the incident, usually its title",
                  "type": "string"
                },
                "teams": {
                  "description": "References to the teams the incident is visible to",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "const": "incident"
                },
                "updated_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "urgency": {
                  "description": "Whether the service's escalation policy pages immediately (high) or notifies without paging (low)",
                  "enum": [
                    "high",
                    "low"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "limit": {
            "description": "The limit this page was read with",
            "type": "integer"
          },
          "more": {
            "description": "True when another page exists past this one. This is the only continuation signal PagerDuty sends — there is no cursor",
            "type": "boolean"
          },
          "offset": {
            "description": "The offset this page was read from",
            "type": "integer"
          },
          "total": {
            "description": "The total matching incidents. Null unless the request asked for it, which this connector does not",
            "type": "integer"
          }
        },
        "required": [
          "incidents"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "pagerduty.api_token"
        ]
      ],
      "description": "Fetch one incident in full, including its current status, urgency, service, assignments and acknowledgements. Read this before acknowledging or resolving, because PagerDuty refuses a status change that does not follow from the incident's current status",
      "direction": "read",
      "expose": true,
      "id": "pagerduty-incident-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The incident's own id, from pagerduty-incident-list's `id` field. Not the `incident_number` PagerDuty's web UI displays",
          "name": "id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/vnd.pagerduty+json;version=2"
        },
        "method": "GET",
        "url": "{base}/incidents/{id}"
      },
      "response_schema": {
        "properties": {
          "incident": {
            "description": "The incident, in the same shape pagerduty-incident-list's array carries",
            "properties": {
              "acknowledgements": {
                "description": "Each `{at, acknowledger}`. Empty unless status is acknowledged",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "alert_counts": {
                "description": "`{all, triggered, resolved}`",
                "type": "object"
              },
              "assignments": {
                "description": "Each `{at, assignee}`, where `assignee` is a user reference",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "created_at": {
                "format": "date-time",
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "escalation_policy": {
                "type": "object"
              },
              "first_trigger_log_entry": {
                "description": "A reference to the log entry that opened the incident",
                "type": "object"
              },
              "html_url": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "incident_key": {
                "type": "string"
              },
              "incident_number": {
                "type": "integer"
              },
              "last_status_change_at": {
                "format": "date-time",
                "type": "string"
              },
              "priority": {
                "description": "Null unless the account uses priorities",
                "type": "object"
              },
              "resolve_reason": {
                "description": "Why the incident was resolved, when it was resolved by being merged into another; null otherwise",
                "type": "object"
              },
              "resolved_at": {
                "description": "Null until the incident is resolved",
                "format": "date-time",
                "type": "string"
              },
              "self": {
                "type": "string"
              },
              "service": {
                "description": "A reference to the service this incident is on",
                "type": "object"
              },
              "status": {
                "enum": [
                  "triggered",
                  "acknowledged",
                  "resolved"
                ],
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "teams": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "const": "incident"
              },
              "updated_at": {
                "format": "date-time",
                "type": "string"
              },
              "urgency": {
                "enum": [
                  "high",
                  "low"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "status"
            ],
            "type": "object"
          }
        },
        "required": [
          "incident"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "pagerduty.api_token"
        ]
      ],
      "description": "List the services this key can see. A service is what incidents are opened against and what an escalation policy is attached to, so this is how to discover the ids and names behind an incident's `service` reference. Also this connector's connection test",
      "direction": "read",
      "expose": true,
      "id": "pagerduty-service-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Maximum number of services to return in this page. PagerDuty caps this at 100",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Number of services to skip before this page begins. To read the next page, add the `limit` just used to the `offset` just used",
          "name": "offset",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/vnd.pagerduty+json;version=2"
        },
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          },
          {
            "name": "offset",
            "value": {
              "$param": "offset"
            }
          }
        ],
        "url": "{base}/services"
      },
      "response_schema": {
        "properties": {
          "limit": {
            "type": "integer"
          },
          "more": {
            "description": "True when another page exists past this one",
            "type": "boolean"
          },
          "offset": {
            "type": "integer"
          },
          "services": {
            "description": "This page's services",
            "items": {
              "properties": {
                "acknowledgement_timeout": {
                  "description": "Seconds after which an acknowledged incident re-triggers. Null when an acknowledgement never expires",
                  "type": "integer"
                },
                "auto_resolve_timeout": {
                  "description": "Seconds after which an unacknowledged incident auto-resolves. Null when the service never auto-resolves",
                  "type": "integer"
                },
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "escalation_policy": {
                  "description": "A reference to the escalation policy this service pages through",
                  "type": "object"
                },
                "html_url": {
                  "type": "string"
                },
                "id": {
                  "description": "The service's own id",
                  "type": "string"
                },
                "integrations": {
                  "description": "References to the integrations that can open incidents on this service",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "last_incident_timestamp": {
                  "description": "When this service last opened an incident; null if it never has",
                  "format": "date-time",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "self": {
                  "type": "string"
                },
                "status": {
                  "description": "The service's current health as PagerDuty sees it: active means no open incidents, warning and critical mean open incidents of increasing urgency, maintenance means a maintenance window is in effect, disabled means the service accepts no new incidents",
                  "enum": [
                    "active",
                    "warning",
                    "critical",
                    "maintenance",
                    "disabled"
                  ],
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "teams": {
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "type": {
                  "const": "service"
                }
              },
              "required": [
                "id",
                "type",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "Null unless the request asked for it, which this connector does not",
            "type": "integer"
          }
        },
        "required": [
          "services"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "pagerduty.api_token"
        ]
      ],
      "description": "List who is currently on call, as one entry per escalation policy, escalation level and user. An entry with no `schedule` is a user attached directly to an escalation level rather than through a rotation. Time filtering is not offered by this connector, so this answers `who is on call now`",
      "direction": "read",
      "expose": true,
      "id": "pagerduty-oncall-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Maximum number of on-call entries to return in this page. PagerDuty caps this at 100",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Number of on-call entries to skip before this page begins. To read the next page, add the `limit` just used to the `offset` just used",
          "name": "offset",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/vnd.pagerduty+json;version=2"
        },
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          },
          {
            "name": "offset",
            "value": {
              "$param": "offset"
            }
          }
        ],
        "url": "{base}/oncalls"
      },
      "response_schema": {
        "properties": {
          "limit": {
            "type": "integer"
          },
          "more": {
            "description": "True when another page exists past this one",
            "type": "boolean"
          },
          "offset": {
            "type": "integer"
          },
          "oncalls": {
            "description": "This page's on-call entries. One user can appear more than once — once per escalation policy and level they cover",
            "items": {
              "properties": {
                "end": {
                  "description": "When this on-call period ends. Null for a permanent, non-rotating assignment",
                  "format": "date-time",
                  "type": "string"
                },
                "escalation_level": {
                  "description": "Which level of that policy this entry sits at. Level 1 is paged first",
                  "type": "integer"
                },
                "escalation_policy": {
                  "description": "A reference to the escalation policy this entry covers: `{id, type, summary, self, html_url}`",
                  "type": "object"
                },
                "schedule": {
                  "description": "A reference to the on-call schedule that placed this user here. Null when the user is attached to the escalation level directly rather than through a rotation",
                  "type": "object"
                },
                "start": {
                  "description": "When this on-call period began. Null for a permanent, non-rotating assignment",
                  "format": "date-time",
                  "type": "string"
                },
                "user": {
                  "description": "A reference to the person on call: `{id, type, summary, self, html_url}`, where `summary` is their display name",
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "Null unless the request asked for it, which this connector does not",
            "type": "integer"
          }
        },
        "required": [
          "oncalls"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "pagerduty.api_token"
        ]
      ],
      "description": "Acknowledge one incident, on behalf of a named PagerDuty user. This stops the escalation clock and tells the rotation that somebody is working the incident; it does not close it. PagerDuty refuses the change if the incident is already resolved, and answers that as data rather than as a failure",
      "direction": "write",
      "expose": true,
      "id": "pagerduty-incident-acknowledge",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The incident's own id, from pagerduty-incident-list's `id` field",
          "name": "id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The login address of the PagerDuty user this acknowledgement is recorded against. It must belong to a user in this PagerDuty account; PagerDuty answers 400 otherwise. A REST API key carries no user identity of its own, which is why this cannot be inferred",
          "name": "from_email",
          "position": "header",
          "required": true,
          "schema": {
            "format": "email",
            "minLength": 3,
            "type": "string"
          },
          "wire": "From"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "incident": {
              "status": "acknowledged",
              "type": "incident_reference"
            }
          }
        },
        "headers": {
          "Accept": "application/vnd.pagerduty+json;version=2",
          "From": {
            "$param": "from_email"
          },
          "content-type": "application/json"
        },
        "method": "PUT",
        "url": "{base}/incidents/{id}"
      },
      "response_schema": {
        "properties": {
          "incident": {
            "description": "The incident after the update, in the shape pagerduty-incident-get returns. Read `status` back to confirm the acknowledgement took effect",
            "properties": {
              "acknowledgements": {
                "description": "Each `{at, acknowledger}`; the acknowledger is the user named by the From header",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "html_url": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "incident_number": {
                "type": "integer"
              },
              "last_status_change_at": {
                "format": "date-time",
                "type": "string"
              },
              "service": {
                "type": "object"
              },
              "status": {
                "description": "`acknowledged` after a successful call",
                "enum": [
                  "triggered",
                  "acknowledged",
                  "resolved"
                ],
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "const": "incident"
              },
              "updated_at": {
                "format": "date-time",
                "type": "string"
              },
              "urgency": {
                "enum": [
                  "high",
                  "low"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "status"
            ],
            "type": "object"
          }
        },
        "required": [
          "incident"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "pagerduty.api_token"
        ]
      ],
      "description": "Resolve one incident, on behalf of a named PagerDuty user. This closes it: it leaves the open-incident view and notifications stop. If the underlying condition is still live, the next alert opens a brand-new incident rather than reopening this one, so resolve only what is actually fixed",
      "direction": "write",
      "expose": true,
      "id": "pagerduty-incident-resolve",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The incident's own id, from pagerduty-incident-list's `id` field",
          "name": "id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The login address of the PagerDuty user this resolution is recorded against. It must belong to a user in this PagerDuty account; PagerDuty answers 400 otherwise. A REST API key carries no user identity of its own, which is why this cannot be inferred",
          "name": "from_email",
          "position": "header",
          "required": true,
          "schema": {
            "format": "email",
            "minLength": 3,
            "type": "string"
          },
          "wire": "From"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "incident": {
              "status": "resolved",
              "type": "incident_reference"
            }
          }
        },
        "headers": {
          "Accept": "application/vnd.pagerduty+json;version=2",
          "From": {
            "$param": "from_email"
          },
          "content-type": "application/json"
        },
        "method": "PUT",
        "url": "{base}/incidents/{id}"
      },
      "response_schema": {
        "properties": {
          "incident": {
            "description": "The incident after the update. Read `status` back to confirm the resolution took effect",
            "properties": {
              "html_url": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "incident_number": {
                "type": "integer"
              },
              "last_status_change_at": {
                "format": "date-time",
                "type": "string"
              },
              "resolved_at": {
                "format": "date-time",
                "type": "string"
              },
              "service": {
                "type": "object"
              },
              "status": {
                "description": "`resolved` after a successful call",
                "enum": [
                  "triggered",
                  "acknowledged",
                  "resolved"
                ],
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "const": "incident"
              },
              "updated_at": {
                "format": "date-time",
                "type": "string"
              },
              "urgency": {
                "enum": [
                  "high",
                  "low"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "status"
            ],
            "type": "object"
          }
        },
        "required": [
          "incident"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "base_url": "https://api.pagerduty.com",
      "name": "default",
      "tags": [
        "incident-response"
      ]
    }
  ],
  "vendor": "PagerDuty",
  "verify": "pagerduty-service-list"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Postmark Server API token, scoped to one server. Authenticates sending and that server's own message history; cannot list or manage servers",
      "env": [
        "POSTMARK_SERVER_TOKEN"
      ],
      "name": "postmark.server_token",
      "scheme": {
        "kind": "header",
        "name": "X-Postmark-Server-Token"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.postmarkapp.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.postmark.server_token",
      "docs_url": "https://postmarkapp.com/support/article/1008-what-are-the-account-server-api-tokens",
      "format": "token",
      "help": "Find it on the server's API Tokens tab in the Postmark dashboard. Grants sending and that server's own message history only — it cannot list or manage servers",
      "label": "Postmark Server Token",
      "level": "connection",
      "name": "server_token",
      "required": true,
      "secret": true,
      "service": "server"
    }
  ],
  "connector": "postmark",
  "default_auth": [
    [
      "postmark.server_token"
    ]
  ],
  "description": "Postmark transactional email: send a message, read delivery stats and bounces. Listing and inspecting servers is withheld — the Account API returns live Server Tokens in plaintext (C-430)",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "postmark.server_token"
        ]
      ],
      "description": "Send a single email immediately from the token's server. Delivered within seconds and cannot be recalled",
      "direction": "write",
      "expose": true,
      "id": "postmark-email-send",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The sending address. Must be a Sender Signature or verified domain address on this server — the caller's own input, never an example value here",
          "name": "from",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "From"
        },
        {
          "description": "Recipient address(es), comma-separated, up to 50. The caller's own input, never an example value here",
          "name": "to",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "To"
        },
        {
          "description": "Additional recipients, comma-separated. The caller's own input, never an example value here",
          "name": "cc",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "Cc"
        },
        {
          "description": "Blind-copied recipients, comma-separated. The caller's own input, never an example value here",
          "name": "bcc",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "Bcc"
        },
        {
          "description": "The email's subject line",
          "name": "subject",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "Subject"
        },
        {
          "description": "The plain-text body. Postmark requires at least one of `text_body` or `html_body`; this schema cannot express that cross-field rule and does not enforce it",
          "name": "text_body",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "TextBody"
        },
        {
          "description": "The HTML body. Postmark requires at least one of `text_body` or `html_body`; this schema cannot express that cross-field rule and does not enforce it",
          "name": "html_body",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "HtmlBody"
        },
        {
          "description": "Reply-To address, when replies should not go to `from`. The caller's own input, never an example value here",
          "name": "reply_to",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "ReplyTo"
        },
        {
          "description": "A short label for categorizing this message in Postmark's activity view and statistics",
          "name": "tag",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "Tag"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/ErrorCode",
          "message_pointer": "/Message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "Bcc": {
              "$param": "bcc"
            },
            "Cc": {
              "$param": "cc"
            },
            "From": {
              "$param": "from"
            },
            "HtmlBody": {
              "$param": "html_body"
            },
            "ReplyTo": {
              "$param": "reply_to"
            },
            "Subject": {
              "$param": "subject"
            },
            "Tag": {
              "$param": "tag"
            },
            "TextBody": {
              "$param": "text_body"
            },
            "To": {
              "$param": "to"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/email"
      },
      "response_schema": {
        "properties": {
          "ErrorCode": {
            "description": "0 on success",
            "type": "integer"
          },
          "Message": {
