      "request": {
        "method": "GET",
        "url": "{base}/lists/{list_id}/members/{subscriber_hash}"
      },
      "response_schema": {
        "properties": {
          "contact_id": {
            "description": "Mailchimp's newer per-contact identifier",
            "type": "string"
          },
          "email_address": {
            "description": "The contact's address. Personal data",
            "type": "string"
          },
          "email_type": {
            "description": "`html` or `text`",
            "type": "string"
          },
          "full_name": {
            "description": "The contact's name, if the account collects one. Personal data",
            "type": "string"
          },
          "id": {
            "description": "The MD5 hash of the lowercase email address — the `subscriber_hash` this operation and the upsert take",
            "type": "string"
          },
          "interests": {
            "description": "Interest-group membership, keyed by group id. Left untyped rather than enumerated",
            "type": "object"
          },
