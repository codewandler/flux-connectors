            "type": "integer"
          },
          "spaceId": {
            "description": "The space the page belongs to — pass it to `confluence-space-get` for the space's name and key",
            "type": "string"
          },
          "status": {
            "description": "`current` for a live page, or `archived`/`draft`/`trashed`. A trashed page still reads here",
            "type": "string"
          },
          "title": {
            "description": "The page's title — the only content-bearing field this operation returns",
            "type": "string"
          },
          "version": {
            "description": "The page's current version — returned without asking, because the vendor's `include-version` defaults to true. `number` is what an update would have to increment; this connector declares no update, and its notes say why",
