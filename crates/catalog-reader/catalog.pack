                              "description": "When set to true, the chat input will be disabled on supported client implementations when the message is the most recent one in the history. Can be used for guided flows or to temporarily disable the user's ability to send messages in the conversation.",
                              "type": "boolean"
                            },
                            "htmlText": {
                              "description": "HTML text content of the message. Can be provided in place of `text`. Cannot be used with `markdownText`.\nIf no `text` is provided, will be converted to `text` upon reception to be displayed on channels that do not support rich text.\nSee [rich text](https://developer.zendesk.com/documentation/conversations/messaging-platform/programmable-conversations/structured-messages/#rich-text) documentation for more information.",
                              "example": "<h1>Hello!</h1>",
                              "maxLength": 4096,
                              "type": "string"
                            },
                            "markdownText": {
                              "description": "Markdown text content of the message. Can be provided in place of `text`. Cannot be used with `htmlText`.\nWill be converted to `htmlText` upon reception. If converted `htmlText` exceeds 4096 characters, the message will be rejected.\nIf no `text` is provided, will be converted to `text` upon reception to be displayed on channels that do not support rich text.\nSee [rich text](https://developer.zendesk.com/documentation/conversations/messaging-platform/programmable-conversations/structured-messages/#rich-text) documentation for more information.",
                              "example": "# Hello!",
                              "maxLength": 4096,
                              "type": "string",
                              "writeOnly": true
                            },
                            "mediaSize": {
                              "description": "The size of the media in bytes.",
                              "readOnly": true,
                              "type": "number"
                            },
                            "mediaType": {
                              "description": "The type of media.",
                              "maxLength": 128,
                              "readOnly": true,
                              "type": "string"
                            },
                            "mediaUrl": {
                              "description": "The URL for media, such as an image, attached to the message.\n<aside class=\"notice\"><strong>Note:</strong> An authorization header is required to access the mediaUrl when private attachments are enabled. See [configuring private attachments for messaging](https://developer.zendesk.com/documentation/zendesk-web-widget-sdks/messaging_private_attachments/) guide for more details.</aside>\n",
                              "format": "uri",
                              "type": "string"
                            },
                            "text": {
                              "description": "The text content of the message.",
                              "type": "string"
                            },
                            "type": {
                              "default": "image",
                              "description": "The type of message.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "type",
                            "mediaUrl"
                          ],
                          "type": "object"
                        },
                        {
                          "description": "List messages are a vertically scrollable set of items that may each contain text, an image, and message actions. Not all messaging channels fully support list messages.\n* Facebook Messenger and WeChat have native support.\n* For LINE and our Android, iOS and Web SDK, Sunshine Conversations converts list messages to carousel.\n* On WhatsApp, Telegram and Twitter, Sunshine Conversations converts list messages to multiple rich messages.\n* On all other platforms, Sunshine Conversations converts list messages to raw text.\n",
                          "properties": {
                            "actions": {
                              "description": "An array of objects representing the actions associated with the message. The array length is limited by the third party channel.",
                              "items": {
                                "discriminator": {
                                  "propertyName": "type"
                                },
                                "oneOf": [
                                  {
                                    "properties": {
                                      "amount": {
                                        "description": "The amount being charged. It needs to be specified in cents and is an integer (9.99$ -> 999).",
                                        "example": 8000,
                                        "type": "integer"
                                      },
                                      "currency": {
                                        "description": "An ISO 4217 standard currency code in lowercase. Used for actions of type buy.",
                                        "example": "CAD",
                                        "type": "string"
                                      },
                                      "metadata": {
                                        "additionalProperties": true,
