{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Statuspage API key, sent as the Authorization header after the literal scheme word `OAuth ` — a static key from the account's own API settings, not an OAuth2 access token",
      "env": [
        "STATUSPAGE_API_KEY"
      ],
      "name": "statuspage.api_key",
      "scheme": {
        "kind": "header",
        "name": "Authorization",
        "prefix": "OAuth "
      },
      "subject": "unstated"
    }
  ],
  "authority": "io.statuspage.api",
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.page_id",
      "format": "text",
      "help": "The id of the status page this connection administers. Statuspage shows it in the address bar of the page's own management screen (manage.statuspage.io/pages/<page id>) and on the API keys screen. One connection administers one page: an account with several status pages needs one installation per page",
      "label": "Status page id",
      "level": "connection",
      "name": "page_id",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.statuspage.api_key",
      "docs_url": "https://developer.statuspage.io/",
      "format": "token",
      "help": "Create one under your Statuspage user account's API keys screen. The key carries the permissions of the account that created it, so an account that should only read incidents must not be the one that mints this key. Statuspage shows the key once",
      "label": "Statuspage API key",
      "level": "connection",
      "name": "api_key",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "statuspage",
  "default_auth": [
    [
      "statuspage.api_key"
    ]
  ],
  "description": "Atlassian Statuspage: read a status page's components and incidents, and open or update a publicly visible incident on it",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "statuspage.api_key"
        ]
      ],
      "description": "List this status page's incidents, most recent first — both unresolved and already-resolved ones. Returns Statuspage's own first page of results; this connector declares no paging parameters, so a page with a long incident history is not enumerated exhaustively here",
      "direction": "read",
      "endpoint": {
        "page_id": [
          "path"
        ]
      },
      "expose": true,
      "id": "statuspage-incident-list",
      "idempotency": "idempotent",
      "quirks": {
        "error_envelope": {
          "message_pointer": "/error"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/incidents"
      },
      "response_schema": {
        "description": "The page's incidents, most recent first. Statuspage returns a bare JSON array here, not an object wrapping one",
        "items": {
          "properties": {
            "components": {
              "description": "The components this incident affects, in the shape statuspage-component-list returns",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "created_at": {
              "format": "date-time",
              "type": "string"
            },
            "id": {
              "description": "The incident's own id — what statuspage-incident-get and statuspage-incident-update address it by",
              "type": "string"
            },
            "impact": {
              "description": "none, maintenance, minor, major or critical — Statuspage's own calculation from the affected components unless an override was set",
              "type": "string"
            },
            "incident_updates": {
              "description": "Every update posted to this incident, most recent first. Each update's body is what subscribers received",
              "items": {
                "properties": {
                  "body": {
                    "description": "The publicly visible message this update posted",
                    "type": "string"
                  },
                  "created_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "display_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "monitoring_at": {
              "description": "When the incident moved to monitoring; null until it does",
              "format": "date-time",
              "type": "string"
            },
            "name": {
              "description": "The incident's title, as shown on the public page",
              "type": "string"
            },
            "page_id": {
              "description": "The page this incident belongs to — the same id this connection is configured with",
              "type": "string"
            },
            "resolved_at": {
              "description": "When the incident was resolved; null until it is",
              "format": "date-time",
              "type": "string"
            },
            "shortlink": {
              "description": "The public short URL for this incident",
              "type": "string"
            },
            "status": {
              "description": "investigating, identified, monitoring or resolved for a realtime incident; scheduled, in_progress, verifying or completed for a scheduled maintenance, which this connector does not create or update",
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "status"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
