                  },
                  "call_started_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "call_type": {
                    "nullable": true,
                    "type": "string"
                  },
                  "callback_number": {
                    "nullable": true,
                    "type": "string"
                  },
                  "callback_requested_at": {
                    "format": "date-time",
                    "nullable": true,
                    "type": "string"
                  },
                  "completion_status": {
                    "nullable": true,
                    "type": "string"
                  },
                  "connection_attempts": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "consultation_time": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "direction": {
                    "type": "string"
                  },
                  "disconnection_reason": {
                    "nullable": true,
                    "type": "string"
                  },
                  "dnis": {
                    "nullable": true,
                    "type": "string"
                  },
                  "duration": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "end_user_id": {
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "end_user_location": {
                    "nullable": true,
                    "type": "string"
                  },
                  "exceeded_queue_time": {
                    "nullable": true,
                    "type": "boolean"
                  },
                  "extension": {
                    "nullable": true,
                    "type": "string"
                  },
                  "external_id": {
                    "type": "string"
                  },
                  "from_line": {
                    "type": "string"
                  },
                  "from_line_nickname": {
                    "nullable": true,
                    "type": "string"
                  },
                  "hold_time": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "intent": {
                    "nullable": true,
                    "type": "string"
                  },
                  "ivr_destination_group_name": {
                    "nullable": true,
                    "type": "string"
                  },
                  "ivr_time_spent": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "language": {
                    "nullable": true,
                    "type": "string"
                  },
                  "line_type": {
                    "type": "string"
                  },
                  "longest_hold_time": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "number_of_holds": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "outside_business_hours": {
                    "nullable": true,
                    "type": "boolean"
                  },
                  "overflowed_to": {
                    "nullable": true,
                    "type": "string"
                  },
                  "phone_name": {
                    "nullable": true,
                    "type": "string"
                  },
                  "public": {
                    "type": "boolean"
                  },
                  "quality_score": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "queue_name": {
                    "nullable": true,
                    "type": "string"
                  },
                  "queue_time": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "recorded": {
                    "type": "boolean"
                  },
                  "recording_time": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "recording_type": {
                    "type": "string"
                  },
                  "recording_url": {
                    "nullable": true,
                    "type": "string"
                  },
                  "sentiment_agent": {
                    "nullable": true,
                    "type": "string"
                  },
                  "sentiment_call": {
                    "nullable": true,
                    "type": "string"
                  },
                  "sentiment_customer": {
                    "nullable": true,
                    "type": "string"
                  },
                  "sentiment_trend": {
                    "nullable": true,
                    "type": "string"
                  },
                  "short_summary": {
                    "nullable": true,
                    "type": "string"
                  },
                  "summary": {
                    "nullable": true,
                    "type": "string"
                  },
                  "talk_time": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "time_to_answer": {
                    "nullable": true,
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "to_line": {
                    "type": "string"
                  },
                  "to_line_nickname": {
                    "nullable": true,
                    "type": "string"
                  },
                  "transcript": {
                    "nullable": true,
                    "type": "string"
                  },
                  "via_id": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "video_recording_url": {
                    "nullable": true,
                    "type": "string"
                  },
                  "voicemail": {
                    "nullable": true,
                    "type": "boolean"
                  },
                  "voicemail_requested_at": {
                    "format": "date-time",
                    "nullable": true,
                    "type": "string"
                  },
                  "wait_time": {
                    "nullable": true,
                    "type": "integer"
                  }
                },
                "type": "object",
                "writeOnly": true
              },
              "type": {
                "description": "The type of this ticket",
                "enum": [
                  "problem",
                  "incident",
                  "question",
                  "task"
                ],
                "nullable": true,
                "type": "string"
              },
              "updated_at": {
                "description": "When this record last got updated. It is updated only if the update generates a [ticket event](#incremental-ticket-event-export)",
                "format": "date-time",
                "readOnly": true,
                "type": "string"
              },
              "updated_stamp": {
                "description": "Write only. Datetime of last update received from API. See the `safe_update` property",
                "format": "date-time",
                "type": "string",
                "writeOnly": true
              },
              "url": {
                "description": "The API url of this ticket",
                "readOnly": true,
                "type": "string"
              },
              "via": {
                "description": "An object explaining how the ticket was created. See the [Via object reference](/documentation/ticketing/reference-guides/via-object-reference)\n",
                "example": {
                  "channel": "rule",
                  "source": {
                    "from": {
                      "id": 22472716,
                      "title": "Assign to first responder"
                    },
                    "rel": "trigger",
                    "to": {}
                  }
                },
                "properties": {
                  "channel": {
                    "description": "This tells you how the ticket or event was created. Examples: \"web\", \"mobile\", \"rule\", \"system\".\nMay be a string name or an integer channel ID.\n",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "source": {
                    "additionalProperties": true,
                    "description": "For some channels a source object gives more information about how or why the ticket or event was created\n",
                    "properties": {
                      "from": {
                        "properties": {
                          "address": {
                            "nullable": true,
                            "type": "string"
                          },
                          "id": {
                            "format": "int64",
                            "nullable": true,
                            "type": "integer"
                          },
                          "name": {
                            "nullable": true,
                            "type": "string"
                          },
                          "title": {
                            "nullable": true,
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "rel": {
                        "nullable": true,
                        "type": "string"
                      },
                      "to": {
                        "properties": {
                          "address": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "readOnly": true,
                "type": "object"
              },
              "via_followup_source_id": {
                "description": "Write only. The id of a closed ticket when creating a follow-up ticket. See [Creating a follow-up ticket](/documentation/ticketing/managing-tickets/creating-and-updating-tickets#creating-a-follow-up-ticket)",
                "format": "int64",
                "type": "integer",
                "writeOnly": true
              },
              "via_id": {
                "description": "Write only. For more information, see the [Via object reference](/documentation/ticketing/reference-guides/via-object-reference/)",
                "format": "int64",
                "type": "integer",
                "writeOnly": true
              },
              "voice_comment": {
                "additionalProperties": true,
                "description": "Write only. A voice comment for Talk tickets. See [Adding voice comments to tickets](/documentation/ticketing/managing-tickets/adding-voice-comments-to-tickets/)",
                "properties": {
                  "answered_by_id": {
                    "description": "The agent who answered the call",
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "call_duration": {
                    "description": "Duration of the call in seconds",
                    "type": "integer"
                  },
                  "from": {
                    "description": "Incoming phone number",
                    "type": "string"
                  },
                  "location": {
                    "description": "Location of the caller",
                    "nullable": true,
                    "type": "string"
                  },
                  "recording_url": {
                    "description": "URL of the recording",
                    "nullable": true,
                    "type": "string"
                  },
                  "to": {
                    "description": "Dialed phone number",
                    "type": "string"
                  },
                  "transcription_text": {
                    "description": "Transcription of the call",
                    "nullable": true,
                    "type": "string"
                  }
                },
                "type": "object",
                "writeOnly": true
              }
            },
            "type": "object"
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "ticket": {
              "$param": "ticket"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PUT",
        "url": "{base}/api/v2/tickets/{ticket_id}"
      },
      "response_schema": {
        "properties": {
          "audit": {
            "properties": {
              "author_id": {
                "format": "int64",
                "readOnly": true,
                "type": "integer"
              },
              "created_at": {
                "format": "date-time",
                "readOnly": true,
                "type": "string"
              },
              "events": {
                "items": {
                  "properties": {
                    "body": {
                      "readOnly": true,
                      "type": "string"
                    },
                    "field_name": {
                      "readOnly": true,
                      "type": "string"
                    },
                    "id": {
                      "format": "int64",
                      "readOnly": true,
                      "type": "integer"
                    },
                    "type": {
                      "readOnly": true,
                      "type": "string"
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ]
                    }
                  },
                  "type": "object"
                },
                "readOnly": true,
                "type": "array"
              },
              "id": {
                "format": "int64",
                "readOnly": true,
                "type": "integer"
              },
              "metadata": {
                "readOnly": true,
                "type": "object"
              },
              "ticket_id": {
                "format": "int64",
                "readOnly": true,
                "type": "integer"
              },
              "via": {
                "description": "An object explaining how the ticket was created. See the [Via object reference](/documentation/ticketing/reference-guides/via-object-reference)\n",
                "example": {
                  "channel": "rule",
                  "source": {
                    "from": {
                      "id": 22472716,
                      "title": "Assign to first responder"
                    },
                    "rel": "trigger",
                    "to": {}
                  }
                },
                "properties": {
                  "channel": {
                    "description": "This tells you how the ticket or event was created. Examples: \"web\", \"mobile\", \"rule\", \"system\".\nMay be a string name or an integer channel ID.\n",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
