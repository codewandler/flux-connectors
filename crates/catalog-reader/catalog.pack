                  "description": "The ids of agents currently following the ticket. Ignored when [CCs and followers](https://support.zendesk.com/hc/en-us/articles/4408822451482) is not enabled",
                  "items": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "readOnly": true,
                  "type": "array"
                },
                "followers": {
                  "description": "Write only. An array of objects that represents agent followers to add or delete from the ticket. See [Setting followers](/documentation/ticketing/managing-tickets/creating-and-updating-tickets/#setting-followers). Ignored when [CCs and followers](https://support.zendesk.com/hc/en-us/articles/4408822451482) is not enabled",
                  "items": {
                    "properties": {
                      "action": {
                        "enum": [
                          "put",
                          "delete"
                        ],
                        "type": "string"
                      },
                      "user_email": {
                        "format": "email",
                        "type": "string"
                      },
                      "user_id": {
                        "format": "int64",
                        "type": "integer"
                      },
                      "user_name": {
                        "nullable": true,
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array",
                  "writeOnly": true
                },
                "followup_ids": {
                  "description": "The ids of the followups created from this ticket. Ids are only visible once the ticket is closed",
                  "items": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "readOnly": true,
                  "type": "array"
                },
                "forum_topic_id": {
                  "description": "The topic in the Zendesk Web portal this ticket originated from, if any. The Web portal is deprecated",
                  "format": "int64",
                  "type": "integer"
                },
                "from_messaging_channel": {
                  "description": "If true, the ticket's [via type](/documentation/ticketing/reference-guides/via-object-reference/) is a messaging channel.",
                  "readOnly": true,
                  "type": "boolean"
                },
                "generated_timestamp": {
                  "description": "A Unix timestamp that represents the most accurate reading of when this record was last updated. It is updated for all ticket updates, including system updates",
                  "readOnly": true,
                  "type": "integer"
                },
                "group_id": {
                  "description": "The group this ticket is assigned to",
                  "format": "int64",
                  "nullable": true,
                  "type": "integer"
                },
                "has_incidents": {
                  "description": "Is true if a ticket is a problem type and has one or more incidents linked to it. Otherwise, the value is false.",
                  "readOnly": true,
                  "type": "boolean"
                },
                "id": {
                  "description": "Automatically assigned when the ticket is created",
                  "format": "int64",
                  "readOnly": true,
                  "type": "integer"
                },
                "is_public": {
                  "description": "Is true if any comments are public, false otherwise",
                  "readOnly": true,
                  "type": "boolean"
                },
                "macro_id": {
                  "description": "Write only. A single macro ID to be recorded in the ticket audit",
                  "format": "int64",
                  "type": "integer",
                  "writeOnly": true
                },
                "macro_ids": {
                  "description": "Write only. List of macro IDs to be recorded in the ticket audit",
                  "items": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "type": "array",
                  "writeOnly": true
                },
                "metadata": {
                  "additionalProperties": true,
                  "description": "Write only. Metadata for the audit. In the `audit` object, the data is specified in the `custom` property of the `metadata` object. See [Setting Metadata](/documentation/ticketing/managing-tickets/creating-and-updating-tickets/#setting-metadata)",
                  "type": "object",
                  "writeOnly": true
                },
                "organization_id": {
                  "description": "The organization of the requester. You can only specify the ID of an organization associated with the requester. See [Organization Memberships](/api-reference/ticketing/organizations/organization_memberships/)",
                  "format": "int64",
                  "nullable": true,
                  "type": "integer"
                },
                "origin_zrn": {
                  "description": "Write only. The Zendesk Resource Name (ZRN) of the origin for this ticket",
                  "type": "string",
                  "writeOnly": true
                },
                "priority": {
                  "description": "The urgency with which the ticket should be addressed",
                  "enum": [
                    "urgent",
                    "high",
                    "normal",
                    "low"
                  ],
                  "nullable": true,
                  "type": "string"
                },
                "problem_id": {
                  "description": "For tickets of type \"incident\", the ID of the problem the incident is linked to",
                  "format": "int64",
                  "nullable": true,
                  "type": "integer"
                },
                "raw_subject": {
                  "description": "The dynamic content placeholder, if present, or the \"subject\" value, if not. See [Dynamic Content Items](/api-reference/ticketing/ticket-management/dynamic_content/).\nWhen set on create or update, overrides the `subject` field.\n",
                  "type": "string"
                },
                "recipient": {
                  "description": "The original recipient e-mail address of the ticket. Notification emails for the ticket are sent from this address",
                  "type": "string"
                },
                "requester": {
                  "description": "Write only. Alternative to requester_id for specifying the ticket requester.\n\nCan be provided as:\n- Email string: \"user@example.com\"\n- User ID integer: 12345\n- User object: {name: \"John Doe\", email: \"john@example.com\"}\n\nIf both requester and requester_id are provided, requester_id takes precedence.\n\nWhen creating a ticket, if the user doesn't exist, they may be created\nautomatically depending on account settings.\n",
                  "oneOf": [
                    {
                      "description": "Email address or username",
                      "type": "string"
                    },
                    {
                      "description": "User ID",
                      "type": "integer"
                    },
                    {
                      "description": "User creation attributes",
                      "properties": {
                        "email": {
                          "description": "The user's primary email address",
                          "format": "email",
                          "type": "string"
                        },
                        "locale": {
                          "description": "The user's locale (e.g., \"en-US\")",
                          "type": "string"
                        },
                        "locale_id": {
                          "description": "The user's locale ID",
                          "format": "int64",
                          "type": "integer"
                        },
                        "name": {
                          "description": "The user's name",
                          "type": "string"
                        },
                        "organization_id": {
                          "description": "The organization ID to associate with the user",
                          "format": "int64",
                          "type": "integer"
                        },
                        "role": {
                          "description": "The user's role (e.g., \"end-user\", \"agent\", \"admin\")",
                          "type": "string"
                        },
                        "verified": {
                          "description": "Whether the user's email is verified",
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    }
                  ],
                  "writeOnly": true
                },
                "requester_id": {
                  "description": "The user who requested this ticket",
                  "format": "int64",
                  "nullable": true,
                  "type": "integer"
                },
                "safe_update": {
                  "description": "Write only. Optional boolean. When true and an `updated_stamp` date is included, protects against ticket update collisions and returns a message to let you know if one occurs. See [Protecting against ticket update collisions](/documentation/ticketing/managing-tickets/creating-and-updating-tickets/#protecting-against-ticket-update-collisions). A value of false has the same effect as true. Omit the property to force the updates to not be safe",
                  "type": "boolean",
                  "writeOnly": true
                },
                "satisfaction_probability": {
                  "description": "The predicted satisfaction probability score",
                  "readOnly": true,
                  "type": "number"
                },
                "satisfaction_rating": {
                  "additionalProperties": true,
                  "description": "The satisfaction rating of the ticket, if it exists, or the state of satisfaction, \"offered\" or \"unoffered\". The value is null for plan types that don't support CSAT",
                  "readOnly": true,
                  "type": "object"
                },
                "sharing_agreement_ids": {
                  "description": "An array of the numeric IDs of sharing agreements. Note that this replaces any existing agreements",
                  "items": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "type": "array"
                },
                "sharing_agreements": {
                  "description": "Write only. Sharing agreement configuration for the ticket.\nAccepts a single object or an array of objects.\n",
                  "oneOf": [
                    {
                      "description": "A sharing agreement configuration to apply to a ticket",
                      "properties": {
                        "custom_fields": {
                          "items": {
                            "description": "A ticket custom field value assignment",
                            "properties": {
                              "id": {
                                "description": "The ID of the custom field",
                                "example": 27642,
                                "format": "int64",
                                "type": "integer"
                              },
                              "value": {
                                "description": "The value to assign to the custom field.\nType depends on the field configuration:\n- Text/textarea: string\n- Checkbox: boolean or \"true\"/\"false\" string\n- Dropdown/tagger: string or array of strings (multi-select)\n- Number/decimal: number or string representation\n- Date: string (ISO 8601 format)\n",
                                "example": "745",
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "items": {
                                      "type": "string"
                                    },
                                    "type": "array"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "id"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "id": {
                          "description": "The ID of the sharing agreement",
                          "format": "int64",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "items": {
                        "description": "A sharing agreement configuration to apply to a ticket",
                        "properties": {
                          "custom_fields": {
                            "items": {
                              "description": "A ticket custom field value assignment",
                              "properties": {
                                "id": {
                                  "description": "The ID of the custom field",
                                  "example": 27642,
                                  "format": "int64",
                                  "type": "integer"
                                },
                                "value": {
                                  "description": "The value to assign to the custom field.\nType depends on the field configuration:\n- Text/textarea: string\n- Checkbox: boolean or \"true\"/\"false\" string\n- Dropdown/tagger: string or array of strings (multi-select)\n- Number/decimal: number or string representation\n- Date: string (ISO 8601 format)\n",
                                  "example": "745",
                                  "oneOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "boolean"
                                    },
                                    {
                                      "items": {
                                        "type": "string"
                                      },
                                      "type": "array"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "id": {
                            "description": "The ID of the sharing agreement",
                            "format": "int64",
                            "type": "integer"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  ],
                  "writeOnly": true
                },
                "status": {
                  "description": "The state of the ticket.\n\nIf your account has activated custom ticket statuses, this is the ticket's\nstatus category. See [custom ticket statuses](#custom-ticket-statuses)\n",
                  "enum": [
                    "new",
                    "open",
                    "pending",
                    "hold",
                    "solved",
                    "closed"
                  ],
                  "type": "string"
                },
                "subject": {
                  "description": "The value of the subject field for this ticket. See [Subject](/api-reference/ticketing/tickets/tickets/#subject)\n",
                  "nullable": true,
                  "type": "string"
                },
                "submitter_id": {
                  "description": "The user who submitted the ticket. The submitter always becomes the\nauthor of the first comment on the ticket.\n\nIf not specified, defaults to the authenticated user.\n",
                  "format": "int64",
                  "nullable": true,
                  "type": "integer"
                },
                "support_type": {
                  "description": "The type of support that handled the ticket",
                  "enum": [
