                  "description": "The default branch — the `destination_branch` most pull requests target",
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "name": {
                  "description": "The repository's display name",
                  "type": "string"
                },
                "project": {
                  "description": "The Bitbucket project grouping this repository. Left untyped rather than enumerated",
                  "type": "object"
                },
                "scm": {
                  "description": "Always `git` on Bitbucket Cloud today",
                  "type": "string"
                },
                "size": {
                  "description": "The repository's size in bytes",
                  "type": "integer"
                },
                "slug": {
                  "description": "The repository's URL segment — pass this as `repo_slug` to every other operation here",
                  "type": "string"
                },
                "updated_on": {
                  "description": "When the repository last changed",
                  "format": "date-time",
                  "type": "string"
                },
                "uuid": {
                  "description": "The repository's stable identifier, in braces. Survives a rename, which `slug` does not",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "values"
        ],
        "type": "object"
