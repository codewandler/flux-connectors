    {
      "auth": [
        [
          "discord.bot_token"
        ]
      ],
      "description": "Post a message to a text channel, visible to everyone in it and notifying whoever is watching. Requires the bot to have SEND_MESSAGES in the channel. Posting twice posts two messages — Discord offers no idempotency key on this route. Discord rate-limits this route per channel and does not publish the figure: on a 429, wait the number of seconds in the `Retry-After` header before retrying, rather than retrying immediately",
      "direction": "write",
      "expose": true,
      "id": "discord-message-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The channel to post into, from discord-guild-channels' `id`. A decimal string of digits, never a channel name like `#general`. Confirm it is a text channel (`type` 0) before posting",
          "name": "channel_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        },
        {
          "description": "The message text, up to 2000 characters. Discord renders it as Markdown, and `@everyone`, `@here` and `<@id>` inside it mention real people if the bot has permission to — so text assembled from untrusted input can notify a whole guild",
          "name": "content",
          "position": "body",
          "required": true,
          "schema": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Set true to have Discord read the message aloud to everyone in the channel who has text-to-speech enabled. Omit for a normal message; this needs the SEND_TTS_MESSAGES permission",
          "name": "tts",
          "position": "body",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "content": {
              "$param": "content"
            },
            "tts": {
              "$param": "tts"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/channels/{channel_id}/messages"
      },
      "response_schema": {
        "description": "The message as Discord stored it",
        "properties": {
          "attachments": {
            "description": "Empty for a message posted through this connector, which sends no files",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "author": {
            "description": "The bot user this token authenticates as",
            "properties": {
              "bot": {
                "type": "boolean"
              },
              "id": {
                "description": "The bot's snowflake id, as a string",
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "username": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "channel_id": {
            "description": "The channel the message landed in, as a string",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "content": {
            "description": "The message text as Discord stored it — echo it back to confirm what was posted",
            "type": "string"
          },
          "edited_timestamp": {
            "description": "Null on a message just created",
            "type": "string"
          },
          "embeds": {
            "description": "Empty for a message posted through this connector, which sends no embeds",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "description": "The created message's snowflake id, as a string — what a later edit or delete would address it by, neither of which this connector offers",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "mention_everyone": {
            "description": "True if the posted text contained an @everyone or @here mention that actually applied — check this after posting text assembled from input the caller did not write",
            "type": "boolean"
          },
          "mentions": {
            "description": "The users the posted message mentioned, expanded",
            "items": {
              "properties": {
                "id": {
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "username": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "pinned": {
            "description": "False on a message just created",
            "type": "boolean"
          },
          "timestamp": {
            "description": "When the message was sent, ISO 8601",
            "type": "string"
          },
          "tts": {
            "type": "boolean"
          },
          "type": {
            "description": "The message kind; 0 for a normal message",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "channel_id",
          "content",
          "timestamp"
        ],
        "type": "object"
