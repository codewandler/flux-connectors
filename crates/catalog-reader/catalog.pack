{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Cloudflare API Token, sent as a bearer token, scoped to Zone:Read, DNS:Edit and Cache Purge on the zones this connector should reach",
      "env": [
        "CLOUDFLARE_API_TOKEN"
      ],
      "name": "cloudflare.api_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.cloudflare.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.cloudflare.api_token",
      "docs_url": "https://developers.cloudflare.com/fundamentals/api/get-started/create-token/",
      "format": "token",
      "help": "Create one at My Profile -> API Tokens -> Create Token, using the \"Edit zone DNS\" template or a custom token with Zone:Read, DNS:Edit and Cache Purge permissions on the zones you want this connector to reach. Cloudflare shows the token once",
      "label": "Cloudflare API token",
      "level": "connection",
      "name": "api_token",
      "required": true,
      "secret": true,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "path.zone_id",
      "docs_url": "https://developers.cloudflare.com/fundamentals/setup/find-account-and-zone-ids/",
      "example": "023e105f4ecef8ad9ca31a8372d0c353",
      "format": "text",
      "help": "The zone (domain) this connection manages, as 32 lowercase hex characters. Find it on the zone's Overview page in the Cloudflare dashboard, bottom right under \"Zone ID\", or by running the connector's \"List zones\" operation. One connection manages one zone",
      "label": "Cloudflare zone id",
      "level": "connection",
      "name": "zone_id",
      "required": true,
      "secret": false,
      "service": "default"
    }
  ],
  "connector": "cloudflare",
  "default_auth": [
    [
      "cloudflare.api_token"
    ]
  ],
  "description": "Cloudflare zones and DNS: list zones, list and manage DNS records for a zone, and purge a zone's cache",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "cloudflare.api_token"
        ]
      ],
      "description": "List the zones (domains) this API token can see, with each zone's id, name, status and assigned Cloudflare name servers. Returns Cloudflare's first page only; this connector declares no page or filter parameters (see the connector's header note). The zone `id` returned here is the value an operator pins as this connection's `zone_id`; every other operation in this connector is already scoped to that one zone and does not take it as an argument",
      "direction": "read",
      "expose": true,
      "id": "cloudflare-zone-list",
      "idempotency": "idempotent",
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errors/0/code",
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/zones"
      },
      "response_schema": {
        "properties": {
          "errors": {
            "items": {
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "result": {
            "items": {
              "properties": {
                "id": {
                  "description": "The zone's id, 32 lowercase hex characters — pass this as `zone_id` to every other operation",
                  "pattern": "^[0-9a-f]{32}$",
                  "type": "string"
                },
                "name": {
                  "description": "The registrable domain, e.g. example.com",
                  "type": "string"
                },
                "name_servers": {
                  "description": "The Cloudflare name servers this zone's registrar should point at",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "paused": {
                  "description": "True when Cloudflare is bypassed for this zone",
                  "type": "boolean"
                },
                "status": {
                  "description": "active, pending, initializing, moved, deleted, deactivated, or read only",
                  "type": "string"
                },
                "type": {
                  "description": "full (Cloudflare is authoritative) or partial (CNAME setup)",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "result_info": {
            "description": "Pagination totals for this response: page, per_page, count and total_count",
            "properties": {
              "count": {
                "type": "integer"
              },
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "total_count": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "result"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "cloudflare.api_token"
