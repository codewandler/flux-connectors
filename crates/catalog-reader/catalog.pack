            },
            "type": "object"
          },
          "results": {
            "description": "This page's pages — at most 25 of the space's pages, with no way to fetch the rest",
            "items": {
              "properties": {
                "_links": {
                  "description": "Carries `webui`, the page's path in the Confluence UI — the link to give a human, resolved against the site URL",
                  "type": "object"
