              },
              "lastname": {
                "$param": "lastname"
              }
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PATCH",
        "url": "{base}/crm/v3/objects/contacts/{contact_id}"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
