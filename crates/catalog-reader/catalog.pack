                      "example": "2020-04-16T22:21:38Z",
                      "format": "date-time",
                      "type": "string"
                    }
                  ],
                  "description": "When the call started."
                },
                "duration": {
                  "description": "Total call duration, in seconds.",
                  "type": "integer"
                },
                "handleTime": {
                  "description": "Total agent handle time (talk + hold + wrap-up), in seconds.",
                  "type": "integer"
                },
                "holdTime": {
                  "description": "Time the call was on hold, in seconds.",
                  "type": "integer"
                },
                "id": {
                  "description": "The unique Identifier (UUID) of the object",
                  "format": "uuid",
                  "type": "string"
                },
                "lastUpdated": {
                  "allOf": [
                    {
                      "example": "2020-04-16T22:21:38Z",
                      "format": "date-time",
                      "type": "string"
                    }
                  ],
                  "description": "When the reporting record was last updated."
                },
                "queueName": {
                  "description": "Name of the queue that handled the call, if any.",
                  "type": "string"
                },
                "queueWaitTime": {
                  "description": "Time the call spent waiting in queue, in seconds.",
                  "type": "integer"
                },
                "sessionId": {
                  "description": "The unique Identifier (UUID) of the object",
                  "format": "uuid",
                  "type": "string"
                },
                "talkTime": {
                  "description": "Time spent in conversation, in seconds.",
                  "type": "integer"
                },
                "type": {
                  "enum": [
                    "inboundCall",
                    "outboundCall"
                  ],
                  "type": "string"
                },
                "waitTime": {
                  "description": "Time the caller waited before the call was answered, in seconds.",
                  "type": "integer"
                },
                "wrapupTime": {
                  "description": "Agent wrap-up (after-call work) time, in seconds.",
                  "type": "integer"
                }
              },
