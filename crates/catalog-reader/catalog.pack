              "created",
              "updated",
              "due_date"
            ],
            "type": "string"
          }
        },
        {
          "description": "Reverse the sort order",
          "name": "reverse",
          "position": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "description": "Include closed tasks; excluded by default",
          "name": "include_closed",
          "position": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "archived",
            "value": {
              "$param": "archived"
            }
          },
          {
            "name": "include_closed",
            "value": {
              "$param": "include_closed"
            }
          },
          {
            "name": "order_by",
            "value": {
              "$param": "order_by"
            }
          },
          {
            "name": "page",
            "value": {
              "$param": "page"
            }
          },
          {
            "name": "reverse",
            "value": {
              "$param": "reverse"
            }
          }
        ],
        "url": "{base}/list/{list_id}/task"
      },
      "response_schema": {
        "properties": {
          "last_page": {
            "description": "Whether this is the final page",
            "type": "boolean"
          },
          "tasks": {
