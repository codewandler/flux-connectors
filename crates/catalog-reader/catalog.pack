        "example": {
          "items": [
            {
              "conditions": [
                {
                  "expectation": "+49",
                  "expression": "call.fromNumber",
                  "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                  "operator": null
                },
                {
                  "expectation": "+49",
                  "expression": "call.fromNumber",
                  "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                  "operator": null
                }
              ],
              "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
              "name": "Business hours only",
              "tags": [
                null,
                null
              ],
              "type": null
            },
            {
              "conditions": [
                {
                  "expectation": "+49",
                  "expression": "call.fromNumber",
                  "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                  "operator": null
                },
                {
                  "expectation": "+49",
                  "expression": "call.fromNumber",
                  "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                  "operator": null
                }
              ],
              "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
              "name": "Business hours only",
              "tags": [
                null,
                null
              ],
              "type": null
            }
          ],
          "pagination": {
            "current": 1,
            "max": 5,
            "maxResults": 5,
            "next": "next",
            "pages": 0,
            "total": 6
          }
        },
        "properties": {
          "items": {
            "items": {
              "description": "A reusable named set of conditions evaluated against an event or call context; referenced by automations and routings to decide whether to fire.",
              "example": {
                "conditions": [
                  {
                    "expectation": "+49",
                    "expression": "call.fromNumber",
                    "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                    "operator": null
                  },
                  {
                    "expectation": "+49",
                    "expression": "call.fromNumber",
                    "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                    "operator": null
                  }
                ],
                "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "name": "Business hours only",
                "tags": [
                  null,
                  null
                ],
                "type": null
              },
              "properties": {
                "conditions": {
                  "description": "The conditions evaluated, combined per the trigger's `type`.",
                  "items": {
                    "description": "A single condition — the `operator` compares the value resolved from `expression` against `expectation`.",
                    "example": {
                      "expectation": "+49",
                      "expression": "call.fromNumber",
                      "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                      "operator": null
                    },
                    "properties": {
                      "expectation": {
                        "description": "The value the resolved expression is compared against.",
                        "example": "+49",
                        "type": "string"
                      },
                      "expression": {
                        "description": "The variable or field whose value is evaluated.",
                        "example": "call.fromNumber",
                        "type": "string"
                      },
                      "id": {
                        "description": "The unique Identifier (UUID) of the object",
                        "format": "uuid",
                        "type": "string"
                      },
                      "operator": {
                        "description": "The comparison operator applied in a trigger condition.",
                        "enum": [
                          "EQ",
                          "NEQ",
                          "GT",
                          "GE",
                          "LT",
                          "LE",
                          "REGEXP",
                          "LIKE",
                          "GIVEN",
                          "NOT_GIVEN",
                          "STARTS_WITH",
                          "ENDS_WITH",
                          "CONTAINS",
                          "NOT_CONTAINS",
                          "IS_NULL",
                          "IS_NOT_NULL",
                          "EVALUABLE",
                          "NOT_EVALUABLE"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "expectation",
                      "expression",
                      "operator"
                    ],
                    "x-plugin-exclude": [
                      "mandatory-schema-id"
                    ]
                  },
                  "type": "array"
                },
                "id": {
                  "description": "The unique Identifier (UUID) of the object",
                  "format": "uuid",
                  "type": "string"
                },
                "name": {
                  "description": "The trigger's name (unique per customer).",
                  "example": "Business hours only",
                  "type": "string"
                },
                "tags": {
                  "description": "A List of Tags describing an Object",
                  "items": {
                    "description": "A Tag describing an Object",
                    "example": "foobar",
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
