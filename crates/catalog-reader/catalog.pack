      "request": {
        "method": "POST",
        "url": "{base}/2/users/get_current_account"
      },
      "response_schema": {
        "properties": {
          "account_id": {
            "description": "The account's unique, opaque id",
            "type": "string"
          },
          "account_type": {
            "description": "{\".tag\": \"basic\" | \"pro\" | \"business\"}",
            "type": "object"
          },
          "country": {
            "description": "ISO 3166-1 alpha-2 country code, if known",
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "name": {
            "description": "{given_name, surname, familiar_name, display_name, abbreviated_name}",
            "type": "object"
          }
        },
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "dropbox.access_token"
        ]
      ],
      "description": "List the files and folders directly inside a folder, first page only. Each entry names its own type (file, folder, or deleted), name and full path. Direction remains conservatively authored as write pending individual review; POST is transport only and supplied no evidence",
      "direction": "write",
      "expose": true,
      "id": "dropbox-folder-list",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The full path of the folder to list, from the account root — or the empty string \"\" for the root folder itself. Dropbox's root has no other spelling: \"/\" is a documented error (path/not_found or path/malformed_path), not an alias for \"\"",
          "name": "path",
          "position": "body",
          "required": true,
          "schema": {
            "default": "",
            "type": "string"
          }
        }
