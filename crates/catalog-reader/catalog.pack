          "schema": {
            "minLength": 3,
            "type": "string"
          },
          "wire": "properties.email"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/category",
          "message_pointer": "/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "properties": {
              "email": {
                "$param": "email"
              }
