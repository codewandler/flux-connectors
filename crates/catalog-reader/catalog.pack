      "id": "babelforce-get-widget-settings",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The widget type (e.g. babelconnect, taskmanager)",
          "name": "type",
          "position": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/api/v2/widget/{type}/settings"
      },
      "response_schema": {
        "example": {
          "item": {
            "features": [
              "recording_control"
            ],
            "settings": {
              "key": ""
            },
            "widget": "widget"
          },
          "success": true
        },
        "properties": {
          "item": {
            "description": "UI feature flags and type-specific settings for a widget. The `settings` object is assembled live from account settings and varies by widget type (e.g. `babelconnect` returns `wrapup`/`recording`; `taskmanager` returns `conversation`/`integrations`; other types return an empty object).",
            "example": {
              "features": [
                "recording_control"
              ],
              "settings": {
                "key": ""
              },
              "widget": "widget"
            },
            "properties": {
              "features": {
                "example": [
                  "recording_control"
                ],
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "settings": {
                "additionalProperties": true,
                "description": "Type-specific settings (shape depends on the widget type)",
                "type": "object"
              },
              "widget": {
                "description": "The widget type (echoes the path parameter)",
                "type": "string"
              }
            },
            "required": [
              "features",
              "settings",
              "widget"
            ]
          },
          "success": {
            "description": "Whether the Request was successful or not",
            "type": "boolean"
          }
        },
        "required": [
          "item",
          "success"
        ]
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "manager"
    },
