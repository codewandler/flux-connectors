      "description": "List the read-only audit history for one ticket, including field changes, comments and notifications",
      "direction": "read",
      "endpoint": {
        "subdomain": [
          "host"
        ]
      },
      "expose": true,
      "id": "zendesk-ticket-audit-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The ID of the ticket",
