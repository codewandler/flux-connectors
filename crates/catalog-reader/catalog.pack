{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Dropbox access token sent as a bearer — a scoped app access token or an OAuth2 access token",
      "env": [
        "DROPBOX_ACCESS_TOKEN"
      ],
