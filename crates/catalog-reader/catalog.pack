    {
      "auth": [
        [
          "babelforce.access_token"
        ]
      ],
      "description": "Create an application",
      "direction": "write",
      "expose": false,
      "id": "babelforce-create-application",
      "idempotency": "non_idempotent",
      "params": [
        {
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "description": "Request body to create an IVR voice-application. The chosen `module` fixes the application's type; its module-specific settings are then configured via update.",
            "example": {
