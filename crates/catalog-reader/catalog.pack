                        "description": "The user's role. Possible values are \"end-user\", \"agent\", or \"admin\"",
                        "type": "string"
                      },
                      "role_type": {
                        "description": "The user's role id. 0 for a custom agent, 1 for a light agent, 2 for a chat agent, 3 for a chat agent added to the Support account as a contributor ([Chat Phase 4](https://support.zendesk.com/hc/en-us/articles/4408836197658#topic_p1h_sx4_pgb)), 4 for an admin, and 5 for a billing admin",
                        "nullable": true,
                        "readOnly": true,
                        "type": "integer"
                      },
                      "separation": {
                        "description": "The brand separation scope for the user. Only present when the account has brand separation enabled.\nFor end users, indicates whether they are scoped to the full account or a specific brand.\nStaff users (agents and admins) always have `scope: \"account\"`.\n",
                        "properties": {
