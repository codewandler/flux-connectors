    {
      "auth": [
        [
          "babelforce.access_token"
        ]
      ],
      "direction": "read",
      "expose": false,
      "id": "babelforce-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Available filter fields:\n -id: task id (uuid)\n -state: task state (Scheduled, Assigned, etc.)\n -type: task type\n -has_error: if any action has an error, basically acts as only actions with errors on action level\n -queue_id: task queue id (uuid)\n -actions.id: action.uuid\n -actions.type: action type (js, http, action, etc.)\n -actions.has_error: boolean flag if true - the action executed with an error, false - the action executed successfully\n -actions.parent: action parent id\n -meta.start: start of execution millis since epoche\n -meta.end: end of execution millis since epoche",
          "name": "filter",
          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "type",
          "position": "query",
          "required": false,
          "schema": {
            "default": "action_paged",
            "enum": [
              "task",
              "action",
              "task_paged",
              "action_paged"
            ],
            "type": "string"
          }
        },
        {
          "name": "details",
          "position": "query",
          "required": false,
          "schema": {
            "default": "short",
            "enum": [
              "full",
              "short"
            ],
            "type": "string"
          }
        },
        {
          "description": "page size, \"1..100\" based.",
          "name": "page_size",
          "position": "query",
          "required": false,
          "schema": {
            "format": "int64",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "page index, \"1\" based.",
          "name": "page",
          "position": "query",
          "required": false,
          "schema": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "name": "context",
          "position": "query",
          "required": false,
          "schema": {
            "default": true,
            "type": "boolean"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "context",
            "value": {
              "$param": "context"
            }
          },
          {
            "name": "details",
            "value": {
              "$param": "details"
            }
          },
          {
            "name": "filter",
            "value": {
              "$param": "filter"
            }
          },
          {
            "name": "page",
            "value": {
              "$param": "page"
            }
          },
          {
