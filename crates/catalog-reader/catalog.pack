            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "tags": {
            "description": "Tags currently applied, each `{id, name}`",
            "items": {
              "properties": {
                "id": {
                  "pattern": "^tag_[0-9a-z]+$",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
