      "quirks": {
        "error_envelope": {
          "message_pointer": "/error_summary"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "query": {
              "$param": "query"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/2/files/search_v2"
      },
      "response_schema": {
        "properties": {
          "cursor": {
            "description": "The cursor for the next page, present only when has_more is true. Unusable here, for the reason given on has_more",
            "type": "string"
          },
          "has_more": {
            "description": "True when more matches exist than this page returned. This connector cannot fetch them — no continuation cursor is shipped",
            "type": "boolean"
          },
          "matches": {
            "description": "The matching files and folders, each {metadata: {...}, match_type: {\".tag\": \"filename\"|\"content\"|\"both\"}}",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "dropbox.access_token"
        ]
      ],
      "description": "Create a new folder at the given path, including any missing parent folders. Naming a path that already exists answers 409 conflict rather than creating a duplicate, since autorename is not offered by this connector",
      "direction": "write",
      "expose": true,
      "id": "dropbox-folder-create",
      "idempotency": "non_idempotent",
      "params": [
