          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          }
        ],
        "url": "{base}/channels/{channel_id}/messages"
      },
      "response_schema": {
        "description": "The channel's most recent messages, newest first",
        "items": {
          "properties": {
            "attachments": {
              "description": "Files attached to the message. Left untyped rather than enumerated; each carries a snowflake `id`, a `filename`, a `size` and a CDN `url`",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "author": {
              "description": "Who sent the message. Identifies a named person — read it for what the calling flow needs and do not persist it beyond that",
              "properties": {
                "bot": {
                  "description": "True when another application sent this message",
                  "type": "boolean"
                },
                "global_name": {
                  "description": "The author's display name, or null",
                  "type": "string"
                },
                "id": {
                  "description": "The author's snowflake id, as a string",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "username": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "channel_id": {
              "description": "The channel the message was posted in, as a string",
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            "content": {
              "description": "The message text as Discord stores it, with mentions still in their raw `<@id>` form. Empty for a message that carries only an embed or an attachment — and empty for every message if the bot lacks the privileged MESSAGE_CONTENT intent, which is granted in the Developer Portal and has no representation in this connector",
              "type": "string"
            },
            "edited_timestamp": {
              "description": "When it was last edited, ISO 8601, or null if never",
              "type": "string"
            },
            "embeds": {
              "description": "Rich embeds on the message. Left untyped rather than enumerated — Discord's embed object is large and this file declares what it can name with confidence",
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "id": {
              "description": "The message's snowflake id, as a string",
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            "mention_everyone": {
              "description": "Whether the message contained an @everyone or @here mention that actually applied",
              "type": "boolean"
            },
            "mentions": {
              "description": "The users this message mentioned, expanded",
              "items": {
                "properties": {
                  "id": {
                    "description": "The mentioned user's snowflake id, as a string",
                    "pattern": "^[0-9]+$",
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "pinned": {
              "type": "boolean"
            },
            "timestamp": {
              "description": "When the message was sent, ISO 8601",
              "type": "string"
            },
            "tts": {
              "description": "Whether the message was sent as text-to-speech",
              "type": "boolean"
            },
            "type": {
              "description": "The message kind. 0 is a normal message; other values are Discord's own system notices, such as a join or a pin",
              "type": "integer"
            },
            "webhook_id": {
              "description": "Set when the message came from a webhook rather than a user, as a snowflake string",
              "type": "string"
            }
          },
          "required": [
            "id",
            "channel_id",
            "content",
            "timestamp"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
