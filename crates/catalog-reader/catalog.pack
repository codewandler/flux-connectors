  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "base_url": "https://api.github.com",
      "legacy": true,
      "name": "default",
      "tags": [
        "source-control",
        "issue-tracking"
      ]
    },
    {
      "base_url": "https://github.com",
      "description": "GitHub's OAuth2 authorize and token endpoints, served by github.com rather than by the API host.",
      "name": "login"
    }
  ],
  "vendor": "GitHub",
  "verify": "github-user-get"
