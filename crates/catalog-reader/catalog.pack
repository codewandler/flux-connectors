                "type": "inboundCall",
                "waitTime": 7,
                "wrapupTime": 12
              },
              "properties": {
                "agentName": {
                  "description": "Name of the agent who handled the call, if any.",
                  "type": "string"
                },
                "bridgeTime": {
                  "description": "Time until the call was bridged to an agent, in seconds.",
                  "type": "integer"
                },
