              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "folders"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "clickup.token"
        ]
      ],
      "description": "List tasks in a list, most recently created first by default",
