      },
      "expose": true,
      "id": "newrelic-alert-policy-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/alerts_policies.json"
      },
      "response_schema": {
        "properties": {
          "policies": {
            "items": {
              "properties": {
                "created_at": {
                  "description": "When the policy was created, as an epoch timestamp in milliseconds — not seconds, and not an ISO string",
                  "type": "integer"
                },
                "id": {
                  "description": "The policy's id",
                  "type": "integer"
                },
                "incident_preference": {
                  "description": "How New Relic groups violations into incidents under this policy — `PER_POLICY`, `PER_CONDITION` or `PER_CONDITION_AND_TARGET`. It decides how many incidents one bad deploy produces",
                  "type": "string"
                },
                "name": {
                  "description": "The policy name, as it reads in New Relic's UI",
                  "type": "string"
                },
                "updated_at": {
                  "description": "When the policy was last changed, as an epoch timestamp in milliseconds",
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "policies"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "newrelic.api_key"
        ]
      ],
      "description": "List the account's alert violations from New Relic's default recent window. READ `closed_at` ON EVERY ENTRY: this returns closed violations as well as open ones, and a violation with a non-null `closed_at` has already resolved. Each entry names the policy and condition that fired and the entity that broke",
      "direction": "read",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "newrelic-alert-violation-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/alerts_violations.json"
      },
      "response_schema": {
        "properties": {
          "violations": {
            "description": "Violations in the default window, open and closed together",
            "items": {
              "properties": {
                "closed_at": {
                  "description": "When the violation closed, as an epoch timestamp in milliseconds, or null. NULL IS THE ONLY THING THAT MEANS STILL OPEN",
                  "type": "integer"
                },
                "condition_name": {
                  "description": "The condition inside that policy which fired",
                  "type": "string"
                },
                "duration": {
                  "description": "How long the violation lasted, in seconds. On an open violation this is how long it has been open so far",
                  "type": "integer"
                },
                "entity": {
                  "description": "What broke: `{product, type, group_id, id, name}`. `product` is `APM`, `Browser`, `Mobile` or `Infrastructure`, and `id` addresses the entity within that product — for an APM entity it is an application id newrelic-application-get takes",
                  "type": "object"
                },
                "id": {
                  "description": "The violation's id",
                  "type": "integer"
                },
                "label": {
                  "description": "New Relic's own one-line summary of what broke",
                  "type": "string"
                },
                "links": {
                  "description": "The `policy_id` and `condition_id` behind `policy_name` and `condition_name`. Ids only",
                  "type": "object"
                },
                "opened_at": {
                  "description": "When the violation opened, as an epoch timestamp in milliseconds",
                  "type": "integer"
                },
                "policy_name": {
                  "description": "The alert policy the violation belongs to — matches a `name` from newrelic-alert-policy-list",
                  "type": "string"
                },
                "priority": {
                  "description": "The condition's threshold severity — `Critical` or `Warning`",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "opened_at"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "violations"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "newrelic.api_key"
        ]
      ],
      "description": "List the deployment markers recorded against one application, most recent first. These are the markers New Relic overlays on its charts — read them to answer \"what shipped before this went wrong\"",
      "direction": "read",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "newrelic-deployment-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The application's id, from newrelic-application-list's `id`",
          "name": "application_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/applications/{application_id}/deployments.json"
      },
      "response_schema": {
        "properties": {
          "deployments": {
            "items": {
              "properties": {
                "changelog": {
                  "description": "What changed, as free text, or null",
                  "type": "string"
                },
                "description": {
                  "description": "A one-line summary of the deployment, or null",
                  "type": "string"
                },
                "id": {
                  "description": "The deployment marker's id",
                  "type": "integer"
                },
                "links": {
                  "description": "The application id this marker belongs to",
                  "type": "object"
                },
                "revision": {
                  "description": "The version this deployment shipped, as the recorder spelled it — a commit sha, a tag or a build number",
                  "type": "string"
                },
                "timestamp": {
                  "description": "When the deployment was recorded, as an ISO 8601 timestamp",
                  "type": "string"
                },
                "user": {
                  "description": "Who recorded the deployment, as free text — whatever the recorder passed, not a verified New Relic identity. Identifies a person; read it for what the calling flow needs and do not persist it beyond that",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "timestamp"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "deployments"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "newrelic.api_key"
        ]
      ],
      "description": "Record a deployment marker against an application, timestamped now. The marker appears on every chart for that application and is visible to everyone on the account; this connector cannot remove one once recorded. Calling this twice records two deployments",
      "direction": "write",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "newrelic-deployment-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The application the deployment shipped to, from newrelic-application-list's `id`",
          "name": "application_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The version that shipped — a commit sha, a tag or a build number. The only field New Relic requires, and the one every chart overlay is labelled with, so pass something a human can trace back to a build",
          "name": "revision",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "deployment.revision"
        },
        {
          "description": "What changed in this deployment, as free text. Shown when the marker is opened",
          "name": "changelog",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "deployment.changelog"
        },
        {
          "description": "A one-line summary of the deployment, shown on the marker itself",
          "name": "description",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "deployment.description"
        },
        {
          "description": "Who or what performed the deployment, as free text. New Relic records this verbatim and does not verify it against a New Relic identity — pass a service or pipeline name rather than a personal one unless the flow has a reason to name a person",
          "name": "user",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "deployment.user"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "deployment": {
              "changelog": {
                "$param": "changelog"
              },
              "description": {
                "$param": "description"
              },
              "revision": {
                "$param": "revision"
              },
              "user": {
                "$param": "user"
              }
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/applications/{application_id}/deployments.json"
      },
      "response_schema": {
        "properties": {
          "deployment": {
            "properties": {
              "changelog": {
                "description": "The changelog as recorded, or null",
                "type": "string"
              },
              "description": {
                "description": "The description as recorded, or null",
                "type": "string"
              },
              "id": {
                "description": "The created marker's id",
                "type": "integer"
              },
              "links": {
                "description": "The application id this marker belongs to",
                "type": "object"
              },
              "revision": {
                "description": "The revision as recorded — echo it back to confirm the marker landed on the build you meant",
                "type": "string"
              },
              "timestamp": {
                "description": "When New Relic recorded the marker, as an ISO 8601 timestamp. New Relic sets this; it is not accepted from the request",
                "type": "string"
              },
              "user": {
                "description": "The user as recorded, verbatim and unverified",
                "type": "string"
              }
            },
            "required": [
              "id",
              "timestamp"
            ],
            "type": "object"
          }
        },
        "required": [
          "deployment"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "2",
      "base_url": "https://{host}/v2",
      "gid": "com.newrelic.api:2",
      "name": "default",
      "tags": [
        "observability"
      ]
    }
  ],
  "vendor": "New Relic",
  "verify": "newrelic-application-list"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Notion integration token sent as a bearer — an internal integration token or an OAuth-issued access token",
      "env": [
        "NOTION_TOKEN"
      ],
      "name": "notion.token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.notion.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.notion.token",
      "docs_url": "https://developers.notion.com/docs/authorization",
      "format": "token",
      "help": "Create an integration at notion.so/my-integrations and copy its Internal Integration Secret. **Then share your pages with it**: in Notion, open each page or database, use the ••• menu → Connections → and add your integration. An integration can only see content that has been shared with it this way, so a token that is otherwise valid returns a 404 for a page you can see in your browser until you do. Sharing a parent page shares everything under it",
      "label": "Integration token",
      "level": "connection",
      "name": "token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "notion",
  "default_auth": [
    [
      "notion.token"
    ]
  ],
  "description": "Notion workspace: read a page's properties, query a database, search shared content, and create a page",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "notion.token"
        ]
      ],
      "description": "Get the bot user this integration authenticates as, confirming the token resolves and naming the workspace it belongs to. Takes no parameters",
      "direction": "read",
      "expose": true,
      "id": "notion-user-me",
      "idempotency": "idempotent",
      "quirks": {
        "error_envelope": {
          "code_pointer": "/code",
          "message_pointer": "/message"
        }
      },
      "request": {
        "headers": {
          "Notion-Version": "2022-06-28"
        },
        "method": "GET",
        "url": "{base}/v1/users/me"
      },
      "response_schema": {
        "properties": {
          "bot": {
            "description": "The integration's owner and workspace name",
            "type": "object"
          },
          "id": {
            "description": "The bot user's id",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "object": {
            "const": "user"
          },
          "type": {
            "const": "bot"
          }
        },
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "notion.token"
        ]
      ],
      "description": "Get one page's properties, parent, icon, cover and timestamps. This does NOT return the page's text — in Notion a page's content is a separate tree of blocks, which this connector cannot read",
      "direction": "read",
      "expose": true,
      "id": "notion-page-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The page's id, a UUID. It is the last path segment of the page's URL, where it appears without hyphens — either spelling is accepted",
          "name": "page_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 32,
            "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$",
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/code",
          "message_pointer": "/message"
        }
      },
      "request": {
        "headers": {
          "Notion-Version": "2022-06-28"
        },
        "method": "GET",
        "url": "{base}/v1/pages/{page_id}"
      },
      "response_schema": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "created_time": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_edited_time": {
            "format": "date-time",
            "type": "string"
          },
          "object": {
            "const": "page"
          },
          "parent": {
            "description": "Where the page lives: `{type: \"database_id\", database_id}`, `{type: \"page_id\", page_id}` or `{type: \"workspace\"}`",
            "type": "object"
          },
          "properties": {
            "description": "The page's property values, keyed by property name. For a page in a database the keys are that database's own columns, so they are known only at runtime; for a page with a page parent there is exactly one, `title`",
            "type": "object"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "notion.token"
        ]
      ],
      "description": "Query a database and return its first page of entries (up to 100), unfiltered and in the database's default order. Each entry is a page, and its `properties` are keyed by that database's own column names. Direction remains conservatively authored as write pending individual review; POST is transport only and supplied no evidence",
      "direction": "write",
      "expose": true,
      "id": "notion-database-query",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The database's id, a UUID. Open the database as a full page in Notion and it is the last path segment of the URL — not the id of a page inside it",
          "name": "database_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 32,
            "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$",
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/code",
          "message_pointer": "/message"
        }
      },
      "request": {
        "headers": {
          "Notion-Version": "2022-06-28"
        },
        "method": "POST",
        "url": "{base}/v1/databases/{database_id}/query"
      },
      "response_schema": {
        "properties": {
          "has_more": {
            "description": "True when the database holds more entries than this page returned. This connector cannot fetch them — the cursor is an opaque token and no query parameter is encodable (C-30)",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "The cursor for the next page. Unusable here, for the reason given on `has_more`",
            "type": "string"
          },
          "object": {
            "const": "list"
          },
          "results": {
            "description": "The matching pages, each with its own `properties` object keyed by the database's column names",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "notion.token"
        ]
      ],
      "description": "Search the pages and databases shared with this integration by title, returning the first page of matches (up to 100). Notion matches on title only — it does not search page text. Direction remains conservatively authored as write pending individual review; POST is transport only and supplied no evidence",
      "direction": "write",
      "expose": true,
      "id": "notion-search",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The text to match against page and database titles. An empty string returns everything shared with the integration",
          "name": "query",
          "position": "body",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/code",
          "message_pointer": "/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "query": {
              "$param": "query"
            }
          }
        },
        "headers": {
          "Notion-Version": "2022-06-28",
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/v1/search"
      },
      "response_schema": {
        "properties": {
          "has_more": {
            "description": "True when more matches exist than this page returned. This connector cannot fetch them — see notion-database-query",
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string"
          },
          "object": {
            "const": "list"
          },
          "results": {
            "description": "The matching pages and databases, newest first",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "notion.token"
        ]
      ],
      "description": "Create a new empty page as a child of an existing page. The page is created with a title and no content — this connector cannot write page body text, which in Notion is a separate tree of blocks. The parent page must be shared with this integration",
      "direction": "write",
      "expose": true,
      "id": "notion-page-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The id of the existing page to create this page inside, a UUID. It must be a page, not a database, and it must be shared with this integration",
          "name": "parent_page_id",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 32,
            "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "wire": "parent.page_id"
        },
        {
          "description": "The page title as Notion rich text: a list of runs, each `{\"text\": {\"content\": \"...\"}}`. A plain title is one run — `[{\"text\": {\"content\": \"My page\"}}]`",
          "name": "title",
          "position": "body",
          "required": true,
          "schema": {
            "items": {
              "properties": {
                "text": {
                  "properties": {
                    "content": {
                      "description": "The literal text of this run",
                      "type": "string"
                    },
                    "link": {
                      "description": "An optional link on this run, `{\"url\": \"...\"}`",
                      "type": "object"
                    }
                  },
                  "required": [
                    "content"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "wire": "properties.title"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/code",
          "message_pointer": "/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "parent": {
              "page_id": {
                "$param": "parent_page_id"
              }
            },
            "properties": {
              "title": {
                "$param": "title"
              }
            }
          }
        },
        "headers": {
          "Notion-Version": "2022-06-28",
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/v1/pages"
      },
      "response_schema": {
        "properties": {
          "created_time": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The created page's id, which is what later calls address it by",
            "type": "string"
          },
          "object": {
            "const": "page"
          },
          "parent": {
            "type": "object"
          },
          "url": {
            "description": "The created page's Notion URL",
            "type": "string"
          }
        },
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "v1",
      "base_url": "https://api.notion.com",
      "gid": "com.notion.api:v1",
      "name": "default",
      "tags": [
        "knowledge-base"
      ]
    }
  ],
  "vendor": "Notion",
  "verify": "notion-user-me"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Okta API token, sent as `Authorization: SSWS <token>`. The `SSWS ` scheme word is supplied by the connector; the token is the value alone",
      "env": [
        "OKTA_API_TOKEN"
      ],
      "name": "okta.api_token",
      "scheme": {
        "kind": "header",
        "name": "Authorization",
        "prefix": "SSWS "
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.okta.api",
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.domain",
      "docs_url": "https://developer.okta.com/docs/api/#url-namespace",
      "example": "acme.okta.com",
      "format": "hostname",
      "help": "The full host you sign in to, without `https://` — if your Okta URL is `https://acme.okta.com`, this is `acme.okta.com`. European and preview orgs use `.okta-emea.com` and `.oktapreview.com`, and an org with a customised domain uses that instead, so give the whole host rather than just the first part",
      "label": "Okta domain",
      "level": "connection",
      "name": "domain",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.okta.api_token",
      "docs_url": "https://developer.okta.com/docs/guides/create-an-api-token/",
      "format": "token",
      "help": "Create one under Security → API → Tokens in the Okta Admin Console. The token inherits the permissions of the administrator who creates it, so create it as an account with only the access this connection needs — reading users and groups needs a read-only administrator, and okta-user-deactivate needs one that can manage users. Okta shows the token once, and it expires after 30 days without use",
      "label": "API token",
      "level": "connection",
      "name": "api_token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "okta",
  "default_auth": [
    [
      "okta.api_token"
    ]
  ],
  "description": "Okta identity management: read users and groups in an org, read a user's group memberships, and deactivate a user",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "okta.api_token"
        ]
      ],
      "description": "List users in the Okta org. Returns a JSON array of user objects, most recently created first. Without a filter this is the org's active user population, so use `limit` to bound it — see okta-user-get to read one user by id or login",
      "direction": "read",
      "endpoint": {
        "domain": [
          "host"
        ]
      },
      "expose": true,
      "id": "okta-user-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Maximum number of users to return in this page. Okta caps this per endpoint and the cap is not declared here, so a value above it is reduced by Okta rather than rejected",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          }
        ],
        "url": "{base}/users"
      },
      "response_schema": {
        "description": "The org's users",
        "items": {
          "properties": {
            "activated": {
              "type": "string"
            },
            "created": {
              "description": "When the user was created, ISO 8601",
              "type": "string"
            },
            "credentials": {
              "description": "Which authentication providers and recovery factors are configured for this user. Never carries a password or a secret value",
              "type": "object"
            },
            "id": {
              "description": "The user's Okta id, e.g. `00u1a2b3c4D5e6F7g8h9` — pass this as `user_id` to the other operations below",
              "type": "string"
            },
            "lastLogin": {
              "description": "When the user last authenticated; absent for a user who never has",
              "type": "string"
            },
            "lastUpdated": {
              "type": "string"
            },
            "passwordChanged": {
              "type": "string"
            },
            "profile": {
              "description": "The user's profile attributes. `login` and `email` are always present; an org may add custom attributes to its user schema, so this object is not exhaustively enumerated here",
              "properties": {
                "email": {
                  "type": "string"
                },
                "firstName": {
                  "type": "string"
                },
                "lastName": {
                  "type": "string"
                },
                "login": {
                  "description": "The user's unique sign-in identifier, usually their email address. Accepted in place of the id by okta-user-get",
                  "type": "string"
                },
                "mobilePhone": {
                  "type": "string"
                },
                "secondEmail": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "status": {
              "description": "The user's lifecycle state. Okta's values include STAGED, PROVISIONED, ACTIVE, RECOVERY, PASSWORD_EXPIRED, LOCKED_OUT, SUSPENDED and DEPROVISIONED; treat this as an open string rather than a closed set, because Okta has added states over time",
              "type": "string"
            },
            "statusChanged": {
              "type": "string"
            },
            "type": {
              "description": "The user type this user was created with, as `{id, …}`",
              "type": "object"
            }
          },
          "required": [
            "id",
            "status",
            "profile"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "okta.api_token"
        ]
      ],
      "description": "Get one user's full record, including their lifecycle status and profile attributes. Accepts the user's Okta id or their login, so a caller holding an email address does not need to list first",
      "direction": "read",
      "endpoint": {
        "domain": [
          "host"
        ]
      },
      "expose": true,
      "id": "okta-user-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The user's Okta id (from okta-user-list's `id`) or their login, e.g. `ada@example.com`. Okta resolves either",
          "name": "user_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/users/{user_id}"
      },
      "response_schema": {
        "properties": {
          "activated": {
            "type": "string"
          },
          "created": {
            "type": "string"
          },
          "credentials": {
            "description": "Which authentication providers and recovery factors are configured for this user. Never carries a password or a secret value",
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "lastLogin": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string"
          },
          "passwordChanged": {
            "type": "string"
          },
          "profile": {
            "description": "The user's profile attributes; an org may add custom ones to its user schema",
            "properties": {
              "email": {
                "type": "string"
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "login": {
                "type": "string"
              },
              "mobilePhone": {
                "type": "string"
              },
              "secondEmail": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "status": {
            "description": "The user's lifecycle state — see okta-user-list for the values Okta documents. `DEPROVISIONED` is what okta-user-deactivate leaves behind",
            "type": "string"
          },
          "statusChanged": {
            "type": "string"
          },
          "type": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "status",
          "profile"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "okta.api_token"
        ]
      ],
      "description": "List groups in the Okta org. Returns a JSON array of group objects. A group is how Okta grants application access in bulk, so this is the set a membership question is asked against",
      "direction": "read",
      "endpoint": {
        "domain": [
          "host"
        ]
      },
      "expose": true,
      "id": "okta-group-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Maximum number of groups to return in this page. Okta caps this per endpoint and the cap is not declared here, so a value above it is reduced by Okta rather than rejected",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          }
        ],
        "url": "{base}/groups"
      },
      "response_schema": {
        "description": "The org's groups",
        "items": {
          "properties": {
            "created": {
              "type": "string"
            },
            "id": {
              "description": "The group's Okta id, e.g. `00g1a2b3c4D5e6F7g8h9`",
              "type": "string"
            },
            "lastMembershipUpdated": {
              "description": "When a member was last added or removed",
              "type": "string"
            },
            "lastUpdated": {
              "type": "string"
            },
            "objectClass": {
              "description": "The group's schema classes, e.g. `[\"okta:user_group\"]`",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "profile": {
              "description": "The group's own attributes",
              "properties": {
                "description": {
                  "type": "string"
                },
                "name": {
                  "description": "The group's display name",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": {
              "description": "Where the group comes from. Okta's values include OKTA_GROUP (created in Okta), APP_GROUP (sourced from an application such as an LDAP or AD directory) and BUILT_IN (Okta's own, e.g. Everyone); treat this as an open string",
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "profile"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "okta.api_token"
        ]
      ],
      "description": "List the groups one user is a member of. This is the direct answer to \"what access does this person have\", because Okta grants application assignments through group membership",
      "direction": "read",
      "endpoint": {
        "domain": [
          "host"
        ]
      },
      "expose": true,
      "id": "okta-user-group-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The user's Okta id (from okta-user-list's `id`) or their login, e.g. `ada@example.com`. Okta resolves either",
          "name": "user_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Maximum number of groups to return in this page. Okta caps this per endpoint and the cap is not declared here, so a value above it is reduced by Okta rather than rejected",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          }
        ],
        "url": "{base}/users/{user_id}/groups"
      },
      "response_schema": {
        "description": "The groups this user belongs to, in the same shape okta-group-list returns",
        "items": {
          "properties": {
            "created": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "lastMembershipUpdated": {
              "type": "string"
            },
            "lastUpdated": {
              "type": "string"
            },
            "objectClass": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "profile": {
              "properties": {
                "description": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": {
              "description": "Where the group comes from — see okta-group-list",
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "profile"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "okta.api_token"
        ]
      ],
      "description": "Deactivate a user, moving them to DEPROVISIONED. This takes effect immediately: Okta ends the person's active sessions, revokes their tokens and grants, and removes their access to every application the org assigns through Okta. They cannot sign in afterwards. An administrator can reactivate the account later, but that is a separate operation this connector does not offer, and it does not restore the sessions or tokens this call destroyed",
      "direction": "write",
      "endpoint": {
        "domain": [
          "host"
        ]
      },
      "expose": true,
      "id": "okta-user-deactivate",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The user's Okta id (from okta-user-list's `id`) or their login, e.g. `ada@example.com`. Okta resolves either — confirm with okta-user-get before calling this",
          "name": "user_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Set true to have Okta send its deactivation notification email. Omit for Okta's default, which sends none",
          "name": "send_email",
          "position": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          },
          "wire": "sendEmail"
        }
      ],
      "request": {
        "method": "POST",
        "query": [
          {
            "name": "sendEmail",
            "value": {
              "$param": "send_email"
            }
          }
        ],
        "url": "{base}/users/{user_id}/lifecycle/deactivate"
      },
      "risk": "destructive",
      "semantic_effects": [],
      "service": "default"
    }
