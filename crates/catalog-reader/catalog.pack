            "type": "object"
          },
          "created_at": {
            "description": "Unix seconds — an integer, not an ISO string",
            "type": "integer"
          },
          "custom_attributes": {
            "type": "object"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "external_id": {
            "type": "string"
          },
          "id": {
            "description": "The new contact's id — the only handle on the record this call created, and what a following note addresses",
