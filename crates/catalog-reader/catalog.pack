          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "description": "Only bounces created at or before this Unix timestamp",
          "name": "end_time",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
