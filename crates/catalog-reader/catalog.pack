{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Intercom access token sent as a bearer — an OAuth app token or a workspace access token",
      "env": [
        "INTERCOM_ACCESS_TOKEN"
      ],
      "name": "intercom.access_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.intercom.api",
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.host",
      "choices": [
        {
          "label": "United States",
          "value": "api.intercom.io"
        },
        {
          "label": "European Union",
          "value": "api.eu.intercom.io"
        },
        {
          "label": "Australia",
          "value": "api.au.intercom.io"
        }
      ],
      "docs_url": "https://developers.intercom.com/docs/references/rest-api/api.intercom.io/",
      "example": "api.intercom.io",
      "format": "hostname",
      "help": "Which region this Intercom workspace is hosted in. Pick United States, European Union or Australia — Intercom assigns the region when the workspace is created and it does not change. If you are not sure, look at the URL you use Intercom at: app.intercom.com is the US region, app.eu.intercom.com the EU one and app.au.intercom.com the Australian one. A token issued for one region returns 401 against another, exactly as a revoked token would",
      "label": "Intercom region",
      "level": "connection",
      "name": "host",
      "required": true,
      "secret": false,
      "service": "default"
    }
  ],
  "connector": "intercom",
  "default_auth": [
    [
      "intercom.access_token"
    ]
  ],
  "description": "Intercom contacts and conversations: read and create contacts, read a conversation, reply to it, and note it",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "intercom.access_token"
        ]
      ],
      "description": "Get one Intercom contact by id — its role, email, name, custom attributes, tags and the companies it belongs to",
      "direction": "read",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "intercom-contact-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The contact's Intercom id — a 24-character lowercase hexadecimal string such as `63a0979a5eeebeb3d8ba5be3`, not its email or your own external id",
          "name": "contact_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/errors/0/code",
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/contacts/{contact_id}"
      },
      "response_schema": {
        "properties": {
          "avatar": {
            "description": "`{type, image_url}` or null — an object, not a URL string",
            "type": "object"
          },
          "companies": {
            "description": "The same wrapper shape — companies at `.data`",
            "type": "object"
          },
          "created_at": {
            "description": "Unix seconds — an integer, not an ISO string",
            "type": "integer"
          },
          "custom_attributes": {
            "description": "The workspace's own attributes, keyed by name. Which keys exist is per workspace, so none is declared",
            "type": "object"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "external_id": {
            "description": "Your own id for this person, or null. Intercom's identity model treats this and `email` as the two identifiers",
            "type": "string"
          },
          "has_hard_bounced": {
            "description": "Their address bounced permanently; mail to it will not arrive",
            "type": "boolean"
          },
          "id": {
            "description": "The 24-character Intercom id, which is what this operation takes",
            "type": "string"
          },
          "last_contacted_at": {
            "description": "Unix seconds, or null",
            "type": "integer"
          },
          "last_replied_at": {
            "description": "Unix seconds, or null",
            "type": "integer"
          },
          "last_seen_at": {
            "description": "Unix seconds of the last time Intercom saw this person, or null. This is the field that says whether a contact is live",
            "type": "integer"
          },
          "location": {
            "description": "Intercom's IP-derived guess: `{type, country, region, city}`",
            "type": "object"
          },
          "marked_email_as_spam": {
            "type": "boolean"
          },
          "name": {
            "description": "Null unless set",
            "type": "string"
          },
          "notes": {
            "description": "The same wrapper shape — notes at `.data`",
            "type": "object"
          },
          "owner_id": {
            "description": "The admin who owns the contact, or null",
            "type": "integer"
          },
          "phone": {
            "description": "Null unless set",
            "type": "string"
          },
          "role": {
            "description": "`user` for an identified person or `lead` for an unidentified visitor. A lead can be merged into a user later, which changes the id a flow should hold",
            "type": "string"
          },
          "signed_up_at": {
            "description": "Unix seconds, or null for a contact that never signed up",
            "type": "integer"
          },
          "social_profiles": {
            "description": "The same wrapper shape",
            "type": "object"
          },
          "tags": {
            "description": "A PAGINATED WRAPPER, not an array: `{type, data, url, total_count, has_more}`. The tags are at `.data`, and `has_more` true means there are more than were returned",
            "type": "object"
          },
          "type": {
            "const": "contact"
          },
          "unsubscribed_from_emails": {
            "description": "TRUE MEANS DO NOT EMAIL THIS PERSON. Check it before a flow sends anything",
            "type": "boolean"
          },
          "updated_at": {
            "description": "Unix seconds",
            "type": "integer"
          },
          "workspace_id": {
            "description": "The workspace the contact belongs to — Intercom's app id",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
