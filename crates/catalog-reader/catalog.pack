          "locked": {
            "type": "boolean"
          },
          "milestone": {
            "description": "The milestone, or null",
            "type": "object"
          },
          "node_id": {
            "type": "string"
          },
          "number": {
            "description": "The per-repository number — what this operation's `issue_number` takes",
            "type": "integer"
          },
          "pull_request": {
            "description": "PRESENT ONLY IF THIS IS A PULL REQUEST — `{url, html_url, diff_url, patch_url, merged_at}`. Its presence is how GitHub says the answer is a PR; read its merge and review state with `github-pull-get`, and note that `merged_at` here is null for an open or closed-unmerged PR",
            "type": "object"
          },
          "state": {
            "description": "`open` or `closed`",
            "type": "string"
          },
          "state_reason": {
            "description": "Why it closed: `completed`, `not_planned`, `duplicate` or `reopened`. Null on an open issue, and the difference between a fixed issue and a dismissed one",
