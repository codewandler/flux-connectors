                  "format": "int64",
                  "type": "integer",
                  "writeOnly": true
                },
                "suspension_type_id": {
                  "description": "Write only. The suspension type ID when recovering a suspended ticket",
                  "format": "int64",
                  "type": "integer",
                  "writeOnly": true
                },
