            "type": "string"
          },
          "body_text": {
            "description": "The note as plain text",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The note's own id, distinct from the ticket's",
            "type": "integer"
          },
          "incoming": {
            "description": "True when the note represents something the customer sent in rather than an agent's own note",
