        "url": "{base}/flags/{project_key}/{feature_flag_key}"
      },
      "response_schema": {
        "properties": {
          "description": {
            "type": "string"
          },
          "environments": {
            "description": "Keyed by environment key (e.g. \"production\"); each value carries at least an `on` boolean plus targeting rules, prerequisites and a fallthrough variation this curated connector does not enumerate further — read `on` and pass the object through rather than assuming any deeper shape",
            "type": "object"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "description": "`boolean` or `multivariate`",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "temporary": {
            "type": "boolean"
          },
          "variations": {
            "description": "Every value this flag can serve, each `{value, name, description}`",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
