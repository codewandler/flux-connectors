        },
        "method": "POST",
        "url": "{base}/2/files/list_folder"
      },
      "response_schema": {
        "properties": {
          "cursor": {
            "description": "The cursor for continuing to the next page. This connector cannot fetch it — list_folder/continue is not shipped",
            "type": "string"
          },
          "entries": {
            "description": "This page's items, each {\".tag\": \"file\"|\"folder\"|\"deleted\", name, path_lower, path_display, id}",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "description": "True when the folder holds more entries than this page returned. This connector cannot fetch them; see cursor",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "dropbox.access_token"
        ]
      ],
      "description": "Get metadata for a file or folder at a given path: its type, name, id, and — for a file — size and content hash. Does not return a folder's contents (use dropbox-folder-list) or a file's content (use dropbox-temporary-link-get). Direction remains conservatively authored as write pending individual review; POST is transport only and supplied no evidence",
      "direction": "write",
      "expose": true,
      "id": "dropbox-metadata-get",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The full path of the file or folder to inspect, from the account root. Unlike dropbox-folder-list, the account root itself (\"\") is not addressable this way — this path must name an existing file or folder",
          "name": "path",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/error_summary"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "path": {
              "$param": "path"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/2/files/get_metadata"
      },
      "response_schema": {
        "properties": {
          ".tag": {
            "description": "\"file\", \"folder\" or \"deleted\" — which fields below apply depends on this",
            "type": "string"
          },
          "client_modified": {
            "description": "File only: the modification time the uploading client claimed, not verified by Dropbox",
            "format": "date-time",
            "type": "string"
          },
          "content_hash": {
            "description": "File only: Dropbox's own content hash, for verifying a download performed some other way",
            "type": "string"
          },
          "id": {
            "description": "An opaque id stable across moves and renames",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path_display": {
            "type": "string"
          },
          "path_lower": {
            "type": "string"
          },
          "rev": {
            "description": "File only: an opaque revision id",
            "type": "string"
          },
          "server_modified": {
            "description": "File only: when Dropbox's server last saw this content change",
            "format": "date-time",
            "type": "string"
          },
          "size": {
            "description": "File only: size in bytes",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "dropbox.access_token"
        ]
      ],
      "description": "Search file and folder names across the account, returning the first page of matches. Dropbox matches on name, not file content. Direction remains conservatively authored as write pending individual review; POST is transport only and supplied no evidence",
      "direction": "write",
      "expose": true,
      "id": "dropbox-search",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The text to match against file and folder names",
