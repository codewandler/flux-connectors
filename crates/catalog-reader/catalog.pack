          "name": "source",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
