                        "type": "string"
                      },
                      "externalId": {
                        "description": "An optional ID that can also be used to retrieve the user.\n",
                        "example": "your-own-id",
                        "nullable": true,
                        "type": "string"
                      },
                      "id": {
                        "description": "The unique ID of the user.",
                        "example": "redacted-opaque",
                        "type": "string"
                      },
