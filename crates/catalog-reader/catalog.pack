{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Figma personal access token, sent as the whole value of X-Figma-Token. Grants read access to whatever files, projects and comments the token's account can see",
      "env": [
        "FIGMA_TOKEN"
      ],
      "name": "figma.token",
      "scheme": {
        "kind": "header",
        "name": "X-Figma-Token"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.figma.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.figma.token",
      "docs_url": "https://www.figma.com/developers/api",
      "format": "token",
      "help": "From your Figma account settings, under Personal access tokens. Figma shows it once, at creation time",
      "label": "Personal access token",
      "level": "connection",
      "name": "token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "figma",
  "default_auth": [
    [
      "figma.token"
    ]
  ],
  "description": "Figma REST API: read a file, specific nodes, rendered images, a project's files and a file's comments — a read-only design surface",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "figma.token"
        ]
      ],
      "description": "Get the authenticated user's id, email, display handle and avatar URL. Used to verify a token works before running anything else",
      "direction": "read",
      "expose": true,
      "id": "figma-user-me",
      "idempotency": "idempotent",
      "quirks": {
        "error_envelope": {
          "message_pointer": "/err"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/v1/me"
      },
      "response_schema": {
        "properties": {
          "email": {
            "description": "Personal data",
            "type": "string"
          },
          "handle": {
            "description": "The display name shown on comments and file activity",
            "type": "string"
          },
          "id": {
            "description": "The user's Figma id, an opaque string — not necessarily numeric",
            "type": "string"
          },
          "img_url": {
            "description": "URL of the user's avatar image",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "figma.token"
        ]
      ],
      "description": "Get a Figma file's document tree, components and styles by file key. Does not include comments or rendered images",
      "direction": "read",
      "expose": true,
      "id": "figma-file-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The file key from a Figma file URL — the segment after `/file/` or `/design/` and before the file's slug, e.g. `3xZfChRmL9Ykq4Qp2NHwR8` in `figma.com/design/3xZfChRmL9Ykq4Qp2NHwR8/My-File`",
          "name": "file_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/err"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/v1/files/{file_key}"
      },
      "response_schema": {
        "properties": {
          "components": {
            "description": "Reusable components defined in the file, keyed by node id. Each entry carries at least `key`, `name` and `description`",
            "type": "object"
          },
          "document": {
            "description": "The root node of the file's recursive node tree: a node with `id`, `name`, `type` and (for container types) a `children` array of more nodes. Not modeled further here — JSON Schema without recursion cannot describe it faithfully, and `figma-file-nodes-get` is how a caller reaches one node's own subtree by id instead of walking this one",
            "type": "object"
          },
          "editorType": {
            "description": "`figma` or `figjam`. A FigJam board's document tree uses different node types than a design file's",
            "type": "string"
          },
          "lastModified": {
            "description": "When the file was last modified, ISO 8601",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "The file's name as shown in Figma",
            "type": "string"
          },
          "role": {
            "description": "The calling user's own permission on this file, e.g. `owner`, `editor`, `viewer` — not a property of the file itself",
            "type": "string"
          },
          "styles": {
            "description": "Shared text, color, effect and grid styles defined in the file, keyed by node id",
            "type": "object"
          },
          "thumbnailUrl": {
            "description": "A preview image URL. Like the image-render endpoint's URLs, treat this as not guaranteed stable long-term rather than a permanent asset address",
            "type": "string"
          },
          "version": {
            "description": "An opaque version identifier Figma bumps on every save — not a semantic version",
            "type": "string"
          }
        },
        "required": [
          "document",
          "name",
          "lastModified",
          "version"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "figma.token"
        ]
      ],
      "description": "Get one or more specific nodes from a file by id, without walking the whole document tree. Use this to read a particular frame or layer instead of downloading the entire file",
      "direction": "read",
      "expose": true,
      "id": "figma-file-nodes-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The file key — see figma-file-get",
          "name": "file_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Comma-separated node ids to fetch, each in Figma's own `<page>:<node>` form, e.g. `1:23,1:45`. Copy these from a Figma share link (the `node-id` query parameter) or from a prior figma-file-get response",
          "name": "ids",
          "position": "query",
          "required": true,
          "schema": {
            "pattern": "^[0-9]+:[0-9]+(,[0-9]+:[0-9]+)*$",
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/err"
        }
      },
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "ids",
            "value": {
              "$param": "ids"
            }
          }
        ],
        "url": "{base}/v1/files/{file_key}/nodes"
      },
      "response_schema": {
        "properties": {
          "err": {
            "description": "Set when the whole request failed; absent otherwise. A per-node failure instead surfaces as that id being missing from `nodes`",
            "type": "string"
          },
          "lastModified": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "The file's name",
            "type": "string"
          },
          "nodes": {
            "description": "Keyed by the requested node id. Each present entry carries a `document` object — that node's own subtree, in the same opaque shape figma-file-get's `document` describes — plus that node's own `components` and `styles`. A requested id that does not exist in the file is simply absent from this object rather than an error",
            "type": "object"
          }
        },
        "required": [
          "nodes"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "figma.token"
        ]
      ],
      "description": "Render one or more nodes to images and return download URLs for them. The URLs point at short-lived storage and expire — Figma does not guarantee they stay valid, so fetch or store the image promptly rather than caching the URL itself",
      "direction": "read",
      "expose": true,
      "id": "figma-image-render-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The file key — see figma-file-get",
          "name": "file_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Comma-separated node ids to render, each in Figma's own `<page>:<node>` form, e.g. `1:23,1:45` — see figma-file-nodes-get",
          "name": "ids",
          "position": "query",
          "required": true,
          "schema": {
            "pattern": "^[0-9]+:[0-9]+(,[0-9]+:[0-9]+)*$",
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/err"
        }
      },
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "ids",
            "value": {
              "$param": "ids"
            }
          }
        ],
        "url": "{base}/v1/images/{file_key}"
      },
      "response_schema": {
        "properties": {
          "err": {
            "description": "Set when the whole request failed; absent otherwise",
            "type": "string"
          },
          "images": {
            "description": "Keyed by the requested node id. Each value is either a URL string or null (that particular node failed to render). Every URL here is temporary — it is served from short-lived storage and is not guaranteed to remain valid, so treat it as something to fetch immediately rather than an address to keep",
            "type": "object"
          }
        },
        "required": [
          "images"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "figma.token"
        ]
      ],
      "description": "List the files in a project: each file's key, name, thumbnail and last-modified time",
      "direction": "read",
      "expose": true,
      "id": "figma-project-files-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The project's numeric id, from a Figma project URL or from a team's project listing",
          "name": "project_id",
          "position": "path",
          "required": true,
          "schema": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/err"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/v1/projects/{project_id}/files"
      },
      "response_schema": {
        "properties": {
          "files": {
            "description": "One entry per file in the project, each `{key, name, thumbnail_url, last_modified}` and optionally `branches` when the file has any",
            "items": {
              "properties": {
                "key": {
                  "description": "The file key figma-file-get, figma-file-nodes-get, figma-image-render-get and figma-file-comments-list all take",
                  "type": "string"
                },
                "last_modified": {
                  "format": "date-time",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "thumbnail_url": {
                  "description": "Like other thumbnail URLs here, not guaranteed stable long-term",
                  "type": "string"
                }
              },
              "required": [
                "key",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "description": "The project's own name",
            "type": "string"
          }
        },
        "required": [
          "files"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "figma.token"
        ]
      ],
      "description": "List a file's comments: who wrote each one, when, its text, what it is attached to, and whether it has been resolved",
      "direction": "read",
      "expose": true,
      "id": "figma-file-comments-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The file key — see figma-file-get",
          "name": "file_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/err"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/v1/files/{file_key}/comments"
      },
      "response_schema": {
        "properties": {
          "comments": {
            "description": "Every comment on the file, oldest first",
            "items": {
              "properties": {
                "client_meta": {
                  "description": "Where the comment is pinned: either a canvas position or an offset within a frame, in one of two vendor-specific shapes. Not modeled further here",
                  "type": "object"
                },
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "file_key": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "message": {
                  "description": "The comment text. May quote or discuss design content and the commenter's own name is attached via `user` — treat both as data about a named individual",
                  "type": "string"
                },
                "order_id": {
                  "description": "Orders comments within their thread; not a public id anything else addresses",
                  "type": "string"
                },
                "parent_id": {
                  "description": "The id of the comment this replies to, or an empty string for a top-level comment — Figma uses an empty string here, not null",
                  "type": "string"
                },
                "resolved_at": {
                  "description": "When the comment was marked resolved, or absent while still open",
                  "format": "date-time",
                  "type": "string"
                },
                "user": {
                  "description": "Who wrote it: `{id, handle, img_url}` — the same shape figma-user-me returns for the caller",
                  "type": "object"
                }
              },
              "required": [
                "id",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "comments"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
