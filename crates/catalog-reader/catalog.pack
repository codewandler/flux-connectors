    {
      "auth": [
        [
          "confluence.api_token"
        ]
      ],
      "description": "Publish a new page in a space. The page is created live and visible to everyone who can see the space, is indexed for search, and notifies the space's watchers. It is created at the top level of the space unless the space's own structure places it otherwise, with no labels and no restrictions. Returns the new page's id, title and links. The content is sent as Confluence storage format — XHTML-like markup, e.g. `<p>text</p>` — not Markdown and not wiki markup",
      "direction": "write",
      "endpoint": {
        "site": [
          "host"
        ]
      },
      "expose": true,
      "id": "confluence-page-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "Id of the space to publish into, from `confluence-space-list`. The only field Confluence's schema strictly requires",
          "name": "space_id",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "spaceId"
        },
        {
          "description": "The page's title, as it will appear in the space and in search. Confluence requires titles to be unique within a space and rejects a duplicate with a `400`",
          "name": "title",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The page content, in **Confluence storage format**: XHTML-like markup such as `<p>A paragraph.</p><h2>A heading</h2><ul><li>An item</li></ul>`. Plain text is accepted and renders as a single unformatted run. Markdown is **not** converted — it would be stored and displayed literally, asterisks and all",
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "type": "string"
          },
          "wire": "body.value"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "body": {
              "representation": "storage",
              "value": {
                "$param": "body"
              }
            },
            "spaceId": {
              "$param": "space_id"
            },
            "status": "current",
            "title": {
              "$param": "title"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/v2/pages"
      },
      "response_schema": {
        "properties": {
          "_links": {
            "description": "`webui` is the new page's path in the Confluence UI and `base` is the site URL; join them to give a human the link to what was just published",
            "type": "object"
          },
          "authorId": {
            "description": "The account the token belongs to — a published page is attributed to it, and that name is what other people in the space will see",
            "type": "string"
          },
          "body": {
            "description": "Echoes the storage-format content that was sent, under `storage`. This is the one response in this connector that carries a page body — because it is the body the caller supplied, not one Confluence was asked to render",
            "type": "object"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The new page's id — the only handle on it, and what `confluence-comment-add` and `confluence-page-get` address it by afterwards",
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "parentId": {
            "description": "The page it was placed under, which Confluence resolves to the space's home page when none was requested",
            "type": "string"
          },
          "spaceId": {
            "description": "The space the page was published into",
            "type": "string"
          },
          "status": {
            "description": "`current` on a page this operation created",
            "type": "string"
          },
          "title": {
            "description": "Echoes the title that was sent",
            "type": "string"
          },
          "version": {
            "description": "`{number, createdAt, authorId, minorEdit, message}`, with `number` = 1 on a page just created",
            "properties": {
              "number": {
                "description": "1 on creation",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "confluence.api_token"
        ]
      ],
      "description": "Add a footer comment to a page — the comment thread at the bottom, not an inline annotation on selected text. The comment is visible to everyone who can see the page and notifies its watchers; it cannot be restricted to a subset of them. The content is sent as Confluence storage format (`<p>text</p>`), not Markdown. Note the page is named in the body rather than in the path, and that this connector cannot read a page's existing comments back",
      "direction": "write",
      "endpoint": {
        "site": [
          "host"
        ]
      },
      "expose": true,
      "id": "confluence-comment-add",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "Id of the page to comment on, from `confluence-space-pages` or `confluence-page-create`. This creates a top-level footer comment on that page; replying to an existing comment is not supported by this operation",
          "name": "page_id",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "pageId"
        },
        {
          "description": "The comment text, in **Confluence storage format**: XHTML-like markup such as `<p>A comment.</p>`. Plain text is accepted and renders unformatted. Markdown is **not** converted and would be displayed literally",
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "body.value"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "body": {
              "representation": "storage",
              "value": {
                "$param": "body"
              }
            },
            "pageId": {
              "$param": "page_id"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/v2/footer-comments"
      },
      "response_schema": {
        "properties": {
          "_links": {
            "description": "Carries `webui`, the comment's anchored path in the Confluence UI — it opens the page scrolled to this comment — and `base`, the site URL to resolve it against",
            "type": "object"
          },
          "body": {
            "description": "Echoes the storage-format content that was sent, under `storage`",
            "type": "object"
          },
          "id": {
            "description": "The new comment's id, as a string",
            "type": "string"
          },
          "pageId": {
            "description": "The page the comment was attached to — echoes what was sent, and worth checking, since the parent is chosen by which body field was present rather than by the path",
            "type": "string"
          },
          "parentCommentId": {
            "description": "Null on a top-level comment, which is all this operation creates",
            "type": "string"
          },
          "status": {
            "description": "`current` on a comment just created",
            "type": "string"
          },
          "title": {
            "description": "Confluence's own generated title for the comment, e.g. `Re: <page title>`. Not something the caller sets",
            "type": "string"
          },
          "version": {
            "description": "`{number, createdAt, authorId, minorEdit, message}`, with `number` = 1 on a comment just created",
            "properties": {
              "number": {
                "description": "1 on creation",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "v2",
      "base_url": "https://{site}.atlassian.net/wiki",
      "gid": "com.atlassian.confluence:v2",
      "name": "default",
      "tags": [
        "knowledge-base"
      ]
    }
  ],
  "vendor": "Confluence",
  "verify": "confluence-space-list"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Contentful Content Delivery API (CDA) access token, sent as a bearer. Read-only: published content in one space only, and only the Delivery API accepts it",
      "env": [
        "CONTENTFUL_DELIVERY_TOKEN"
      ],
      "name": "contentful.delivery_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    },
    {
      "description": "Contentful Content Management API (CMA) access token, sent as a bearer. Read and write in one space; the Delivery API rejects it. Required only for contentful-entry-create and contentful-entry-publish — every read above uses the Delivery token instead",
      "env": [
        "CONTENTFUL_MANAGEMENT_TOKEN"
      ],
      "name": "contentful.management_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.contentful.api",
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.space_id",
      "docs_url": "https://www.contentful.com/developers/docs/references/authentication/",
      "example": "a1b2c3d4e5f6",
      "format": "text",
      "help": "Found on the space's Settings > General settings page in the Contentful web app. Identifies which space the delivery token reads from",
      "label": "Contentful space ID",
      "level": "connection",
      "name": "delivery_space_id",
      "required": true,
      "secret": false,
      "service": "delivery"
    },
    {
      "approval": "none",
      "binds": "endpoint.environment_id",
      "docs_url": "https://www.contentful.com/developers/docs/concepts/multiple-environments/",
      "example": "master",
      "format": "text",
      "help": "The environment within the space to read from — commonly `master` unless this space uses staged environments",
      "label": "Contentful environment",
      "level": "connection",
      "name": "delivery_environment_id",
      "required": true,
      "secret": false,
      "service": "delivery"
    },
    {
      "approval": "none",
      "binds": "credential.contentful.delivery_token",
      "docs_url": "https://www.contentful.com/developers/docs/references/authentication/",
      "format": "token",
      "help": "Create a Content Delivery API access token in the space under Settings > API keys. Read-only: published content in this space only",
      "label": "Contentful Delivery API token",
      "level": "connection",
      "name": "delivery_token",
      "required": true,
      "secret": true,
      "service": "delivery"
    },
    {
      "approval": "none",
      "binds": "endpoint.space_id",
      "docs_url": "https://www.contentful.com/developers/docs/references/content-management-api/",
      "example": "a1b2c3d4e5f6",
      "format": "text",
      "help": "Found on the space's Settings > General settings page in the Contentful web app. Identifies which space the management token writes to",
      "label": "Contentful space ID",
      "level": "connection",
      "name": "management_space_id",
      "required": true,
      "secret": false,
      "service": "management"
    },
    {
      "approval": "none",
      "binds": "endpoint.environment_id",
      "docs_url": "https://www.contentful.com/developers/docs/concepts/multiple-environments/",
      "example": "master",
      "format": "text",
      "help": "The environment within the space to write to — commonly `master` unless this space uses staged environments",
      "label": "Contentful environment",
      "level": "connection",
      "name": "management_environment_id",
      "required": true,
      "secret": false,
      "service": "management"
    },
    {
      "approval": "none",
      "binds": "credential.contentful.management_token",
      "docs_url": "https://www.contentful.com/developers/docs/references/content-management-api/",
      "format": "token",
      "help": "Create a Content Management API token (a Personal Access Token) in the space under Settings > API keys > Content management tokens. Grants create and publish access in this space — never reuse the Delivery token here",
      "label": "Contentful Management API token",
      "level": "connection",
      "name": "management_token",
      "required": true,
      "secret": true,
      "service": "management"
    }
  ],
  "connector": "contentful",
  "default_auth": [
    [
      "contentful.delivery_token"
    ]
  ],
  "description": "Contentful headless CMS: read published content from the Content Delivery API, and create and publish entries through the Content Management API — two different hosts and two different tokens for one vendor",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "contentful.delivery_token"
        ]
      ],
      "description": "Get one published entry by id, with its fields resolved to one locale",
      "direction": "read",
      "endpoint": {
        "environment_id": [
          "path"
        ],
        "space_id": [
          "path"
        ]
      },
      "expose": true,
      "id": "contentful-entry-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The entry's id, from contentful-entries-list or the Contentful web app",
