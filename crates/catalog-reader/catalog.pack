          "sys": {
            "description": "At least `id` (the new entry's id, for contentful-entry-publish), `type` (\"Entry\"), `version` (the optimistic-concurrency stamp contentful-entry-publish's `X-Contentful-Version` header needs), `createdAt`, `updatedAt`",
            "properties": {
