{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "New Relic User API key, authorizing REST v2 calls as the New Relic user it was created by. Travels as the `X-Api-Key` header on every request. A key is issued in one region and is not valid against the other region's host — a 401 from this connector is as likely to be a wrong `host` as a wrong key",
      "env": [
        "NEW_RELIC_API_KEY"
      ],
      "name": "newrelic.api_key",
      "scheme": {
        "kind": "header",
        "name": "X-Api-Key"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.newrelic.api",
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.host",
      "choices": [
        {
          "label": "United States",
          "value": "api.newrelic.com"
        },
        {
          "label": "European Union",
          "value": "api.eu.newrelic.com"
        }
      ],
      "docs_url": "https://docs.newrelic.com/docs/apis/rest-api-v2/get-started/introduction-new-relic-rest-api-v2/",
      "example": "api.newrelic.com",
      "format": "hostname",
      "help": "Which region this New Relic account lives in. Pick United States for an account on api.newrelic.com or European Union for one on api.eu.newrelic.com — those are the only two, and an account is in exactly one of them from the day it was created. If you are not sure, look at the URL you log in at: one.newrelic.com is the US region and one.eu.newrelic.com is the EU region. Getting this wrong returns 401 on every call, exactly as a bad key would, so check it before you rotate anything",
      "label": "New Relic API host",
      "level": "connection",
      "name": "host",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.newrelic.api_key",
      "docs_url": "https://docs.newrelic.com/docs/apis/intro-apis/new-relic-api-keys/",
      "format": "token",
      "help": "A User API key from New Relic's API keys page (one.newrelic.com, Administration -> API keys). Create a User key, not a License or Ingest key — a License key does not authenticate REST v2 and returns 401. The key inherits the permissions of the New Relic user it was created by",
      "label": "New Relic User API key",
      "level": "connection",
      "name": "api_key",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "newrelic",
  "default_auth": [
    [
      "newrelic.api_key"
    ]
  ],
  "description": "New Relic APM and alerting over the REST v2 API: list the applications an account is monitoring and read one in detail, read the account's alert policies and its current violations, and list or record deployment markers against an application. The account's region host is configured once, not chosen per call",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "newrelic.api_key"
        ]
      ],
      "description": "List every application this account is monitoring with APM, each with its current health status and a summary of its response time, throughput and error rate. Takes no argument. Also this connector's `verify`: a bounded read that runs unattended and needs nothing beyond the configured host and key",
      "direction": "read",
      "endpoint": {
        "host": [
          "host"
        ]
      },
      "expose": true,
      "id": "newrelic-application-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/applications.json"
      },
      "response_schema": {
        "properties": {
          "applications": {
            "description": "Every application the account monitors. An account with no APM agents reporting returns an empty array, not an error",
            "items": {
              "properties": {
                "application_summary": {
                  "description": "The APM rollup for the last few minutes: `response_time` (ms), `throughput` (requests per minute), `error_rate` (percent), `apdex_target`, `apdex_score`, `host_count`, `instance_count`, `concurrency`. Absent on an application that is not reporting",
                  "type": "object"
                },
                "end_user_summary": {
                  "description": "The browser-side rollup, where browser monitoring is enabled: `response_time`, `throughput`, `apdex_target`, `apdex_score`",
                  "type": "object"
                },
                "health_status": {
                  "description": "New Relic's rollup of the application's alert state: `green`, `yellow`, `red`, `gray` (nothing reporting) or `unknown`. This is the field to read to answer \"is anything wrong\"",
                  "type": "string"
                },
                "id": {
                  "description": "The application's id — what newrelic-application-get and the deployment operations address it by. An integer, not a string",
                  "type": "integer"
                },
                "language": {
                  "description": "The agent's language — `ruby`, `java`, `nodejs` and so on",
                  "type": "string"
                },
                "last_reported_at": {
                  "description": "When the agent last reported, as an ISO 8601 timestamp",
                  "type": "string"
                },
                "links": {
                  "description": "Related ids New Relic returns alongside — the alert policy, the application's hosts and instances. Ids only, not embedded objects",
                  "type": "object"
                },
                "name": {
                  "description": "The application name the agent reports under, as it reads in New Relic's UI",
                  "type": "string"
                },
                "reporting": {
                  "description": "Whether an agent has sent data recently. FALSE MEANS THE APPLICATION IS NOT SENDING DATA — its summary figures are stale, not zero",
                  "type": "boolean"
                },
                "settings": {
                  "description": "The application's Apdex thresholds and monitoring switches. Left untyped rather than enumerated; see New Relic's own Application object reference",
                  "type": "object"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "applications"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
