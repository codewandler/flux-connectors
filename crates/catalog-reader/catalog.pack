      "description": "Incrementally export users updated at or after a required Unix start time with an optional integer page size",
      "direction": "read",
      "endpoint": {
        "subdomain": [
          "host"
        ]
      },
      "expose": true,
      "id": "zendesk-incremental-user-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The time to start the incremental export from. Must be at least one minute in the past. Data isn't provided for the most recent minute",
          "name": "start_time",
          "position": "query",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "description": "The number of records to return per page",
          "name": "per_page",
          "position": "query",
          "required": false,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "request": {
