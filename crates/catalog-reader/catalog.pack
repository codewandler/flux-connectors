        ]
      ],
      "description": "List the contacts in an audience, subscribed and unsubscribed alike. Returns Mailchimp's default first page only — this connector declares no paging or status filter, so compare the number of entries against `total_items` before treating the result as complete. Every entry is personal data",
      "direction": "read",
      "endpoint": {
        "dc": [
          "host"
        ]
      },
      "expose": true,
      "id": "mailchimp-audience-member-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The audience id, from mailchimp-audience-list's `id`",
          "name": "list_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/lists/{list_id}/members"
      },
      "response_schema": {
        "properties": {
          "list_id": {
            "description": "The audience that was read",
            "type": "string"
          },
          "members": {
            "description": "The contacts on this page. Personal data: addresses, names and signup IPs",
            "items": {
              "properties": {
                "contact_id": {
                  "description": "Mailchimp's newer per-contact identifier",
                  "type": "string"
                },
                "email_address": {
                  "description": "The contact's address. Personal data",
                  "type": "string"
                },
                "email_type": {
                  "description": "`html` or `text`",
                  "type": "string"
                },
                "full_name": {
                  "description": "The contact's name, if the account collects one. Personal data",
                  "type": "string"
                },
                "id": {
                  "description": "The MD5 hash of the lowercase email address — this is the `subscriber_hash` the contact operations take, so a caller that has read a contact never has to compute one",
                  "type": "string"
                },
                "interests": {
                  "description": "Interest-group membership, keyed by group id. Left untyped rather than enumerated",
                  "type": "object"
                },
                "ip_opt": {
                  "description": "The IP the contact confirmed opt-in from. Personal data",
                  "type": "string"
                },
                "ip_signup": {
                  "description": "The IP the contact signed up from. Personal data; read it only if the flow genuinely needs it",
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "last_changed": {
                  "description": "When this contact record last changed",
                  "type": "string"
                },
                "list_id": {
                  "description": "The audience this contact belongs to",
                  "type": "string"
                },
                "location": {
                  "description": "Approximate latitude, longitude and timezone. Left untyped rather than enumerated",
                  "type": "object"
                },
                "member_rating": {
                  "description": "Mailchimp's 1-5 engagement rating for this contact",
                  "type": "integer"
                },
                "merge_fields": {
                  "description": "The account's own merge tags and their values — FNAME, LNAME and whatever else the operator configured. Account-defined, so left untyped rather than enumerated. Frequently personal data",
                  "type": "object"
                },
                "stats": {
                  "description": "Open and click rates for this contact. Left untyped rather than enumerated",
                  "type": "object"
                },
                "status": {
                  "description": "`subscribed`, `unsubscribed`, `cleaned`, `pending`, `transactional` or `archived`. `cleaned` means Mailchimp stopped sending after hard bounces",
                  "type": "string"
                },
                "tags": {
                  "description": "The tags applied to this contact. Left untyped rather than enumerated",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "timestamp_opt": {
                  "description": "When the contact confirmed opt-in — the record that a double opt-in happened",
                  "type": "string"
                },
                "timestamp_signup": {
                  "type": "string"
                },
                "unique_email_id": {
                  "description": "A stable id for the address across the account",
                  "type": "string"
                },
                "vip": {
                  "type": "boolean"
                },
                "web_id": {
                  "description": "The id in Mailchimp's own web UI",
                  "type": "integer"
                }
              },
              "required": [
