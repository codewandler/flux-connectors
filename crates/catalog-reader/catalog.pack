          "position": "path",
          "required": true,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "The comment text, as Markdown. Bitbucket renders it and returns the rendered HTML alongside the raw text",
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
