    {
      "auth": [
        [
          "klaviyo.api_key"
        ]
      ],
      "description": "Create a customer profile. At least one identifier is required — email, phone number or external id — and Klaviyo answers 409 Conflict if a profile with that identifier already exists, so this creates and never updates. The created profile can be marketed to only once it is subscribed, which this connector does not do",
      "direction": "write",
      "expose": true,
      "id": "klaviyo-profile-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The profile's email address. Not required by Klaviyo on its own, but at least one of email, phone_number or external_id must be supplied or the call is rejected. Personal data about a named individual",
          "name": "email",
          "position": "body",
          "required": false,
          "schema": {
            "format": "email",
            "type": "string"
          },
          "wire": "data.attributes.email"
        },
        {
          "description": "Phone number in E.164 form, e.g. +15005550006. Klaviyo rejects other formats. Counts as an identifier",
          "name": "phone_number",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.phone_number"
        },
        {
          "description": "The id this person carries in the calling system — an order-system customer id, say. Counts as an identifier, and is the one that lets a later call find this profile without holding an email address",
          "name": "external_id",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.external_id"
        },
        {
          "description": "Given name, as it should appear in a message greeting",
          "name": "first_name",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.first_name"
        },
        {
          "description": "Family name",
          "name": "last_name",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.last_name"
        },
        {
          "description": "The company this person belongs to",
          "name": "organization",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.organization"
        },
        {
          "description": "Job title",
          "name": "title",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.title"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "data": {
              "attributes": {
                "email": {
                  "$param": "email"
                },
                "external_id": {
                  "$param": "external_id"
                },
                "first_name": {
                  "$param": "first_name"
                },
                "last_name": {
                  "$param": "last_name"
                },
                "organization": {
                  "$param": "organization"
                },
                "phone_number": {
                  "$param": "phone_number"
                },
                "title": {
                  "$param": "title"
                }
              },
              "type": "profile"
            }
          }
        },
        "headers": {
          "content-type": "application/json",
          "revision": "2026-07-15"
        },
        "method": "POST",
        "url": "{base}/profiles"
      },
      "response_schema": {
        "properties": {
          "data": {
            "properties": {
              "attributes": {
                "properties": {
                  "created": {
                    "description": "When Klaviyo created the profile, in UTC",
                    "format": "date-time",
                    "type": "string"
                  },
                  "email": {
                    "description": "Echoes the address that was sent",
                    "format": "email",
                    "type": "string"
                  },
                  "external_id": {
                    "type": "string"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_event_date": {
                    "description": "Null on a profile just created: it has done nothing yet",
                    "format": "date-time",
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "locale": {
                    "type": "string"
                  },
                  "location": {
                    "description": "Empty on a profile created by this operation, which sends no location",
                    "type": "object"
                  },
                  "organization": {
                    "type": "string"
                  },
                  "phone_number": {
                    "type": "string"
                  },
                  "properties": {
                    "description": "Empty unless the account has default properties",
                    "type": "object"
                  },
                  "subscriptions": {
                    "description": "**Not subscribed.** Creating a profile grants no marketing consent; the subscription endpoints this connector does not ship are what change this",
                    "type": "object"
                  },
                  "title": {
                    "type": "string"
                  },
                  "updated": {
                    "format": "date-time",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "id": {
                "description": "The created profile's id — what klaviyo-profile-get reads back, and the only handle on it",
                "type": "string"
              },
              "links": {
                "type": "object"
              },
              "relationships": {
                "type": "object"
              },
              "type": {
                "const": "profile"
              }
            },
            "required": [
              "type",
              "id",
              "attributes"
            ],
            "type": "object"
          },
          "links": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "klaviyo.api_key"
        ]
      ],
      "description": "List the account's lists — static, opt-in collections of profiles, as opposed to segments, which are live queries and are not shipped here. Returns the FIRST PAGE ONLY; Klaviyo's `page[cursor]` query parameter cannot be sent by this connector. Returns the lists themselves, not their members",
      "direction": "read",
      "expose": true,
      "id": "klaviyo-list-list",
      "idempotency": "idempotent",
      "request": {
        "headers": {
          "revision": "2026-07-15"
        },
        "method": "GET",
        "url": "{base}/lists"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "One entry per list, first page only",
            "items": {
              "properties": {
                "attributes": {
                  "properties": {
                    "created": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "name": {
                      "description": "The list's name, as the account's marketers see it",
                      "type": "string"
                    },
                    "opt_in_process": {
                      "description": "How a profile joins: `single_opt_in`, or `double_opt_in` where Klaviyo sends a confirmation message first. A flow that adds members has to respect this, and this connector does not add members",
                      "type": "string"
                    },
                    "updated": {
                      "format": "date-time",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                },
                "id": {
                  "description": "The list's id, a six-character code. This is what Klaviyo's own UI shows in a list URL",
                  "type": "string"
                },
                "links": {
                  "type": "object"
                },
                "relationships": {
                  "description": "Relationship links for `profiles`, `tags` and `flow-triggers`. Links only — nothing is expanded, and the profiles endpoint behind the first is deliberately not shipped",
                  "type": "object"
                },
                "type": {
                  "const": "list"
                }
              },
              "required": [
                "type",
                "id",
                "attributes"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "links": {
            "description": "`self`, plus `next`/`prev` when more pages exist. `next` is unusable here (C-30)",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "klaviyo.api_key"
        ]
      ],
      "description": "Post an event about a customer — a purchase, a page view, anything the account measures. THIS CAN CAUSE A MESSAGE TO BE SENT: an event triggers any Klaviyo flow built on its metric, so an email or SMS may reach the named profile immediately. Klaviyo creates the metric and the profile on first use if they do not exist. Answers 202 Accepted with no body: the event is queued, not confirmed. Pass unique_id to make a retry safe — Klaviyo records only the first event with a given unique_id for the same profile and metric",
      "direction": "write",
      "expose": true,
      "id": "klaviyo-event-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "What happened, as the account's marketers name it — `Placed Order`, `Viewed Product`. Klaviyo creates the metric on first use, so a typo silently creates a second metric nobody has built a flow on rather than failing",
          "name": "metric_name",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "data.attributes.metric.data.attributes.name"
        },
        {
          "description": "The email address of the person this event is about. Klaviyo matches an existing profile on it and creates one if there is none, so an address typed wrongly creates a new profile rather than failing. Personal data",
          "name": "profile_email",
          "position": "body",
          "required": true,
          "schema": {
            "format": "email",
            "type": "string"
          },
          "wire": "data.attributes.profile.data.attributes.email"
        },
        {
          "description": "The event's own detail, as a JSON object — order id, product names, values. Keys are whatever the account's flows and reports expect; Klaviyo imposes no shape. Pass an empty object when there is nothing to say",
          "name": "properties",
          "position": "body",
          "required": true,
          "schema": {
            "type": "object"
          },
          "wire": "data.attributes.properties"
        },
        {
          "description": "The monetary value of the event, as a number, for revenue reporting. Omit it on an event that is not worth money",
          "name": "value",
          "position": "body",
          "required": false,
          "schema": {
            "type": "number"
          },
          "wire": "data.attributes.value"
        },
        {
          "description": "ISO 4217 code for `value`, e.g. EUR. Klaviyo converts to the account's preferred currency; omitting it means the account's own currency is assumed",
          "name": "value_currency",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.value_currency"
        },
        {
          "description": "A caller-chosen id that makes this event's delivery safe to retry: Klaviyo records only the first event with a given unique_id for the same profile and metric. Omitting it means a retry posts a second event and may trigger a second message",
          "name": "unique_id",
          "position": "body",
          "required": false,
          "schema": {
            "type": "string"
          },
          "wire": "data.attributes.unique_id"
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "data": {
              "attributes": {
                "metric": {
                  "data": {
                    "attributes": {
                      "name": {
                        "$param": "metric_name"
                      }
                    },
                    "type": "metric"
                  }
                },
                "profile": {
                  "data": {
                    "attributes": {
                      "email": {
                        "$param": "profile_email"
                      }
                    },
                    "type": "profile"
                  }
                },
                "properties": {
                  "$param": "properties"
                },
                "unique_id": {
                  "$param": "unique_id"
                },
                "value": {
                  "$param": "value"
                },
                "value_currency": {
                  "$param": "value_currency"
                }
              },
              "type": "event"
            }
          }
        },
        "headers": {
          "content-type": "application/json",
          "revision": "2026-07-15"
        },
        "method": "POST",
        "url": "{base}/events"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "base_url": "https://a.klaviyo.com/api",
      "name": "default",
      "tags": [
        "marketing"
      ]
    }
  ],
  "vendor": "Klaviyo",
  "verify": "klaviyo-account-list"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "LaunchDarkly API access token, sent as the entire value of the Authorization header with no scheme word in front of it — LaunchDarkly rejects a `Bearer `-prefixed value",
      "env": [
        "LAUNCHDARKLY_API_TOKEN"
      ],
      "name": "launchdarkly.api_token",
      "scheme": {
        "kind": "header",
        "name": "Authorization"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.launchdarkly.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.launchdarkly.api_token",
      "docs_url": "https://docs.launchdarkly.com/home/account/api",
      "format": "token",
      "help": "Create one under Account settings → Authorization → Access tokens in LaunchDarkly. Give it at least reader access to the projects this connection should reach, and writer access if launchdarkly-flag-toggle will be used. LaunchDarkly shows the token once",
      "label": "LaunchDarkly API access token",
      "level": "connection",
      "name": "api_token",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "launchdarkly",
  "default_auth": [
    [
      "launchdarkly.api_token"
    ]
  ],
  "description": "LaunchDarkly feature management: read projects, environments and feature flags, and toggle a flag on or off in one environment",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "launchdarkly.api_token"
        ]
      ],
      "description": "List every project in the LaunchDarkly account. A project is the top-level grouping that owns environments and feature flags",
      "direction": "read",
      "expose": true,
      "id": "launchdarkly-project-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Maximum number of projects to return per page",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Number of projects to skip, for paging past the first page",
          "name": "offset",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          },
          {
            "name": "offset",
            "value": {
              "$param": "offset"
            }
          }
        ],
        "url": "{base}/projects"
      },
      "response_schema": {
        "properties": {
          "items": {
            "description": "The account's projects",
            "items": {
              "properties": {
                "environments": {
                  "description": "A summary of this project's environments; use launchdarkly-environment-list for the full per-environment representation",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "key": {
                  "description": "The project's own key — pass this as `project_key` to the other operations below",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "tags": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "key",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "totalCount": {
            "description": "Total projects in the account, which may exceed `items.length` on one page",
            "type": "integer"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "launchdarkly.api_token"
        ]
      ],
      "description": "List the environments (e.g. production, staging) that belong to one project",
      "direction": "read",
      "expose": true,
      "id": "launchdarkly-environment-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The project's own key, from launchdarkly-project-list's `key` field",
          "name": "project_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Maximum number of environments to return per page",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Number of environments to skip, for paging past the first page",
          "name": "offset",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          },
          {
            "name": "offset",
            "value": {
              "$param": "offset"
            }
          }
        ],
        "url": "{base}/projects/{project_key}/environments"
      },
      "response_schema": {
        "properties": {
          "items": {
            "description": "The project's environments",
            "items": {
              "properties": {
                "color": {
                  "description": "Hex color LaunchDarkly's UI displays this environment in",
                  "type": "string"
                },
                "confirmChanges": {
                  "type": "boolean"
                },
                "defaultTrackEvents": {
                  "type": "boolean"
                },
                "defaultTtl": {
                  "type": "integer"
                },
                "key": {
                  "description": "This environment's own key, e.g. `production` — pass this as the `<environment_key>` inside launchdarkly-flag-toggle's JSON Patch path",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "requireComments": {
                  "type": "boolean"
                },
                "secureMode": {
                  "type": "boolean"
                },
                "tags": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "key",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "totalCount": {
            "type": "integer"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "launchdarkly.api_token"
        ]
      ],
      "description": "List the feature flags defined in one project",
      "direction": "read",
      "expose": true,
      "id": "launchdarkly-flag-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The project's own key, from launchdarkly-project-list's `key` field",
          "name": "project_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Restrict each returned flag's environment-specific fields (targeting, on/off state) to this one environment's key, e.g. `production`. Omit to receive every environment's representation",
          "name": "env",
          "position": "query",
          "required": false,
          "schema": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          }
        },
        {
          "description": "Maximum number of flags to return per page",
          "name": "limit",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Number of flags to skip, for paging past the first page",
          "name": "offset",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "env",
            "value": {
              "$param": "env"
            }
          },
          {
            "name": "limit",
            "value": {
              "$param": "limit"
            }
          },
          {
            "name": "offset",
            "value": {
              "$param": "offset"
            }
          }
        ],
        "url": "{base}/flags/{project_key}"
      },
      "response_schema": {
        "properties": {
          "items": {
            "description": "The project's feature flags",
            "items": {
              "properties": {
                "description": {
                  "type": "string"
                },
                "environments": {
                  "description": "Keyed by environment key (e.g. \"production\"); each value carries at least an `on` boolean plus targeting rules, prerequisites and a fallthrough variation this curated connector does not enumerate further — read `on` and pass the object through rather than assuming any deeper shape",
                  "type": "object"
                },
