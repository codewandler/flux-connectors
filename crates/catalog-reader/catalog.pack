              "$param": "channel"
            },
            "name": {
              "$param": "name"
            },
            "timestamp": {
              "$param": "timestamp"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/reactions.add"
      },
      "response_schema": {
        "properties": {
          "error": {
            "description": "Present only when `ok` is false, with HTTP still 200: `already_reacted`, `message_not_found`, `invalid_name`, `channel_not_found` or `thread_locked`",
            "type": "string"
          },
          "ok": {
            "description": "True when the reaction was added. There is no other member on success — Slack returns no id for a reaction",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    }
