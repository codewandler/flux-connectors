{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Asana access token sent as a bearer — a personal access token or an OAuth-issued one",
      "env": [
        "ASANA_ACCESS_TOKEN"
      ],
      "name": "asana.access_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.asana.api",
  "connector": "asana",
  "default_auth": [
    [
      "asana.access_token"
    ]
  ],
  "description": "Asana work management: read tasks and projects, create and update tasks, comment on a task",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "asana.access_token"
        ]
      ],
      "description": "Get one task — its name, notes, assignee, due date, completion state and the projects it belongs to. The task is under `data` in the response",
      "direction": "read",
      "expose": true,
      "id": "asana-task-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The task's `gid`, a decimal string such as `1201234567890123`. It is not the number in the task's web URL for a subtask",
          "name": "task_gid",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/api/1.0/tasks/{task_gid}"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "The task resource, in Asana's default field set. Individual fields are not enumerated here — recording the envelope is what a consumer cannot infer; the resource's own shape is in Asana's reference",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "asana.access_token"
        ]
      ],
      "description": "Create a task in a workspace. It is created unassigned and in no project, so nobody is notified; move it or assign it in Asana afterwards. The created task is under `data` in the response",
      "direction": "write",
      "expose": true,
      "id": "asana-task-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The task's name, as it appears in a task list",
          "name": "name",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "data.name"
        },
        {
          "description": "The `gid` of the workspace to create the task in. A task's workspace is permanent — it cannot be changed after creation",
          "name": "workspace",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "wire": "data.workspace"
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "data": {
              "name": {
                "$param": "name"
              },
              "workspace": {
                "$param": "workspace"
              }
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/1.0/tasks"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "The created task, in Asana's default field set. Its `gid` is what later calls address it by",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "asana.access_token"
        ]
      ],
      "description": "Mark a task complete or incomplete. Asana's update is sparse: only completion changes, and every other field of the task is left as it was. The updated task is under `data` in the response",
      "direction": "write",
      "expose": true,
      "id": "asana-task-update",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The `gid` of the task to update",
          "name": "task_gid",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        },
        {
          "description": "True to complete the task, false to re-open it. Completing a task also completes nothing else — subtasks stay as they are",
          "name": "completed",
          "position": "body",
          "required": true,
          "schema": {
            "type": "boolean"
          },
          "wire": "data.completed"
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "data": {
              "completed": {
                "$param": "completed"
              }
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PUT",
        "url": "{base}/api/1.0/tasks/{task_gid}"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "The task as it stands after the update, in Asana's default field set",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "asana.access_token"
        ]
      ],
      "description": "Add a comment to a task. Asana calls a comment a story. It is attributed to the token's owner, notifies every follower of the task by email and in-app, and cannot be un-sent. The created story is under `data` in the response",
      "direction": "write",
      "expose": true,
      "id": "asana-task-story-add",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The `gid` of the task to comment on",
          "name": "task_gid",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        },
        {
          "description": "The comment text, as plain text. Asana renders `@` mentions only in the `html_text` form, which this operation does not send",
          "name": "text",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          },
          "wire": "data.text"
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "data": {
              "text": {
                "$param": "text"
              }
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/1.0/tasks/{task_gid}/stories"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "The created story: its `gid`, `created_at`, `created_by` and `text`",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "asana.access_token"
        ]
      ],
      "description": "Get one project — its name, notes, owner, team, current status and whether it is archived. The project is under `data` in the response",
      "direction": "read",
      "expose": true,
      "id": "asana-project-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The project's `gid`, a decimal string. It is the number in the project's web URL",
          "name": "project_gid",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/errors/0/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/api/1.0/projects/{project_gid}"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "The project resource, in Asana's default field set",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "1.0",
      "base_url": "https://app.asana.com",
      "gid": "com.asana.api:1.0",
      "name": "default",
      "tags": [
        "project-management"
      ]
    }
  ],
  "vendor": "Asana"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Asterisk ARI Basic authentication password, paired with the deployment's ARI username",
      "env": [
        "ASTERISK_ARI_PASSWORD"
      ],
      "name": "asterisk.password",
      "scheme": {
        "kind": "basic"
      },
      "subject": "unstated",
      "user_env": [
        "ASTERISK_ARI_USERNAME"
      ]
    }
  ],
  "authority": "org.asterisk.ari",
  "channels": [
    {
      "connect": {
        "auth": [
          {
            "credentials": [
              "asterisk.password"
            ]
          }
        ],
        "path": "/events",
        "query": {
          "app": "{app}",
          "subscribeAll": "{subscribe_all}"
        }
      },
      "description": "Receive the complete stream of events for an ARI Stasis application",
      "discriminator": {
        "name": "type",
        "source": "body"
      },
      "events": [
        "device-state-changed",
        "playback-started",
        "playback-continuing",
        "playback-finished",
        "recording-started",
        "recording-finished",
        "recording-failed",
        "application-move-failed",
        "application-registered",
        "application-unregistered",
        "application-replaced",
        "bridge-created",
        "bridge-destroyed",
        "bridge-merged",
        "bridge-blind-transfer",
        "bridge-attended-transfer",
        "bridge-video-source-changed",
        "channel-created",
        "channel-destroyed",
        "channel-entered-bridge",
        "channel-left-bridge",
        "channel-state-change",
        "channel-dtmf-received",
        "channel-dialplan",
        "channel-caller-id",
        "channel-userevent",
        "channel-hangup-request",
        "channel-varset",
        "channel-tone-detected",
        "channel-talking-started",
        "channel-talking-finished",
        "channel-hold",
        "channel-unhold",
        "contact-status-change",
        "endpoint-state-change",
        "dial",
        "stasis-end",
        "stasis-start",
        "text-message-received",
        "channel-connected-line",
        "peer-status-change",
        "channel-transfer",
        "rest-response",
        "call-broadcast",
        "call-claimed"
      ],
      "name": "ari-events",
      "oip": "org.asterisk.ari:22.10.1#ari-events",
      "payload_root": true,
      "service": "default",
      "transport": "socket",
      "verification": {
        "kind": "connection",
        "verified": true
      }
    }
  ],
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.host",
      "example": "pbx.example.com",
      "format": "text",
      "help": "The hostname of the TLS-enabled Asterisk HTTP service without a scheme, port, or `/ari`",
      "label": "Asterisk host",
      "level": "connection",
      "name": "host",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "username.asterisk.password",
      "example": "flux",
      "format": "text",
      "help": "The username configured for ARI in Asterisk's `ari.conf`",
      "label": "ARI username",
      "level": "connection",
      "name": "username",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.asterisk.password",
      "format": "token",
      "help": "The password configured beside the ARI username in Asterisk's `ari.conf`",
      "label": "ARI password",
      "level": "connection",
      "name": "password",
      "required": true,
      "secret": true,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "channel.ari-events.query.app",
      "example": "flux",
      "format": "text",
      "help": "The ARI Stasis application whose events this connection receives",
      "label": "Stasis application",
      "level": "connection",
      "name": "app",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "channel.ari-events.query.subscribeAll",
      "default": "false",
      "example": "false",
      "format": "text",
      "help": "Whether ARI should deliver events for every application instead of only the named Stasis application",
      "label": "Subscribe to all applications",
      "level": "connection",
      "name": "subscribe_all",
      "required": false,
      "secret": false,
      "service": "default"
    }
  ],
  "connector": "asterisk",
  "default_auth": [
    [
      "asterisk.password"
    ]
  ],
  "description": "Control an Asterisk deployment through the complete ARI REST surface: applications, system configuration, bridges, channels, endpoints, mailboxes, playback, recordings, sounds, and outbound user events",
  "events": [
    {
      "default": true,
      "description": "Notification that a device state has changed.",
      "name": "device-state-changed",
      "oip": "org.asterisk.ari:22.10.1#device-state-changed",
      "schema": {
        "description": "Notification that a device state has changed.",
        "properties": {
          "application": {
            "description": "Name of the application receiving the event.",
            "type": "string"
          },
          "asterisk_id": {
            "description": "The unique ID for the Asterisk instance that raised this event.",
            "type": "string"
          },
          "device_state": {
            "description": "Device state object",
            "properties": {
              "name": {
                "description": "Name of the device.",
                "type": "string"
              },
              "state": {
                "description": "Device's state",
                "enum": [
                  "UNKNOWN",
                  "NOT_INUSE",
                  "INUSE",
                  "BUSY",
                  "INVALID",
                  "UNAVAILABLE",
                  "RINGING",
                  "RINGINUSE",
                  "ONHOLD"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "state"
            ],
            "type": "object"
          },
          "timestamp": {
            "description": "Time at which this event was created.",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "const": "DeviceStateChanged"
          }
        },
        "required": [
          "type",
          "application",
          "timestamp",
          "device_state"
        ],
        "type": "object"
      },
      "service": "default",
      "wire_value": "DeviceStateChanged"
    },
    {
      "default": true,
      "description": "Event showing the start of a media playback operation.",
      "name": "playback-started",
      "oip": "org.asterisk.ari:22.10.1#playback-started",
      "schema": {
        "description": "Event showing the start of a media playback operation.",
        "properties": {
          "application": {
            "description": "Name of the application receiving the event.",
            "type": "string"
          },
          "asterisk_id": {
            "description": "The unique ID for the Asterisk instance that raised this event.",
            "type": "string"
          },
          "playback": {
            "description": "Playback control object",
            "properties": {
              "id": {
                "description": "ID for this playback operation",
                "type": "string"
              },
              "language": {
                "description": "For media types that support multiple languages, the language requested for playback.",
                "type": "string"
              },
              "media_uri": {
                "description": "The URI for the media currently being played back.",
                "type": "string"
              },
              "next_media_uri": {
                "description": "If a list of URIs is being played, the next media URI to be played back.",
                "type": "string"
              },
              "state": {
                "description": "Current state of the playback operation.",
                "enum": [
                  "queued",
                  "playing",
                  "continuing",
                  "done",
                  "failed"
                ],
                "type": "string"
              },
              "target_uri": {
                "description": "URI for the channel or bridge to play the media on",
                "type": "string"
              }
            },
            "required": [
              "id",
              "media_uri",
              "state",
              "target_uri"
            ],
            "type": "object"
          },
          "timestamp": {
            "description": "Time at which this event was created.",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "const": "PlaybackStarted"
          }
        },
        "required": [
          "type",
          "application",
          "timestamp",
          "playback"
        ],
        "type": "object"
      },
      "service": "default",
      "wire_value": "PlaybackStarted"
    },
    {
      "default": true,
      "description": "Event showing the continuation of a media playback operation from one media URI to the next in the list.",
      "name": "playback-continuing",
      "oip": "org.asterisk.ari:22.10.1#playback-continuing",
      "schema": {
        "description": "Event showing the continuation of a media playback operation from one media URI to the next in the list.",
        "properties": {
          "application": {
            "description": "Name of the application receiving the event.",
            "type": "string"
          },
          "asterisk_id": {
            "description": "The unique ID for the Asterisk instance that raised this event.",
            "type": "string"
          },
          "playback": {
            "description": "Playback control object",
            "properties": {
              "id": {
                "description": "ID for this playback operation",
                "type": "string"
              },
              "language": {
                "description": "For media types that support multiple languages, the language requested for playback.",
                "type": "string"
              },
              "media_uri": {
                "description": "The URI for the media currently being played back.",
                "type": "string"
              },
              "next_media_uri": {
                "description": "If a list of URIs is being played, the next media URI to be played back.",
                "type": "string"
              },
              "state": {
                "description": "Current state of the playback operation.",
                "enum": [
                  "queued",
                  "playing",
                  "continuing",
                  "done",
                  "failed"
                ],
                "type": "string"
              },
              "target_uri": {
                "description": "URI for the channel or bridge to play the media on",
                "type": "string"
              }
            },
            "required": [
              "id",
              "media_uri",
              "state",
              "target_uri"
            ],
            "type": "object"
          },
          "timestamp": {
            "description": "Time at which this event was created.",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "const": "PlaybackContinuing"
          }
        },
        "required": [
          "type",
          "application",
          "timestamp",
          "playback"
        ],
        "type": "object"
      },
      "service": "default",
      "wire_value": "PlaybackContinuing"
    },
    {
      "default": true,
      "description": "Event showing the completion of a media playback operation.",
      "name": "playback-finished",
      "oip": "org.asterisk.ari:22.10.1#playback-finished",
      "schema": {
        "description": "Event showing the completion of a media playback operation.",
        "properties": {
          "application": {
            "description": "Name of the application receiving the event.",
            "type": "string"
          },
          "asterisk_id": {
            "description": "The unique ID for the Asterisk instance that raised this event.",
            "type": "string"
          },
          "playback": {
            "description": "Playback control object",
            "properties": {
              "id": {
                "description": "ID for this playback operation",
                "type": "string"
              },
              "language": {
                "description": "For media types that support multiple languages, the language requested for playback.",
                "type": "string"
              },
              "media_uri": {
                "description": "The URI for the media currently being played back.",
                "type": "string"
              },
              "next_media_uri": {
                "description": "If a list of URIs is being played, the next media URI to be played back.",
                "type": "string"
              },
              "state": {
                "description": "Current state of the playback operation.",
                "enum": [
                  "queued",
                  "playing",
                  "continuing",
                  "done",
                  "failed"
                ],
                "type": "string"
              },
              "target_uri": {
                "description": "URI for the channel or bridge to play the media on",
                "type": "string"
              }
            },
            "required": [
              "id",
              "media_uri",
              "state",
              "target_uri"
            ],
            "type": "object"
          },
          "timestamp": {
            "description": "Time at which this event was created.",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "const": "PlaybackFinished"
          }
        },
        "required": [
          "type",
          "application",
          "timestamp",
          "playback"
        ],
        "type": "object"
      },
      "service": "default",
      "wire_value": "PlaybackFinished"
    },
    {
      "default": true,
      "description": "Event showing the start of a recording operation.",
      "name": "recording-started",
      "oip": "org.asterisk.ari:22.10.1#recording-started",
      "schema": {
        "description": "Event showing the start of a recording operation.",
        "properties": {
          "application": {
            "description": "Name of the application receiving the event.",
            "type": "string"
          },
          "asterisk_id": {
            "description": "The unique ID for the Asterisk instance that raised this event.",
            "type": "string"
          },
          "recording": {
            "description": "Recording control object",
            "properties": {
              "cause": {
                "description": "Cause for recording failure if failed",
                "type": "string"
              },
              "duration": {
                "description": "Duration in seconds of the recording",
                "format": "int32",
                "type": "integer"
              },
              "format": {
                "description": "Recording format (wav, gsm, etc.)",
                "type": "string"
              },
              "name": {
                "description": "Base name for the recording",
                "type": "string"
              },
              "silence_duration": {
                "description": "Duration of silence, in seconds, detected in the recording. This is only available if the recording was initiated with a non-zero maxSilenceSeconds.",
                "format": "int32",
                "type": "integer"
              },
              "state": {
                "enum": [
                  "queued",
                  "recording",
                  "paused",
                  "done",
                  "failed",
                  "canceled"
                ],
                "type": "string"
              },
              "talking_duration": {
                "description": "Duration of talking, in seconds, detected in the recording. This is only available if the recording was initiated with a non-zero maxSilenceSeconds.",
                "format": "int32",
                "type": "integer"
              },
              "target_uri": {
                "description": "URI for the channel or bridge being recorded",
                "type": "string"
              }
            },
            "required": [
              "format",
              "name",
              "state",
              "target_uri"
            ],
            "type": "object"
          },
          "timestamp": {
            "description": "Time at which this event was created.",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "const": "RecordingStarted"
          }
        },
        "required": [
          "type",
          "application",
          "timestamp",
          "recording"
        ],
        "type": "object"
      },
      "service": "default",
      "wire_value": "RecordingStarted"
    },
    {
      "default": true,
      "description": "Event showing the completion of a recording operation.",
      "name": "recording-finished",
      "oip": "org.asterisk.ari:22.10.1#recording-finished",
      "schema": {
        "description": "Event showing the completion of a recording operation.",
        "properties": {
          "application": {
            "description": "Name of the application receiving the event.",
            "type": "string"
          },
          "asterisk_id": {
            "description": "The unique ID for the Asterisk instance that raised this event.",
            "type": "string"
          },
          "recording": {
            "description": "Recording control object",
            "properties": {
              "cause": {
                "description": "Cause for recording failure if failed",
                "type": "string"
              },
              "duration": {
                "description": "Duration in seconds of the recording",
                "format": "int32",
                "type": "integer"
              },
              "format": {
                "description": "Recording format (wav, gsm, etc.)",
