{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "OpenAI API key, sent as a bearer token",
      "env": [
        "OPENAI_API_KEY"
      ],
      "name": "openai.api_key",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.openai.api",
  "connector": "openai",
  "default_auth": [
    [
      "openai.api_key"
    ]
  ],
  "description": "OpenAI platform: inspect models, stored responses, files and batches, and create chat completions and embeddings",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "openai.api_key"
        ]
      ],
      "description": "List the models available to this API key, with their ids and owners",
      "direction": "read",
      "expose": true,
      "id": "openai-models-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/v1/models"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "One entry per model the key can reach, each `{id, object: \"model\", created, owned_by}`. Unpaginated — this is the whole list",
            "items": {
              "properties": {
                "created": {
                  "description": "Unix seconds",
                  "type": "integer"
                },
                "id": {
                  "description": "The model id to pass as `model` elsewhere, e.g. `gpt-4o`",
                  "type": "string"
                },
                "object": {
                  "const": "model"
                },
                "owned_by": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "object"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "object": {
            "const": "list"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "openai.api_key"
        ]
      ],
      "description": "Retrieve one model by id, with its ownership and permissions",
      "direction": "read",
      "expose": true,
      "id": "openai-model-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The model id, e.g. `gpt-4o` or `text-embedding-3-small`",
          "name": "model",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/v1/models/{model}"
      },
      "response_schema": {
        "properties": {
          "created": {
            "description": "Unix seconds at which the model was created",
            "type": "integer"
          },
          "id": {
            "description": "The model id, echoed back",
            "type": "string"
          },
          "object": {
            "const": "model"
          },
          "owned_by": {
            "description": "The owning organization, e.g. `openai` or `system`",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "openai.api_key"
        ]
      ],
      "description": "Create a chat completion. Billed per input and output token, so the caller must state a token budget via max_completion_tokens",
      "direction": "write",
      "expose": true,
      "id": "openai-chat-completion",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The model to run, e.g. `gpt-4o`",
          "name": "model",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The conversation so far: a list of `{role, content}` objects, where role is one of system, developer, user, assistant or tool",
          "name": "messages",
          "position": "body",
          "required": true,
          "schema": {
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        {
          "description": "Upper bound on generated tokens, including reasoning tokens. Required by this connector so that every call states its cost bound",
          "name": "max_completion_tokens",
          "position": "body",
          "required": true,
          "schema": {
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "max_completion_tokens": {
              "$param": "max_completion_tokens"
            },
            "messages": {
              "$param": "messages"
            },
            "model": {
              "$param": "model"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/v1/chat/completions"
      },
      "response_schema": {
        "properties": {
          "choices": {
            "description": "One entry per completion; this connector never sets `n`, so there is exactly one",
            "items": {
              "properties": {
                "finish_reason": {
                  "description": "Why generation stopped: `stop` (the model finished), `length` (the token budget ran out and `content` is truncated), `tool_calls`, `content_filter` or `function_call`",
                  "type": "string"
                },
                "index": {
                  "type": "integer"
                },
                "message": {
                  "description": "The assistant's turn: `role`, and `content` — which is null when the model answered with `tool_calls` or set `refusal` instead",
                  "type": "object"
                }
              },
              "required": [
                "index",
                "message",
                "finish_reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "created": {
            "description": "Unix seconds",
            "type": "integer"
          },
          "id": {
            "description": "The completion's id, `chatcmpl-…`",
            "type": "string"
          },
          "model": {
            "description": "The model that actually ran, which may name a dated snapshot of the alias that was requested",
            "type": "string"
          },
          "object": {
            "const": "chat.completion"
          },
          "system_fingerprint": {
            "type": "string"
          },
          "usage": {
            "description": "What the call cost, in tokens: `prompt_tokens`, `completion_tokens`, `total_tokens`, plus `completion_tokens_details` (which is where reasoning tokens are reported)",
            "type": "object"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "openai.api_key"
        ]
      ],
      "description": "Create embedding vectors for one or more input texts. Billed per input token",
      "direction": "write",
      "expose": true,
      "id": "openai-embeddings-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The embedding model to use, e.g. `text-embedding-3-small`",
          "name": "model",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The text to embed: a string, or an array of strings to embed as a batch",
          "name": "input",
          "position": "body",
          "required": true,
          "schema": {
            "oneOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            ]
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "input": {
              "$param": "input"
            },
            "model": {
              "$param": "model"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/v1/embeddings"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "One embedding per input, in input order — including for a single string input",
            "items": {
              "properties": {
                "embedding": {
                  "description": "The vector, as floats. Its length is the model's dimension — 1536 for `text-embedding-3-small`, 3072 for `-large` — unless `dimensions` was set, which this connector does not send",
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "index": {
                  "description": "The position of the input this vector belongs to",
                  "type": "integer"
                },
                "object": {
                  "const": "embedding"
                }
              },
              "required": [
                "object",
                "index",
                "embedding"
              ],
