      "params": [
        {
          "description": "The id of the charge to refund, `ch_` followed by an opaque identifier. A payment intent's charge is its `latest_charge`, which `stripe-payment-intent-get` reports",
          "name": "charge",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 4,
            "pattern": "^ch_[A-Za-z0-9]+$",
            "type": "string"
          }
        },
        {
          "description": "A unique string — a UUID is the convention — identifying this refund. Stripe replays the first result for 24 hours rather than refunding again, so a retry with the same key is safe and a retry with a new key refunds the customer twice. Generate it once per refund you intend and reuse it across every retry",
          "name": "idempotency_key",
          "position": "header",
          "required": true,
          "schema": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "wire": "Idempotency-Key"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/code",
          "message_pointer": "/error/message"
        }
      },
      "repeatability_condition": "the connector requires an `Idempotency-Key` header on every call, and Stripe replays a keyed POST from its own cache for 24 hours rather than re-executing it, so a retried refund refunds once — without the key a retry would move money twice",
      "request": {
        "headers": {
          "Idempotency-Key": {
            "$param": "idempotency_key"
          }
        },
        "method": "POST",
        "url": "{base}/v1/charges/{charge}/refunds"
      },
      "response_schema": {
        "properties": {
          "amount": {
            "description": "What was refunded, in the currency's smallest unit",
            "type": "integer"
          },
          "charge": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "object": {
            "const": "refund"
          },
          "status": {
            "description": "`pending` is the normal answer — the money has not reached the customer's bank yet. `failed` means it came back and the customer was not paid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "amount",
          "currency",
          "status"
        ],
        "type": "object"
      },
      "risk": "destructive",
      "semantic_effects": [
        "money"
      ],
      "service": "default"
    },
    {
