          },
          "htmlLink": {
            "description": "The event's page in Google Calendar — the link to give a human",
            "format": "uri",
            "type": "string"
          },
          "iCalUID": {
            "description": "The RFC 5545 UID, which is what identifies this event across calendars — distinct from `id`",
            "type": "string"
          },
          "id": {
            "description": "The new event's id — the only handle on it, and what `google-calendar-event-get` reads back",
            "type": "string"
          },
          "kind": {
            "const": "calendar#event"
          },
          "organizer": {
            "description": "`{email, displayName, self}` — the calendar the event was created on",
            "type": "object"
          },
          "sequence": {
            "description": "The iCalendar revision number, `0` on creation",
            "type": "integer"
          },
          "start": {
            "description": "`{dateTime, timeZone}` as created. Calendar resolves the offset that was sent into its own representation, so this may not be the literal string that was sent",
            "type": "object"
          },
          "status": {
            "description": "`confirmed` on a freshly created event",
            "enum": [
              "confirmed",
              "tentative",
              "cancelled"
            ],
            "type": "string"
          },
          "summary": {
            "description": "Echoes the title that was sent",
            "type": "string"
          },
          "updated": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "calendar"
    },
    {
      "auth": [
        [
          "google.access_token"
        ]
      ],
      "description": "Get one calendar's own metadata — its summary, description, location and time zone. This is the calendar, not its events: use `google-calendar-event-get` for one of those. Needs the `calendar.readonly` scope",
      "direction": "read",
      "expose": true,
      "id": "google-calendar-calendar-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The calendar to read: the literal `primary` for the token owner's own calendar, or a calendar address",
          "name": "calendar_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 3,
            "pattern": "^(primary|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})$",
            "type": "string"
          },
          "wire": "calendarId"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/status",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/calendar/v3/calendars/{calendar_id}"
      },
      "response_schema": {
        "properties": {
          "conferenceProperties": {
            "description": "`{allowedConferenceSolutionTypes}` — which conferencing this calendar permits (`hangoutsMeet`, `eventHangout`, `eventNamedHangout`)",
            "type": "object"
          },
          "description": {
            "type": "string"
          },
          "etag": {
            "type": "string"
          },
          "id": {
            "description": "The calendar's address, e.g. `you@example.com` or `team@group.calendar.google.com`. Asking for `primary` resolves to this",
            "type": "string"
          },
          "kind": {
            "const": "calendar#calendar"
          },
          "location": {
            "description": "Free-text geographic location of the calendar",
            "type": "string"
          },
          "summary": {
            "description": "The calendar's title",
            "type": "string"
          },
          "timeZone": {
            "description": "The calendar's own IANA time zone, e.g. `Europe/Berlin`. **This is what an event's offset should be computed from** — `google-calendar-event-insert` cannot send a `timeZone`, so the caller has to apply the right offset itself",
            "type": "string"
          }
        },
        "required": [
          "id",
          "summary"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "calendar"
    },
    {
      "auth": [
        [
          "google.access_token"
        ]
      ],
      "description": "Get one Drive file's metadata — its id, name and MIME type. This never returns file content: downloading needs `alt=media`, which is a query parameter and therefore unavailable (C-30). Needs the `drive.metadata.readonly` scope (or `drive.readonly`)",
      "direction": "read",
      "expose": true,
      "id": "google-drive-file-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The file's id — the base64url-ish string in its Drive URL after `/d/`. A folder is a file too, with the folder MIME type",
          "name": "file_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "wire": "fileId"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/status",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/drive/v3/files/{file_id}"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "drive"
    },
    {
      "auth": [
        [
          "google.access_token"
        ]
      ],
      "description": "Rename a Drive file: sets its name and changes nothing else. It does not move, share, trash or replace the file's content. Needs the `drive.file` scope for files this token created, or `drive` for any other",
      "direction": "write",
      "expose": true,
      "id": "google-drive-file-update",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The file to rename",
          "name": "file_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "wire": "fileId"
        },
        {
          "description": "The file's new name. Drive does not require names to be unique within a folder, so this can collide with a sibling",
          "name": "name",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/status",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "name": {
              "$param": "name"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PATCH",
        "url": "{base}/drive/v3/files/{file_id}"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "drive"
    }
