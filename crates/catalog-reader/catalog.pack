                      "source": {
                        "description": "Provider or brand name (e.g., \"Confluence\", \"Slack\", \"Google Drive\"). Displayed as-is without translation. Required when sourceType is present.",
                        "example": "Confluence",
                        "maxLength": 128,
                        "minLength": 1,
                        "type": "string"
