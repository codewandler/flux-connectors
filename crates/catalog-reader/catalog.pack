                    "format": "int64",
                    "type": "integer"
                  },
                  "app_name": {
                    "nullable": true,
                    "type": "string"
                  },
                  "author_id": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "call_connected_at": {
