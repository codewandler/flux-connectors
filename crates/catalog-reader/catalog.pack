          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "description": "Who opened it: `login`, `id`, `type`",
            "type": "object"
          }
        },
        "required": [
