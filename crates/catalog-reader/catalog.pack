    {
      "auth": [
        [
          "confluence.api_token"
        ]
      ],
      "description": "Read one page's metadata by id — title, space, parent, author, creation time, current version number and the link to open it in Confluence. **The page body is not returned**: selecting a content format needs a query parameter this connector cannot send, so the `body` field comes back empty regardless of whether the page has content. Use this to resolve a page id to its title and URL, not to read what the page says",
      "direction": "read",
      "endpoint": {
        "site": [
          "host"
        ]
      },
      "expose": true,
      "id": "confluence-page-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The page's id, from `confluence-space-pages`, from a space's `homepageId`, or from `confluence-page-create`'s response",
          "name": "id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/api/v2/pages/{id}"
      },
      "response_schema": {
        "properties": {
          "_links": {
            "description": "`webui` is the page's path in the Confluence UI and `base` is the site URL — join them to give a human a link. `editui` and `tinyui` are the edit and short forms",
            "properties": {
              "base": {
                "description": "The site's base URL, to resolve the paths above against",
                "format": "uri",
                "type": "string"
              },
              "editui": {
                "type": "string"
              },
              "tinyui": {
                "description": "Confluence's short link form",
                "type": "string"
              },
              "webui": {
                "description": "The page's path, relative to `base`",
                "type": "string"
              }
            },
            "type": "object"
          },
          "authorId": {
            "description": "Account id of whoever created the page. An `accountId`, never a username — it identifies a named person, so read it for what the calling flow needs and do not persist it beyond that",
            "type": "string"
          },
          "body": {
            "description": "**EMPTY (`{}`).** Confluence populates this only when a `body-format` query parameter selects a representation (`storage`, `view`, `atlas_doc_format`…), and this connector sends none (C-30). An empty `body` here is a limitation of this connector and says nothing about the page — do not report the page as blank on the strength of it",
            "type": "object"
