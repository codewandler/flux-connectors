      "request": {
        "method": "GET",
        "url": "{base}/channels"
      },
      "response_schema": {
        "items": {
          "description": "A specific communication connection between Asterisk and an Endpoint.",
          "properties": {
            "accountcode": {
              "type": "string"
            },
            "caller": {
              "description": "Caller identification",
              "properties": {
                "name": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "number"
              ],
              "type": "object"
            },
            "caller_rdnis": {
              "description": "The Caller ID RDNIS",
              "type": "string"
            },
            "channelvars": {
              "additionalProperties": true,
              "description": "Channel variables",
              "type": "object"
            },
            "connected": {
              "description": "Caller identification",
              "properties": {
                "name": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "number"
              ],
              "type": "object"
            },
            "creationtime": {
              "description": "Timestamp when channel was created",
              "format": "date-time",
              "type": "string"
            },
            "dialplan": {
              "description": "Current location in the dialplan",
              "properties": {
                "app_data": {
                  "description": "Parameter of current dialplan application",
                  "type": "string"
                },
                "app_name": {
                  "description": "Name of current dialplan application",
                  "type": "string"
                },
                "context": {
                  "description": "Context in the dialplan",
                  "type": "string"
                },
                "exten": {
                  "description": "Extension in the dialplan",
                  "type": "string"
                },
                "priority": {
                  "description": "Priority in the dialplan",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "app_data",
                "app_name",
                "context",
                "exten",
                "priority"
              ],
              "type": "object"
            },
            "id": {
              "description": "Unique identifier of the channel.\n\nThis is the same as the Uniqueid field in AMI.",
              "type": "string"
            },
            "language": {
              "description": "The default spoken language",
              "type": "string"
            },
            "name": {
              "description": "Name of the channel (i.e. SIP/foo-0000a7e3)",
              "type": "string"
            },
            "protocol_id": {
              "description": "Protocol id from underlying channel driver (i.e. Call-ID for chan_pjsip; will be empty if not applicable or not implemented by driver).",
              "type": "string"
            },
            "state": {
              "enum": [
                "Down",
                "Rsrved",
                "OffHook",
                "Dialing",
                "Ring",
                "Ringing",
                "Up",
                "Busy",
                "Dialing Offhook",
                "Pre-ring",
                "Unknown"
              ],
              "type": "string"
            },
            "tenantid": {
              "description": "The Tenant ID for the channel",
              "type": "string"
            }
          },
          "required": [
            "accountcode",
            "caller",
            "connected",
            "creationtime",
            "dialplan",
            "id",
            "language",
            "name",
            "protocol_id",
            "state"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
