      "expose": false,
      "id": "babelforce-get-user",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The user's uuid.",
          "name": "id",
          "position": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/api/v2/users/{id}"
      },
      "response_schema": {
        "example": {
          "item": {
            "accountExpired": true,
            "accountLocked": true,
            "activated": true,
            "agent": {
              "sourceId": "sourceId",
              "type": "type",
              "uuid": "046b6c7f-0b8a-43b9-b35d-6489e6daee91"
            },
            "email": "jordan.lee@example.com",
            "enabled": true,
            "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
            "passwordExpired": true,
            "roles": [
              "user",
              "user"
            ]
          },
          "success": true
        },
        "properties": {
          "item": {
            "description": "A user account within the customer's account, with its login email, status flags, assigned roles and optionally the agent it is linked to.",
            "example": {
              "accountExpired": true,
              "accountLocked": true,
              "activated": true,
              "agent": {
                "sourceId": "sourceId",
                "type": "type",
                "uuid": "046b6c7f-0b8a-43b9-b35d-6489e6daee91"
              },
              "email": "jordan.lee@example.com",
              "enabled": true,
              "id": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
              "passwordExpired": true,
              "roles": [
                "user",
                "user"
              ]
            },
            "properties": {
              "accountExpired": {
                "description": "Whether the user's account has expired.",
                "type": "boolean"
              },
              "accountLocked": {
                "description": "Whether the user's account is locked.",
                "type": "boolean"
              },
              "activated": {
                "description": "Whether the user has activated their account.",
                "type": "boolean"
              },
              "agent": {
                "description": "The agent linked to this user, if any",
                "example": {
                  "sourceId": "sourceId",
                  "type": "type",
                  "uuid": "046b6c7f-0b8a-43b9-b35d-6489e6daee91"
                },
                "properties": {
                  "sourceId": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "uuid": {
                    "description": "The unique Identifier (UUID) of the object",
                    "format": "uuid",
                    "type": "string"
                  }
                }
              },
              "email": {
                "description": "The user's login email address.",
                "example": "jordan.lee@example.com",
                "format": "email",
                "type": "string"
              },
              "enabled": {
                "description": "Whether the user is enabled and may sign in.",
                "type": "boolean"
              },
              "id": {
                "description": "The unique Identifier (UUID) of the object",
                "format": "uuid",
                "type": "string"
              },
              "passwordExpired": {
                "description": "Whether the user's password has expired and must be reset.",
                "type": "boolean"
              },
              "roles": {
                "description": "A List of Roles which are associated with the current User",
                "items": {
                  "description": "A role associated with the Account",
                  "enum": [
                    "manager",
                    "owner",
                    "reporter",
                    "user",
                    "agent",
                    "supervisor",
                    "sales",
                    "router",
                    "scheduler"
                  ],
                  "example": "user",
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "email",
              "id",
              "roles"
            ]
          },
          "success": {
            "description": "Whether the Request was successful or not",
            "type": "boolean"
          }
        },
        "required": [
          "item",
          "success"
        ]
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "manager"
