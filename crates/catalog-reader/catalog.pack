          "name",
          "kind"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "launchdarkly.api_token"
        ]
      ],
      "description": "Turn a feature flag on or off in one environment. This is a live production change: every SDK instance currently evaluating this flag in this environment — web, mobile and backend alike — switches to the other branch as soon as this call returns, for every real user it serves. It is reversible by toggling back, but it is not a private or staged edit",
      "direction": "write",
      "expose": true,
      "id": "launchdarkly-flag-toggle",
      "idempotency": "conditional",
      "params": [
        {
          "description": "The project's own key, from launchdarkly-project-list's `key` field",
          "name": "project_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The flag's own key, from launchdarkly-flag-list's `key` field",
          "name": "feature_flag_key",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "description": "A JSON Patch (RFC 6902) document with exactly one operation, setting a single environment's on/off state: `[{\"op\": \"replace\", \"path\": \"/environments/<environment_key>/on\", \"value\": true}]` turns the flag on in that environment, `\"value\": false` turns it off. `<environment_key>` is that environment's own key (from launchdarkly-environment-list's `key` field), written literally into the JSON Pointer string — it is not a request parameter LaunchDarkly could confuse with a URL segment",
            "items": {
              "properties": {
                "op": {
                  "description": "This connector's curated toggle uses only `replace`; LaunchDarkly's PATCH also accepts `add`, `remove` and `test`, none of which this connector exposes",
                  "enum": [
                    "replace"
                  ],
                  "type": "string"
                },
                "path": {
                  "description": "A JSON Pointer to one environment's `on` bit: `/environments/{environment_key}/on`",
                  "pattern": "^/environments/[A-Za-z0-9._-]+/on$",
                  "type": "string"
                },
                "value": {
                  "description": "`true` turns the flag on in that environment, `false` turns it off",
                  "type": "boolean"
                }
              },
              "required": [
                "op",
                "path",
                "value"
              ],
              "type": "object"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          }
        }
      ],
      "repeatability_condition": "the body schema admits exactly one JSON Patch `replace` onto one environment's `on` bit (maxItems 1, op pinned to `replace`, path pinned to `/environments/{key}/on`), so it sets an absolute value and never a toggle or a delta — re-sending it lands the flag where the caller asked, however many times it runs",
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "$param": "body"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PATCH",
        "url": "{base}/flags/{project_key}/{feature_flag_key}"
      },
      "response_schema": {
        "properties": {
          "environments": {
            "description": "The flag's environments after the patch was applied, in the same shape launchdarkly-flag-get returns — read the affected environment's `on` field back to confirm the toggle took effect",
            "type": "object"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "kind"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "v2",
      "base_url": "https://app.launchdarkly.com/api/v2",
      "gid": "com.launchdarkly.api:v2",
      "name": "default",
      "tags": [
        "developer-tools"
      ]
    }
  ],
  "vendor": "LaunchDarkly",
  "verify": "launchdarkly-project-list"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Mailchimp Marketing API key, granting whatever the account that issued it can do. Travels as `Authorization: Bearer <key>`, the alternative Mailchimp documents beside its Basic form. The key's trailing `-us14`-style suffix names the account's datacentre; that value is asked for separately as configuration and is never read back out of this credential",
      "env": [
        "MAILCHIMP_API_KEY"
      ],
      "name": "mailchimp.api_key",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.mailchimp.api",
  "config": [
    {
      "approval": "none",
      "binds": "endpoint.dc",
      "docs_url": "https://mailchimp.com/developer/marketing/docs/fundamentals/",
      "example": "us14",
      "format": "subdomain",
      "help": "The short region code in front of `api.mailchimp.com` for your account, like us14 or us6. Find it three ways, whichever is easiest: it is the first part of the URL on your Mailchimp API keys page; it is the last part of your API key, after the final - character; or, on an OAuth connection, the OAuth metadata endpoint returns it. Enter the code alone, not a full URL",
      "label": "Mailchimp datacentre",
      "level": "connection",
      "name": "server_prefix",
      "required": true,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "credential.mailchimp.api_key",
      "docs_url": "https://mailchimp.com/developer/marketing/guides/quick-start/",
      "format": "token",
      "help": "Generate one under Account & billing, Extras, API keys in your Mailchimp account. It grants everything your Mailchimp user can do, so treat it as a password. Copy the datacentre code above from the same page before you leave it",
      "label": "Mailchimp API key",
      "level": "connection",
      "name": "api_key",
      "required": true,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "mailchimp",
  "default_auth": [
    [
      "mailchimp.api_key"
    ]
  ],
  "description": "Mailchimp Marketing API: check connectivity, read audiences and their contacts, add or update a contact, and list campaigns. Authenticates with a single API key sent as a bearer token, against a host whose datacentre label the operator supplies",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "mailchimp.api_key"
        ]
      ],
      "description": "Check that the API is reachable and the credential works. Takes no argument and returns no account data — Mailchimp calls it a health check that returns nothing account-specific. Also this connector's `verify`: it is the one call that proves both halves of the configuration at once, because a wrong key and a wrong datacentre label both fail it",
      "direction": "read",
      "endpoint": {
        "dc": [
          "host"
        ]
      },
      "expose": true,
      "id": "mailchimp-ping",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/ping"
      },
      "response_schema": {
        "properties": {
          "health_status": {
            "description": "Mailchimp's fixed cheerful string when everything is working. Its presence is the signal; its wording is not a contract and must not be matched on",
            "type": "string"
          }
        },
        "required": [
          "health_status"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "mailchimp.api_key"
        ]
      ],
      "description": "List the audiences in the account, with the id every contact operation takes. Returns Mailchimp's default first page only — this connector declares no paging parameters, so compare the number of entries against `total_items` before treating the result as complete",
      "direction": "read",
      "endpoint": {
        "dc": [
          "host"
        ]
      },
      "expose": true,
      "id": "mailchimp-audience-list",
      "idempotency": "idempotent",
      "request": {
        "method": "GET",
        "url": "{base}/lists"
      },
      "response_schema": {
        "properties": {
          "lists": {
            "description": "The audiences on this page",
            "items": {
              "properties": {
                "campaign_defaults": {
                  "description": "Default from-name, from-address, subject and language for campaigns sent to this audience. Left untyped rather than enumerated",
                  "type": "object"
                },
                "contact": {
                  "description": "The physical mailing address printed in campaign footers, required by anti-spam law. Left untyped rather than enumerated",
                  "type": "object"
                },
                "date_created": {
                  "description": "When the audience was created",
                  "type": "string"
                },
                "email_type_option": {
                  "description": "Whether contacts may choose plain-text or HTML",
                  "type": "boolean"
                },
                "id": {
                  "description": "The audience id — what every operation below calls `list_id`",
                  "type": "string"
                },
                "list_rating": {
                  "description": "Mailchimp's own 0-5 engagement rating for the audience",
                  "type": "integer"
                },
                "name": {
                  "description": "The audience name, as it reads in the UI",
                  "type": "string"
                },
                "permission_reminder": {
                  "description": "The line Mailchimp prints in every campaign reminding a contact why they are receiving it",
                  "type": "string"
                },
                "stats": {
                  "description": "Member counts and engagement averages. Left untyped rather than enumerated in full; `member_count` is the field most callers want",
                  "type": "object"
                },
                "subscribe_url_long": {
                  "format": "uri",
                  "type": "string"
                },
                "subscribe_url_short": {
                  "description": "The audience's hosted signup form — a link to give a human",
                  "format": "uri",
                  "type": "string"
                },
                "visibility": {
                  "description": "`pub` or `prv` — whether the audience is listed publicly",
                  "type": "string"
                },
                "web_id": {
                  "description": "The id in Mailchimp's own web UI, which is not the API id",
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total_items": {
            "description": "How many audiences exist in total, which is how a caller sees that this page is a prefix",
            "type": "integer"
          }
        },
        "required": [
          "lists",
          "total_items"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
