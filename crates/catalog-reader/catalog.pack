          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{base}/entries/{entry_id}"
      },
      "response_schema": {
        "properties": {
          "fields": {
            "description": "The entry's own field values, keyed by this space's content-model field ids — chosen by whoever built the content type, and not knowable at build time. See contentful-entry-create's header comment for why this is described rather than enumerated",
            "type": "object"
          },
          "sys": {
            "description": "Envelope metadata: at least `id`, `type` (\"Entry\"), `createdAt`, `updatedAt`, `revision`, and links to this entry's content type, space and environment",
