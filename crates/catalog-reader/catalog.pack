                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "description": "A single tag string",
                    "type": "string"
                  }
                ]
              },
              "tde_workspace": {
                "description": "Write only. TDE workspace information for the ticket",
                "properties": {
                  "previous_workspace": {
                    "properties": {
                      "id": {
                        "format": "int64",
