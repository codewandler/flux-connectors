    {
      "auth": [
        [
          "babelforce.access_token"
        ]
      ],
      "description": "Set session variables on a live call. Pass them as the `variables` map; babelforce applies only keys beginning `app.` and silently ignores the rest, and states that rule only in prose",
      "direction": "write",
      "expose": true,
      "id": "babelforce-call-session-set",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The uuid of the call whose session variables are set.",
          "name": "id",
          "position": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Map of variable name to value. Keys must start with `app.` to take effect.",
          "name": "variables",
          "position": "body",
          "required": false,
          "schema": {
            "additionalProperties": true,
            "description": "Map of variable name to value. Keys must start with `app.` to take effect.",
            "example": {
              "app.campaign": "spring",
              "app.priority": "high"
            },
            "type": "object"
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "variables": {
              "$param": "variables"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PUT",
        "url": "{base}/api/v2/calls/{id}/session/set"
      },
      "response_schema": {
        "description": "Confirms that the requested session variables were applied.",
        "example": {
          "success": true
        },
        "properties": {
          "success": {
            "description": "Whether the variables were set successfully.",
            "type": "boolean"
          }
        }
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "manager"
    },
