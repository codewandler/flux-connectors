                          "format": "int64",
                          "type": "integer"
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object",
                  "writeOnly": true
                },
                "ticket_form_id": {
                  "description": "Enterprise only. The id of the ticket form to render for the ticket",
                  "format": "int64",
                  "nullable": true,
                  "type": "integer"
                },
                "tpe_voice_comment": {
                  "description": "Write only. A TPE voice comment for Talk Partner Edition tickets",
