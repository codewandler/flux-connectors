    {
      "auth": [
        [
          "zendesk.api_token"
        ]
      ],
      "description": "Publish a new externally visible Help Center article in one numeric section",
      "direction": "write",
      "endpoint": {
        "subdomain": [
          "host"
        ]
      },
      "expose": true,
      "id": "zendesk-help-center-article-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The unique ID of the section",
          "name": "section_id",
          "position": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "article",
          "position": "body",
          "required": true,
          "schema": {
            "properties": {
              "body": {
                "example": "Use a tripod",
                "type": "string"
              },
              "locale": {
                "example": "en-us",
                "type": "string"
              },
              "permission_group_id": {
                "description": "The id of the permission group. If omitted, defaults to the Admins permission group.",
                "example": 56,
                "type": "integer"
              },
              "title": {
                "example": "Taking photos in low light",
                "type": "string"
              },
              "user_segment_id": {
                "description": "The id of the user segment. If omitted, the article is public (visible to everyone).",
                "example": 123,
                "type": "integer"
              }
            },
            "required": [
              "title",
              "locale"
            ],
            "type": "object"
          }
        }
      ],
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "article": {
              "$param": "article"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/v2/help_center/sections/{section_id}/articles"
      },
      "response_schema": {
        "properties": {
          "article": {
            "example": {
              "author_id": 3465,
              "comments_disabled": false,
              "id": 1635,
              "locale": "en",
              "permission_group_id": 13,
              "title": "The article",
              "user_segment_id": 12
            },
            "properties": {
              "author_id": {
                "description": "The id of the user who wrote the article (set to the user who made the request on create by default)",
                "type": "integer"
              },
              "body": {
                "description": "HTML body of the article. Unsafe tags and attributes may be removed before display. For a list of safe tags and attributes, see [Allowing unsafe HTML in Help Center articles](https://support.zendesk.com/hc/en-us/articles/115015895948) in Zendesk help",
                "type": "string"
              },
              "comments_disabled": {
                "description": "True if comments are disabled; false otherwise",
                "type": "boolean"
              },
              "content_tag_ids": {
                "description": "The list of content tags attached to the article",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "created_at": {
                "description": "The time the article was created",
                "readOnly": true,
                "type": "string"
              },
              "draft": {
                "description": "True if the translation for the current locale is a draft; false otherwise. false by default. Can be set when creating but not when updating. For updating, see Translations",
                "readOnly": true,
                "type": "boolean"
              },
              "edited_at": {
                "description": "The time the article was last edited in its displayed locale",
                "readOnly": true,
                "type": "string"
              },
              "html_url": {
                "description": "The url of the article in Help Center",
                "readOnly": true,
                "type": "string"
              },
              "id": {
                "description": "Automatically assigned when the article is created",
                "readOnly": true,
                "type": "integer"
              },
              "label_names": {
                "description": "An array of label names associated with this article. By default no label names are used. Only available on certain plans",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "locale": {
                "description": "The locale that the article is being displayed in",
                "type": "string"
              },
              "outdated": {
                "description": "Deprecated. Always false because the source translation is always the most up-to-date translation",
                "readOnly": true,
                "type": "boolean"
              },
              "outdated_locales": {
                "description": "Locales in which the article was marked as outdated",
                "items": {
                  "type": "string"
                },
                "readOnly": true,
                "type": "array"
              },
              "permission_group_id": {
                "description": "The id of the permission group which defines who can edit and publish this article",
                "type": "integer"
              },
              "position": {
                "description": "The position of this article in the article list. 0 by default",
                "type": "integer"
              },
              "promoted": {
                "description": "True if this article is promoted; false otherwise. false by default",
                "type": "boolean"
              },
              "section_id": {
                "description": "The id of the section to which this article belongs",
                "type": "integer"
              },
              "source_locale": {
                "description": "The source (default) locale of the article",
                "readOnly": true,
                "type": "string"
              },
              "title": {
                "description": "The title of the article",
                "type": "string"
              },
              "updated_at": {
                "description": "The time the article was last updated",
                "readOnly": true,
                "type": "string"
              },
              "url": {
                "description": "The API url of the article",
                "readOnly": true,
                "type": "string"
              },
              "user_segment_id": {
                "description": "The id of the user segment which defines who can see this article. Set to null to make it accessible to everyone. Either user_segment_id or user_segment_ids must be specified",
                "nullable": true,
                "type": "integer"
              },
              "user_segment_ids": {
                "description": "List of user segment ids which define who can view this article. Set to an empty list to make it accessible to everyone. For Enterprise plans only this may contain more than one user_segment_id. Either user_segment_id or user_segment_ids must be specified",
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "vote_count": {
                "description": "The total number of upvotes and downvotes",
                "readOnly": true,
                "type": "integer"
              },
              "vote_sum": {
                "description": "The sum of upvotes (+1) and downvotes (-1), which may be positive or negative",
                "readOnly": true,
                "type": "integer"
              }
            },
            "required": [
              "title",
              "locale",
              "permission_group_id"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "help-center"
    },
    {
      "auth": [
        [
          "zendesk.messaging_key"
        ]
      ],
      "description": "Create an empty SDK group conversation in the configured Zendesk Messaging app",
      "direction": "write",
      "endpoint": {
        "appId": [
          "path"
        ],
        "subdomain": [
          "host"
        ]
      },
      "expose": true,
      "id": "zendesk-messaging-conversation-create",
      "idempotency": "non_idempotent",
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "type": "sdkGroup"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/v2/apps/{appId}/conversations"
      },
      "response_schema": {
        "properties": {
          "conversation": {
            "allOf": [
              {
                "allOf": [
                  {
                    "properties": {
                      "activeSwitchboardIntegration": {
                        "allOf": [
                          {
                            "properties": {
                              "id": {
                                "description": "The unique ID of the switchboard integration.",
                                "example": "redacted-opaque",
                                "type": "string"
                              },
                              "integrationId": {
                                "description": "Id of the integration that should deliver events routed by the switchboard.",
                                "example": "redacted-identifier",
                                "type": "string"
                              },
                              "integrationType": {
                                "description": "Type of integration that should deliver events routed by the switchboard. If referencing an OAuth integration, the clientId issued by Sunshine Conversations during the OAuth partnership process will be the value of integrationType.",
                                "example": "zd:agentWorkspace",
                                "type": "string"
                              },
                              "name": {
                                "description": "Identifier for use in control transfer protocols. Restricted to alphanumeric characters, `-` and `_`.",
                                "example": "bot",
                                "maxLength": 128,
                                "type": "string"
                              }
                            },
                            "type": "object"
                          }
                        ],
                        "description": "The current switchboard integration that is in control of the conversation. This field is omitted if no `activeSwitchboardIntegration` exists for the conversation.",
                        "nullable": true
                      },
                      "id": {
                        "description": "The unique ID of the conversation.",
                        "example": "redacted-opaque",
                        "type": "string"
                      },
                      "metadata": {
                        "additionalProperties": true,
                        "description": "Flat object containing custom properties. Strings, numbers and booleans\nare the only supported format that can be passed to metadata.\nThe metadata is limited to 4KB in size.\n",
                        "example": {
                          "lang": "en-ca"
                        },
                        "nullable": true,
                        "type": "object"
                      },
                      "pendingSwitchboardIntegration": {
                        "allOf": [
                          {
                            "properties": {
                              "id": {
                                "description": "The unique ID of the switchboard integration.",
                                "example": "redacted-opaque",
                                "type": "string"
                              },
                              "integrationId": {
                                "description": "Id of the integration that should deliver events routed by the switchboard.",
                                "example": "redacted-identifier",
                                "type": "string"
                              },
                              "integrationType": {
                                "description": "Type of integration that should deliver events routed by the switchboard. If referencing an OAuth integration, the clientId issued by Sunshine Conversations during the OAuth partnership process will be the value of integrationType.",
                                "example": "zd:agentWorkspace",
                                "type": "string"
                              },
                              "name": {
                                "description": "Identifier for use in control transfer protocols. Restricted to alphanumeric characters, `-` and `_`.",
                                "example": "bot",
                                "maxLength": 128,
                                "type": "string"
                              }
                            },
                            "type": "object"
                          }
                        ],
                        "description": "The switchboard integration that is awaiting control. This field is omitted if no switchboard integration has been previously offered control.",
                        "nullable": true
                      },
                      "type": {
                        "description": "The type of the conversation.",
                        "enum": [
                          "personal",
                          "sdkGroup"
                        ],
                        "example": "personal",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "businessLastRead": {
                        "description": "A datetime string with the format YYYY-MM-DDThh:mm:ss.SSSZ\nrepresenting the moment the conversation was last marked as read with\nrole business.\n",
                        "example": "2020-06-23T14:33:47.492Z",
                        "nullable": true,
                        "type": "string"
                      },
                      "createdAt": {
                        "description": "A datetime string with the format YYYY-MM-DDThh:mm:ss.SSSZ\nrepresenting the creation time of the conversation.\n",
                        "example": "2020-06-20T11:26:07.001Z",
                        "type": "string"
                      },
                      "description": {
                        "description": "A short text describing the conversation.",
                        "example": "Conversation between Rogers and Carl.",
                        "maxLength": 100,
                        "minLength": 1,
                        "nullable": true,
                        "type": "string"
                      },
                      "displayName": {
                        "allOf": [
                          {
                            "maxLength": 100,
                            "minLength": 1,
                            "nullable": true,
                            "type": "string"
                          }
                        ],
                        "description": "A friendly name for the conversation, may be displayed to the business or\nthe user.\n",
                        "example": "My conversation"
                      },
                      "iconUrl": {
                        "description": "A custom conversation icon url. The image must be in either JPG, PNG, or GIF format",
                        "example": "https://www.gravatar.com/image.jpg",
                        "format": "uri",
                        "maxLength": 2048,
                        "minLength": 1,
                        "nullable": true,
                        "type": "string"
                      },
                      "isDefault": {
                        "description": "Whether the conversation is the default conversation for the user. Will be\ntrue for the first personal conversation created for the user, and false in\nall other cases.\n",
                        "example": false,
                        "type": "boolean"
                      },
                      "lastUpdatedAt": {
                        "description": "A datetime string with the format YYYY-MM-DDThh:mm:ss.SSSZ\nrepresenting the moment the last message was received in the\nconversation, or the creation time if no messages have been received yet.\n",
                        "example": "2020-06-26T14:33:47.120Z",
                        "nullable": true,
                        "type": "string"
                      }
                    },
                    "type": "object",
                    "x-resourceId": "Conversations"
                  }
                ]
              }
            ],
            "description": "The conversation."
          }
        },
        "title": "ConversationResponse",
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "messaging"
    },
