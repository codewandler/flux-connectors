          "ok": {
            "description": "False on failure, with HTTP still 200. Branch on this first",
            "type": "boolean"
          },
          "pin_count": {
            "type": "integer"
          },
          "response_metadata": {
            "description": "Carries `next_cursor`, the cursor for the following page. It cannot be sent back by this connector (C-30)",
            "type": "object"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "slack.bot_token"
        ]
      ],
      "description": "Look up one Slack user by id — display name, real name, time zone and whether they are a bot. Slack answers HTTP 200 even on failure: check `ok` in the response body, where an error such as `user_not_found` appears at `error`",
      "direction": "write",
      "expose": true,
      "id": "slack-users-info",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "User id to look up (`U0123ABCDEF`)",
          "name": "user",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Also return the user's locale",
          "name": "include_locale",
          "position": "body",
          "required": false,
          "schema": {
            "default": false,
            "type": "boolean"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/error"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "include_locale": {
              "$param": "include_locale"
            },
            "user": {
              "$param": "user"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/api/users.info"
      },
      "response_schema": {
        "properties": {
          "error": {
            "description": "Present only when `ok` is false: typically `user_not_found`",
            "type": "string"
          },
          "ok": {
            "description": "False on failure, with HTTP still 200. Branch on this first",
            "type": "boolean"
          },
          "user": {
            "description": "The user: `id`, `team_id`, `name`, `real_name`, `deleted`, `tz`, `tz_label`, `tz_offset`, `is_bot`, `is_admin`, `is_owner`, `updated`, and `profile` — which holds the display name, status and, with `users:read.email`, the email address",
            "type": "object"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "slack.bot_token"
        ]
      ],
      "description": "Add an emoji reaction to a message, visible to everyone in the channel. Slack answers HTTP 200 even on failure: check `ok` in the response body, where an error such as `already_reacted` appears at `error`",
      "direction": "write",
      "expose": true,
      "id": "slack-reactions-add",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "Channel id containing the message (`C0123ABCDEF`)",
          "name": "channel",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The `ts` of the message to react to, e.g. `1728394857.123456`",
          "name": "timestamp",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Emoji name without colons, e.g. `thumbsup` or `white_check_mark`",
          "name": "name",
          "position": "body",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/error"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
