          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The issue or pull request number to comment on",
          "name": "issue_number",
          "position": "path",
          "required": true,
          "schema": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          }
        },
        {
