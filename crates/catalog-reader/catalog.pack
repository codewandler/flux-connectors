            "description": "The 1-based page this response is",
            "type": "integer"
          },
          "pagelen": {
            "description": "How many values a page holds; 10 by default",
            "type": "integer"
          },
          "size": {
            "description": "The total number of repositories, when Bitbucket computes it",
            "type": "integer"
          },
          "values": {
            "items": {
              "properties": {
                "created_on": {
                  "format": "date-time",
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "fork_policy": {
                  "description": "allow_forks, no_public_forks, or no_forks",
                  "type": "string"
                },
                "full_name": {
                  "description": "`workspace/slug`. Note that this is two segments: `repo_slug` is the second one alone",
                  "type": "string"
                },
                "has_issues": {
                  "description": "Whether the repository's own issue tracker is enabled",
                  "type": "boolean"
                },
                "has_wiki": {
                  "type": "boolean"
                },
                "is_private": {
                  "description": "Whether the repository is visible only to the workspace",
                  "type": "boolean"
                },
                "language": {
                  "description": "The primary language Bitbucket detected, empty when it detected none",
                  "type": "string"
