{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Airtable access token sent as a bearer — a personal access token or an OAuth-issued one",
      "env": [
        "AIRTABLE_ACCESS_TOKEN"
      ],
      "name": "airtable.access_token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.airtable.api",
  "connector": "airtable",
  "default_auth": [
    [
      "airtable.access_token"
    ]
  ],
  "description": "Airtable records: read, create, update and delete a record in a base's table",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "airtable.access_token"
        ]
      ],
      "description": "Read one record from a table — its cell values are under `fields` in the response, keyed by column name. Returns every column the token can see, in Airtable's default JSON cell format: narrowing or reformatting them needs the `fields[]` and `cellFormat` query parameters this connector cannot encode",
      "direction": "read",
      "expose": true,
      "id": "airtable-record-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The base's id, the `app…` segment in the base's URL in Airtable",
          "name": "base_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^app[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "baseId"
        },
        {
          "description": "The table's id, the `tbl…` segment in the table's URL in Airtable. Airtable also routes this segment on a table *name*, which this connector does not accept: a name is interpolated into the URL unencoded, so one containing a space or a `/` would address the wrong route",
          "name": "table_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^tbl[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "tableIdOrName"
        },
        {
          "description": "The record's id, `rec…`. It is what a create returns and what the record's own URL ends with",
          "name": "record_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^rec[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "recordId"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/type",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/v0/{base_id}/{table_id}/{record_id}"
      },
      "response_schema": {
        "properties": {
          "createdTime": {
            "description": "When the record was created",
            "format": "date-time",
            "type": "string"
          },
          "fields": {
            "description": "The record's cell values, keyed by column name. Individual columns are not enumerated: they are the base's own schema, which differs per base and changes at runtime — recording the envelope is what a consumer cannot infer",
            "type": "object"
          },
          "id": {
            "description": "The record's id",
            "pattern": "^rec[A-Za-z0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdTime",
          "fields"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "airtable.access_token"
        ]
      ],
      "description": "Create one record in a table. Cell values are supplied under `fields`, keyed by column name, and must already be in the exact JSON form each column expects — Airtable's `typecast` coercion cannot be requested yet (see the connector's notes). The created record, with its `rec…` id, is in the response",
      "direction": "write",
      "expose": true,
      "id": "airtable-record-create",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The base's id, the `app…` segment in the base's URL in Airtable",
          "name": "base_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^app[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "baseId"
        },
        {
          "description": "The table's id, the `tbl…` segment in the table's URL in Airtable. The name form is not accepted — see `airtable-record-get`",
          "name": "table_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^tbl[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "tableIdOrName"
        },
        {
          "description": "The record's cell values, as an object keyed by the table's column names — `{\"Name\": \"Acme\", \"Status\": \"Open\"}`. Each value must match its column's type: a single-select takes one of its configured option names, a linked-record column takes an array of `rec…` ids, a date takes an ISO 8601 string. An unknown column name is rejected, not ignored",
          "name": "cell_values",
          "position": "body",
          "required": true,
          "schema": {
            "description": "A map from column name to cell value. Untyped here because the columns are the base's own schema",
            "type": "object"
          },
          "wire": "fields"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/type",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "fields": {
              "$param": "cell_values"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "url": "{base}/v0/{base_id}/{table_id}"
      },
      "response_schema": {
        "properties": {
          "createdTime": {
            "description": "When the record was created",
            "format": "date-time",
            "type": "string"
          },
          "fields": {
            "description": "The created record's cell values as Airtable stored them, keyed by column name. Computed and formula columns appear here having been evaluated",
            "type": "object"
          },
          "id": {
            "description": "The created record's id — what later calls address it by",
            "pattern": "^rec[A-Za-z0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdTime",
          "fields"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "airtable.access_token"
        ]
      ],
      "description": "Update one record's cell values. The write is sparse: only the columns named in `fields` change and every other column of the record is left exactly as it was. Values must already be in the form each column expects — `typecast` coercion cannot be requested yet. The updated record is in the response",
      "direction": "write",
      "expose": true,
      "id": "airtable-record-update",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The base's id, the `app…` segment in the base's URL in Airtable",
          "name": "base_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^app[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "baseId"
        },
        {
          "description": "The table's id, the `tbl…` segment in the table's URL in Airtable. The name form is not accepted — see `airtable-record-get`",
          "name": "table_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^tbl[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "tableIdOrName"
        },
        {
          "description": "The id of the record to update",
          "name": "record_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^rec[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "recordId"
        },
        {
          "description": "The columns to change, as an object keyed by the table's column names. Columns not named here keep their current values. Setting a column to `null` clears it, which is the only way to empty a cell through this operation",
          "name": "cell_values",
          "position": "body",
          "required": true,
          "schema": {
            "description": "A map from column name to cell value. Untyped here because the columns are the base's own schema",
            "type": "object"
          },
          "wire": "fields"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/type",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "fields": {
              "$param": "cell_values"
            }
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "method": "PATCH",
        "url": "{base}/v0/{base_id}/{table_id}/{record_id}"
      },
      "response_schema": {
        "properties": {
          "createdTime": {
            "description": "When the record was created — unchanged by an update",
            "format": "date-time",
            "type": "string"
          },
          "fields": {
            "description": "The record's cell values after the update, keyed by column name. Every column is returned, not only the changed ones",
            "type": "object"
          },
          "id": {
            "description": "The record's id",
            "pattern": "^rec[A-Za-z0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdTime",
          "fields"
        ],
        "type": "object"
      },
      "risk": "medium",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "airtable.access_token"
        ]
      ],
      "description": "Delete one record and every cell value in it. There is no API route back: Airtable's trash and revision history are UI features on a retention window, not endpoints, so a flux run cannot undo this. Responds `{\"id\": …, \"deleted\": true}`",
      "direction": "write",
      "expose": true,
      "id": "airtable-record-delete",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The base's id, the `app…` segment in the base's URL in Airtable",
          "name": "base_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^app[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "baseId"
        },
        {
          "description": "The table's id, the `tbl…` segment in the table's URL in Airtable. The name form is not accepted — see `airtable-record-get`",
          "name": "table_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^tbl[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "tableIdOrName"
        },
        {
          "description": "The id of the record to delete",
          "name": "record_id",
          "position": "path",
          "required": true,
          "schema": {
            "pattern": "^rec[A-Za-z0-9]+$",
            "type": "string"
          },
          "wire": "recordId"
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/type",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "{base}/v0/{base_id}/{table_id}/{record_id}"
      },
      "response_schema": {
        "properties": {
          "deleted": {
            "description": "Always `true` on a 2xx. Airtable reports a record that was already gone as a 404 rather than as `false`",
            "type": "boolean"
          },
          "id": {
            "description": "The id of the record that was deleted",
            "pattern": "^rec[A-Za-z0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "deleted"
        ],
        "type": "object"
      },
      "risk": "destructive",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "v0",
      "base_url": "https://api.airtable.com",
      "gid": "com.airtable.api:v0",
      "name": "default",
      "tags": [
        "database"
      ]
    }
  ],
  "vendor": "Airtable"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "An Algolia API key with the ACLs this connector needs: `search` and `browse` for the reads, `addObject` and `deleteObject` for the writes. Scope it to the indices this connection should reach rather than using the Admin key",
      "env": [
        "ALGOLIA_API_KEY"
      ],
      "name": "algolia.api_key",
      "scheme": {
        "kind": "header",
        "name": "X-Algolia-API-Key"
      },
      "subject": "unstated"
    }
  ],
  "authority": "com.algolia.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.algolia.api_key",
      "docs_url": "https://dashboard.algolia.com/account/api-keys/",
      "format": "token",
      "help": "Create one under API Keys in the Algolia dashboard, with the search, browse, addObject and deleteObject ACLs restricted to the indices this connection should reach. Algolia shows the full key in the dashboard; the Admin key is deliberately not what this asks for",
      "label": "Algolia API key",
      "level": "connection",
      "name": "api_key",
      "required": true,
      "secret": true,
      "service": "default"
    },
    {
      "also_binds": [
        "header.X-Algolia-Application-Id"
      ],
      "approval": "none",
      "binds": "endpoint.app_id",
      "docs_url": "https://dashboard.algolia.com/account/api-keys/",
      "example": "B1G2GM9NG0",
      "format": "text",
      "help": "The ten-character application id shown at the top of the API Keys page in your Algolia dashboard, e.g. B1G2GM9NG0. It identifies your Algolia application, forms the hostname every call goes to, and is sent as a header on every request — you supply it once here and this connector puts it in both places. It is not a secret; Algolia publishes it in client-side code",
      "label": "Algolia application id",
      "level": "connection",
      "name": "app_id",
      "required": true,
      "secret": false,
      "service": "default"
    }
  ],
  "connector": "algolia",
  "default_auth": [
    [
      "algolia.api_key"
    ]
  ],
  "description": "Algolia search: list an application's indices, search one, and read, save or delete a single record by its object id",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "algolia.api_key"
        ]
      ],
      "description": "List the indices in this Algolia application, with each index's record count and size. This is the call that discovers the index names every other operation here takes",
      "direction": "read",
      "endpoint": {
        "app_id": [
          "header",
          "host"
        ]
      },
      "expose": true,
      "id": "algolia-index-list",
      "idempotency": "idempotent",
      "quirks": {
        "error_envelope": {
          "message_pointer": "/message"
        }
      },
      "request": {
        "headers": {
          "X-Algolia-Application-Id": "{app_id}"
        },
        "method": "GET",
        "url": "{base}/1/indexes"
      },
      "response_schema": {
        "properties": {
          "items": {
            "description": "The application's indices",
            "items": {
              "properties": {
                "createdAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "dataSize": {
                  "description": "The size of the index's records in bytes",
                  "type": "integer"
                },
                "entries": {
                  "description": "How many records the index holds",
                  "type": "integer"
                },
                "fileSize": {
                  "description": "The size of the index on disk in bytes, records plus internal structures",
                  "type": "integer"
                },
                "lastBuildTimeS": {
                  "description": "How long the index's last build took, in seconds",
                  "type": "integer"
                },
                "name": {
                  "description": "The index name — what every other operation here passes as `index_name`",
                  "type": "string"
                },
                "numberOfPendingTasks": {
                  "description": "Indexing operations accepted but not yet applied. Non-zero means a recent write is not visible to search yet",
                  "type": "integer"
                },
                "pendingTask": {
                  "description": "Whether any indexing operation is still pending",
                  "type": "boolean"
                },
                "primary": {
                  "description": "For a replica index, the name of the index it replicates. Absent on a primary",
                  "type": "string"
                },
                "replicas": {
                  "description": "The names of this index's replicas, if it has any",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "updatedAt": {
                  "format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "nbPages": {
            "description": "How many pages of indices exist. This connector requests only the first",
            "type": "integer"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "algolia.api_key"
        ]
      ],
      "description": "Search one index and return the matching records. Algolia ranks results by its own configured relevance, so the order is the index's, not this connector's; `hits_per_page` and `page` walk the result set, and `filters` narrows it with Algolia's filter syntax over the index's own attributes",
      "direction": "read",
      "endpoint": {
        "app_id": [
          "header",
          "host"
        ]
      },
      "expose": true,
      "id": "algolia-index-search",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The index to search, from algolia-index-list's `name` field",
          "name": "index_name",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The search text. An empty string matches every record in the index, ranked by the index's own ranking rules — which is how this operation browses rather than searches",
          "name": "query",
          "position": "query",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "How many records to return per page. Algolia's own default is 20 and its maximum is 1000",
          "name": "hits_per_page",
          "position": "query",
          "required": false,
          "schema": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "wire": "hitsPerPage"
        },
        {
          "description": "Which page of results to return, counting from 0",
          "name": "page",
          "position": "query",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "description": "An Algolia filter expression over this index's own attributes, e.g. `category:book AND price < 20`. The attribute names are the index's content and are not knowable here; an index that has not declared an attribute as filterable answers a filter on it with a 400",
          "name": "filters",
          "position": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/message"
        }
      },
      "request": {
        "headers": {
          "X-Algolia-Application-Id": "{app_id}"
        },
        "method": "GET",
        "query": [
          {
            "name": "filters",
            "value": {
              "$param": "filters"
            }
          },
          {
            "name": "hitsPerPage",
            "value": {
              "$param": "hits_per_page"
            }
          },
          {
            "name": "page",
            "value": {
              "$param": "page"
            }
          },
          {
            "name": "query",
            "value": {
              "$param": "query"
            }
          }
        ],
        "url": "{base}/1/indexes/{index_name}"
      },
      "response_schema": {
        "properties": {
          "exhaustiveNbHits": {
            "description": "False when `nbHits` is an approximation, which Algolia does for very large result sets",
            "type": "boolean"
          },
          "hits": {
            "description": "The matching records, in Algolia's ranked order. Each hit is the stored record itself — its attributes are this index's own content and are not knowable at build time — plus `objectID` and Algolia's `_highlightResult` annotations",
            "items": {
              "properties": {
                "objectID": {
                  "description": "The record's own id — what algolia-object-get, -save and -delete address it by",
                  "type": "string"
                }
              },
              "required": [
                "objectID"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "hitsPerPage": {
            "type": "integer"
          },
          "nbHits": {
            "description": "How many records matched in total, which may exceed what this page returned",
            "type": "integer"
          },
          "nbPages": {
            "description": "How many pages the result set has at this `hitsPerPage`",
            "type": "integer"
          },
          "page": {
            "description": "The page that was returned, counting from 0",
            "type": "integer"
          },
          "params": {
            "description": "Echoes the search parameters Algolia actually applied, URL-encoded",
            "type": "string"
          },
          "processingTimeMS": {
            "description": "How long Algolia spent on the query, in milliseconds",
            "type": "integer"
          },
          "query": {
            "description": "Echoes the search text",
            "type": "string"
          }
        },
        "required": [
          "hits",
          "nbHits"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "algolia.api_key"
        ]
      ],
      "description": "Read one record from an index by its object id. Returns the stored record as it is; its attributes are this index's own content model, so nothing here can name them",
      "direction": "read",
      "endpoint": {
        "app_id": [
          "header",
          "host"
        ]
      },
      "expose": true,
      "id": "algolia-object-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The index the record is in, from algolia-index-list's `name` field",
          "name": "index_name",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The record's own id — Algolia's `objectID`, from a search hit or from whatever wrote the record",
          "name": "object_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/message"
        }
      },
      "request": {
        "headers": {
          "X-Algolia-Application-Id": "{app_id}"
        },
        "method": "GET",
        "url": "{base}/1/indexes/{index_name}/{object_id}"
      },
      "response_schema": {
        "description": "The stored record. Every attribute other than `objectID` is this index's own content and is not knowable at build time",
        "properties": {
          "objectID": {
            "description": "The record's own id, echoed back",
            "type": "string"
          }
        },
        "required": [
          "objectID"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "algolia.api_key"
        ]
      ],
      "description": "Save one record at a known object id, creating it if it does not exist and REPLACING it wholesale if it does. This is not a partial update: attributes absent from the body are removed from the stored record. Algolia applies the write asynchronously, so the response's `taskID` is an acknowledgement of acceptance rather than of visibility, and a search run immediately afterwards may still return the old record",
      "direction": "write",
      "endpoint": {
        "app_id": [
          "header",
          "host"
        ]
      },
      "expose": true,
      "id": "algolia-object-save",
      "idempotency": "conditional",
      "params": [
        {
          "description": "The index to write to, from algolia-index-list's `name` field. Algolia creates an index that does not exist on first write",
          "name": "index_name",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The id to store the record under. An existing record at this id is replaced in full",
          "name": "object_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "name": "body",
          "position": "body",
          "required": true,
          "schema": {
            "description": "The record to store, as a flat or nested JSON object. Its attributes are this index's own content model and are not knowable at build time — see the header comment for why this is one opaque schema rather than named fields. An `objectID` inside the body is redundant with the one in the path and Algolia takes the path's",
            "type": "object"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/message"
        }
      },
      "repeatability_condition": "the body carries the record's whole content as an absolute value rather than a delta, so re-sending it leaves the record in the state the caller asked for, however many times it runs. Conditional rather than idempotent because Algolia applies the write asynchronously and answers each call with a fresh `taskID`, so a stored result must never be served in place of running it",
      "request": {
        "body": {
          "encoding": "json",
          "template": {
            "$param": "body"
          }
        },
        "headers": {
          "X-Algolia-Application-Id": "{app_id}",
          "content-type": "application/json"
        },
        "method": "PUT",
        "url": "{base}/1/indexes/{index_name}/{object_id}"
      },
      "response_schema": {
        "properties": {
          "objectID": {
            "description": "The id the record was stored under, echoed back",
            "type": "string"
          },
          "taskID": {
            "description": "Algolia's own id for the asynchronous indexing task. The write is accepted when this returns and visible to search some time after; this connector declares no operation that waits on it",
            "type": "integer"
          },
          "updatedAt": {
            "description": "When Algolia accepted the write",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "objectID",
          "taskID"
        ],
        "type": "object"
      },
      "risk": "high",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "algolia.api_key"
        ]
      ],
      "description": "Delete one record from an index by its object id. The record is gone with no undo route in the API — restoring it means re-indexing it from the source of truth. Algolia applies the delete asynchronously, so the `taskID` acknowledges acceptance rather than visibility",
      "direction": "write",
      "endpoint": {
        "app_id": [
          "header",
          "host"
        ]
      },
      "expose": true,
      "id": "algolia-object-delete",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The index the record is in, from algolia-index-list's `name` field",
          "name": "index_name",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "The record's own id — Algolia's `objectID`. The record at this id is deleted",
          "name": "object_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "message_pointer": "/message"
        }
      },
      "request": {
        "headers": {
          "X-Algolia-Application-Id": "{app_id}"
        },
        "method": "DELETE",
        "url": "{base}/1/indexes/{index_name}/{object_id}"
      },
      "response_schema": {
        "properties": {
          "deletedAt": {
            "description": "When Algolia accepted the delete",
            "format": "date-time",
            "type": "string"
          },
          "taskID": {
            "description": "Algolia's own id for the asynchronous delete task. The delete is accepted when this returns and visible to search some time after",
            "type": "integer"
          }
        },
        "required": [
          "taskID"
        ],
        "type": "object"
      },
      "risk": "destructive",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "api_version": "1",
      "base_url": "https://{app_id}.algolia.net",
      "gid": "com.algolia.api:1",
      "name": "default",
      "tags": [
        "search"
      ]
    }
  ],
  "vendor": "Algolia",
  "verify": "algolia-index-list"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "Anthropic API key, sent as x-api-key",
      "env": [
        "ANTHROPIC_API_KEY"
      ],
      "name": "anthropic.api_key",
      "scheme": {
        "kind": "header",
        "name": "x-api-key"
      },
      "subject": "unstated"
    },
    {
      "description": "Anthropic Admin API key (starts sk-ant-admin), sent as x-api-key. Required only for the Admin API operations below — organization, members, workspaces, workspace members, API keys and invites — the model catalogue uses the regular API key",
      "env": [
        "ANTHROPIC_ADMIN_KEY"
      ],
      "name": "anthropic.admin_key",
      "scheme": {
        "kind": "header",
        "name": "x-api-key"
      },
      "subject": "unstated"
    },
    {
      "description": "Anthropic Console OAuth2 access token (sk-ant-oat01-), obtained on behalf of a signed-in user and sent as a bearer. Workspace-scoped: enough for the model catalogue, and deliberately not enough for the Admin API",
      "name": "anthropic.console_oauth",
      "oauth2": {
        "authorize_path": "/oauth/authorize",
        "endpoint": "login",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "public_client": true,
        "token_path": "/v1/oauth/token"
      },
      "scheme": {
        "kind": "bearer"
      },
      "subject": "user",
      "token_endpoint_quirks": [
        {
          "attribution": "Anthropic's own CLI docs (https://platform.claude.com/docs/en/cli-sdks-libraries/cli/authentication) describe the flow as \"a browser-based OAuth flow against the Claude Console\" and publish no URLs. The URLs come from third-party implementations of the same flow — github.com/querymt/anthropic-auth records the Console authorize endpoint as `console.anthropic.com/oauth/authorize` (pre-rename) alongside the subscription flow's `claude.ai/oauth/authorize` — and from the live-host check recorded in NousResearch/hermes-agent#49821, where the console token host 404s and the platform host answers. Not confirmed against a vendor specification, because none is published.",
          "behaviour": "Anthropic documents that this flow exists and what it is for, but publishes no authorize or token URL for it on any page under platform.claude.com/docs or code.claude.com/docs. Both values above are therefore measured rather than quoted. The token endpoint additionally MOVED: `console.anthropic.com/v1/oauth/token` now returns 404, and the live endpoint is `platform.claude.com/v1/oauth/token`, following the console.anthropic.com to platform.claude.com rename. A host that hard-codes the legacy console host from an older integration will 404 on fresh logins while token *refresh* keeps working, which is how the migration usually presents.",
          "grant": "authorization_code",
          "measured": "2026-08-12"
        }
      ]
    },
    {
      "description": "Anthropic Console OAuth2 access token carrying the org:admin scope, sent as a bearer. Required for the Admin API operations; issued only to an organization member holding the admin, owner or primary-owner role",
      "name": "anthropic.console_oauth_admin",
      "oauth2": {
        "authorize_path": "/oauth/authorize",
        "endpoint": "login",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "public_client": true,
        "scopes": [
          "org:admin"
        ],
        "token_path": "/v1/oauth/token"
      },
      "scheme": {
        "kind": "bearer"
      },
      "subject": "user",
      "token_endpoint_quirks": [
        {
          "attribution": "See `anthropic.console_oauth`'s measurement for the full provenance: Anthropic's CLI docs describe the flow without URLs; the values come from third-party implementations of the same flow and a live-host check.",
          "behaviour": "Same measured endpoints as `anthropic.console_oauth` — Anthropic publishes no authorize or token URL for the Console flow, and the token host moved from console.anthropic.com to platform.claude.com. Recorded again here rather than cross-referenced because a quirk is read per credential.",
          "grant": "authorization_code",
          "measured": "2026-08-12"
        }
      ]
    },
    {
      "description": "Anthropic Claude Pro/Max subscription OAuth2 access token (sk-ant-oat01-), acquired on behalf of a signed-in consumer-plan user and sent as a bearer. Authorizes inference against Anthropic's consumer surfaces, which this catalogue does not model — it is declared so a host can compose the two-host acquisition, not to authenticate an operation here. Anthropic restricts this flow to Claude Code and Claude.ai; using the token elsewhere violates the Consumer Terms (owner-accepted 2026-08-12)",
      "name": "anthropic.subscription_oauth",
      "oauth2": {
        "authorize_path": "/oauth/authorize",
        "endpoint": "subscription-authorize",
        "grants": [
          "authorization_code",
          "refresh_token"
        ],
        "public_client": true,
        "scopes": [
          "user:profile",
          "user:inference",
          "user:sessions:claude_code",
          "user:mcp_servers"
        ],
        "token_endpoint": "login",
        "token_path": "/v1/oauth/token"
      },
      "scheme": {
        "kind": "bearer"
      },
      "subject": "user",
      "token_endpoint_quirks": [
        {
          "attribution": "The endpoints, the shared public client id and the `user:*` scopes come from third-party implementations of the Claude Code flow — github.com/querymt/anthropic-auth (\"Max Mode\": authorize `claude.ai/oauth/authorize`) and flopsstuff.github.io/coqu/claude-oauth (token `platform.claude.com/v1/oauth/token`, client id `9d1c250a-e61b-44d9-88ed-5944d1962f5e`, scopes `user:profile user:inference user:sessions:claude_code user:mcp_servers`, PKCE enforced). The console→platform token-host move is the live-host check in NousResearch/hermes-agent#49821. Anthropic's own docs describe consumer OAuth without publishing endpoints, so none of this is confirmed against a vendor specification.",
          "behaviour": "Authorize is `https://claude.ai/oauth/authorize` and the token exchange is `https://platform.claude.com/v1/oauth/token` — two different origins, PKCE S256 mandatory (omitting `code_verifier` fails the exchange). The token host is `platform.claude.com`, NOT the legacy `console.anthropic.com`, which now 404s: the console.anthropic.com to platform.claude.com rename moved it, and an older integration that hard-codes the console host will 404 on fresh logins while refresh keeps working. Anthropic publishes no URL for this flow; both values are measured.",
          "grant": "authorization_code",
          "measured": "2026-08-12"
        }
      ]
    }
  ],
  "authority": "com.anthropic.api",
  "config": [
    {
      "approval": "none",
      "binds": "credential.anthropic.api_key",
      "docs_url": "https://docs.anthropic.com/en/api/getting-started",
      "format": "token",
      "help": "Create a key in the Anthropic Console (console.anthropic.com), under API Keys. This is the standard key used for the model catalogue",
      "label": "API key",
      "level": "connection",
      "name": "api_key",
      "required": true,
      "secret": true,
      "service": "models"
    },
    {
      "approval": "none",
      "binds": "credential.anthropic.admin_key",
      "docs_url": "https://docs.anthropic.com/en/docs/manage-claude/admin-api-keys",
      "format": "token",
      "help": "Create an Admin API key in the Anthropic Console — only an organization member with the admin role can provision one. Required only for the Admin API operations, which read organization info, members, workspaces, workspace members, API keys and invites; the model catalogue works with the API key above alone",
      "label": "Admin API key",
      "level": "connection",
      "name": "admin_key",
      "required": true,
      "secret": true,
      "service": "admin"
    },
    {
      "approval": "none",
      "binds": "oauth.client_id",
      "docs_url": "https://platform.claude.com/docs/en/cli-sdks-libraries/cli/authentication",
      "format": "text",
      "help": "The OAuth client ID this deployment authorizes as. Anthropic does not currently operate a public client-registration program for third-party applications, so a deployment supplies the id it has been issued; the value is public, and PKCE rather than a client secret protects the exchange",
      "label": "Anthropic OAuth client ID",
      "level": "operator",
      "name": "oauth_client_id",
      "required": false,
      "secret": false,
      "service": "login"
    },
    {
      "approval": "none",
      "binds": "oauth.redirect_uri",
      "docs_url": "https://platform.claude.com/docs/en/cli-sdks-libraries/cli/authentication",
      "example": "https://exchange.internal/api/oauth/callback",
      "format": "url",
      "help": "The callback address this deployment serves, registered against the client ID above. Anthropic's own clients use a loopback callback and fall back to displaying the code for manual paste when no loopback is reachable",
      "label": "Anthropic OAuth callback URL",
      "level": "operator",
      "name": "oauth_redirect_uri",
      "required": false,
      "secret": false,
      "service": "login"
    }
  ],
  "connector": "anthropic",
  "default_auth": [
    [
      "anthropic.api_key"
    ],
    [
      "anthropic.console_oauth"
    ]
  ],
  "description": "Anthropic platform: the live model catalogue, and organization info, members, workspaces, workspace members, API keys and outstanding invites from the Admin API — all read-only",
  "generator": "flux-connectors 0.26.0",
  "operations": [
    {
      "auth": [
        [
          "anthropic.api_key"
        ],
        [
          "anthropic.console_oauth"
        ]
      ],
      "description": "List the models available to this API key, most recently released first. Unpaginated — this connector cannot request a further page",
      "direction": "read",
      "expose": true,
      "id": "anthropic-models-list",
      "idempotency": "idempotent",
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/type",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "headers": {
          "anthropic-version": "2023-06-01"
        },
        "method": "GET",
        "url": "{base}/v1/models"
      },
      "response_schema": {
        "properties": {
          "data": {
            "description": "One entry per model this key can reach. Each carries at least `id` (the string to pass as `model_id` to anthropic-model-get, e.g. `claude-opus-4-6`), `type: \"model\"`, `display_name`, `created_at`, `max_input_tokens`, `max_tokens`, and a `capabilities` object describing which features (batch, citations, code execution, image/PDF input, structured outputs, extended thinking) this model supports",
            "items": {
              "properties": {
                "created_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "type": {
                  "const": "model"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "first_id": {
            "description": "First id in `data`. This connector cannot use it as `before_id` — no query parameter is encodable (C-30)",
            "type": "string"
          },
          "has_more": {
            "description": "True when the account has more models than this unpaginated call returned",
            "type": "boolean"
          },
          "last_id": {
            "description": "Last id in `data`, likewise unusable as `after_id` here",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "models"
    },
    {
      "auth": [
        [
          "anthropic.api_key"
        ],
        [
          "anthropic.console_oauth"
        ]
      ],
      "description": "Retrieve one model by id, or resolve an alias to the model id it currently points at",
      "direction": "read",
      "expose": true,
      "id": "anthropic-model-get",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The model id or alias, e.g. `claude-opus-4-6` or `claude-3-5-sonnet-20241022`",
          "name": "model_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/error/type",
          "message_pointer": "/error/message"
        }
      },
      "request": {
        "headers": {
          "anthropic-version": "2023-06-01"
        },
        "method": "GET",
        "url": "{base}/v1/models/{model_id}"
      },
      "response_schema": {
        "properties": {
