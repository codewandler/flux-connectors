      "direction": "read",
      "expose": true,
      "id": "sendgrid-template-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "Restrict the list to `legacy`, `dynamic`, or `both` templates. SendGrid defaults to `dynamic` when this is omitted",
          "name": "generations",
          "position": "query",
          "required": false,
          "schema": {
            "enum": [
              "legacy",
              "dynamic",
              "both"
            ],
            "type": "string"
          }
        },
        {
          "description": "Results per page; SendGrid caps this at 200",
          "name": "page_size",
          "position": "query",
          "required": false,
          "schema": {
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
