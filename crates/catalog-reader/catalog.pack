{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
  "auth": [
    {
      "description": "GitHub token sent as a bearer — a GitHub App installation token, a fine-grained PAT, or a classic PAT",
      "env": [
        "GITHUB_TOKEN"
      ],
      "name": "github.token",
      "scheme": {
        "kind": "bearer"
      },
      "subject": "unstated"
    },
    {
      "description": "GitHub OAuth2 access token obtained on behalf of a signed-in user. Bounded by that user's own permissions, never by the application's",
      "name": "github.oauth_token",
      "oauth2": {
        "authorize_path": "/login/oauth/authorize",
        "endpoint": "login",
        "grants": [
          "authorization_code"
        ],
        "scopes": [
          "repo",
          "read:org"
        ],
        "token_path": "/login/oauth/access_token"
      },
      "scheme": {
        "kind": "bearer"
      },
      "subject": "user"
    }
  ],
  "authority": "com.github.api",
  "config": [
    {
      "approval": "none",
      "binds": "oauth.client_id",
      "docs_url": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app",
      "format": "text",
      "help": "Register an OAuth app under Settings -> Developer settings -> OAuth Apps, with the callback URL your deployment serves. This is the client ID, which is public",
      "label": "GitHub OAuth application client ID",
      "level": "operator",
      "name": "oauth_client_id",
      "required": false,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.redirect_uri",
      "docs_url": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps",
      "example": "https://exchange.internal/api/oauth/callback",
      "format": "url",
      "help": "The callback address this deployment serves, registered on the app above. GitHub matches the host (excluding sub-domains) and port exactly and requires the path to be at or below the registered callback URL's path — so a registered `https://host/api/oauth` admits `https://host/api/oauth/callback` but not `https://host/`",
      "label": "GitHub OAuth callback URL",
      "level": "operator",
      "name": "oauth_redirect_uri",
      "required": false,
      "secret": false,
      "service": "default"
    },
    {
      "approval": "none",
      "binds": "oauth.client_secret",
      "docs_url": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app",
      "format": "token",
      "help": "The client secret issued beside the ID above. GitHub shows it once at generation and never again. Supplied by whoever runs this deployment, never by an end user",
      "label": "GitHub OAuth application client secret",
      "level": "operator",
      "name": "oauth_client_secret",
      "required": false,
      "secret": true,
      "service": "default"
    }
  ],
  "connector": "github",
  "default_auth": [
    [
      "github.oauth_token"
    ],
    [
      "github.token"
    ]
  ],
  "description": "GitHub REST API: discover the authenticated user, their organisations and reachable repositories; read repositories, commits, issues, pull requests and Actions workflow runs; and write issues and issue comments",
  "generator": "flux-connectors 0.26.0",
