    {
      "auth": [
        [
          "typeform.access_token"
        ]
      ],
      "description": "List one form's responses, newest first by default. Paginate with `before`/`after`, each naming the `token` of a response already retrieved, to page toward older or newer responses respectively; `page_size` alone returns only the first page. Each response's `answers` holds whatever that respondent typed or selected — this connector never inspects or filters on answer content",
      "direction": "read",
      "expose": true,
      "id": "typeform-response-list",
      "idempotency": "idempotent",
      "params": [
        {
          "description": "The form's own id, from typeform-form-list's `id` field, or the trailing path segment of the form's own URL (the part after `/to/`)",
          "name": "form_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Responses per page; Typeform defaults this to 25 and caps it at 1000",
          "name": "page_size",
          "position": "query",
          "required": false,
          "schema": {
            "default": 25,
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Return only responses submitted before this response's own `token` (exclusive) — the cursor for paging toward older responses. Pass the `token` field of the oldest response already retrieved. Omit on the first page",
          "name": "before",
          "position": "query",
          "required": false,
          "schema": {
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        {
          "description": "Return only responses submitted after this response's own `token` (exclusive) — the cursor for paging toward newer responses. Pass the `token` field of the newest response already retrieved. Omit on the first page",
          "name": "after",
          "position": "query",
          "required": false,
          "schema": {
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        {
          "description": "Only include responses at or after this UTC instant, written with no timezone suffix at all, e.g. \"2017-07-09T00:00:00\" — never a trailing \"Z\" or a \"+HH:MM\" offset. Which timestamp this filters (submitted_at, staged_at or landed_at) depends on which response_type is requested",
          "name": "since",
          "position": "query",
          "required": false,
          "schema": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "type": "string"
          }
        },
        {
          "description": "Only include responses at or before this UTC instant, written with no timezone suffix at all, e.g. \"2017-07-09T00:00:00\" — never a trailing \"Z\" or a \"+HH:MM\" offset. Which timestamp this filters (submitted_at, staged_at or landed_at) depends on which response_type is requested",
          "name": "until",
          "position": "query",
          "required": false,
          "schema": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "type": "string"
          }
        },
        {
          "description": "Restrict to one or more submission states, comma-separated: started, partial, completed. Omit to receive every state",
          "name": "response_type",
          "position": "query",
          "required": false,
          "schema": {
            "pattern": "^(started|partial|completed)(,(started|partial|completed)){0,2}$",
            "type": "string"
          }
        },
        {
          "description": "How to order the returned responses: a fixed field name and a direction, comma-separated",
          "name": "sort",
          "position": "query",
          "required": false,
          "schema": {
            "enum": [
              "submitted_at,asc",
              "submitted_at,desc",
              "staged_at,asc",
              "staged_at,desc",
              "landed_at,asc",
              "landed_at,desc"
            ],
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/code",
          "message_pointer": "/description"
        }
      },
      "request": {
        "method": "GET",
        "query": [
          {
            "name": "after",
            "value": {
              "$param": "after"
            }
          },
          {
            "name": "before",
            "value": {
              "$param": "before"
            }
          },
          {
            "name": "page_size",
            "value": {
              "$param": "page_size"
            }
          },
          {
            "name": "response_type",
            "value": {
              "$param": "response_type"
            }
          },
          {
            "name": "since",
            "value": {
              "$param": "since"
            }
          },
          {
            "name": "sort",
            "value": {
              "$param": "sort"
            }
          },
          {
            "name": "until",
            "value": {
              "$param": "until"
            }
          }
        ],
        "url": "{base}/forms/{form_id}/responses"
      },
      "response_schema": {
        "properties": {
          "items": {
            "description": "This page's responses, in the order `sort` (or the default) puts them",
            "items": {
              "properties": {
                "answers": {
                  "description": "One entry per answered question: at minimum `{field: {id, ref, type}, type}` plus exactly one value key named after `type` (text, choice, choices, email, number, boolean, date, url, file_url or payment). The value itself is whatever the respondent typed or selected and is never enumerated or exemplified here",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "calculated": {
                  "description": "Computed values Typeform's scoring feature attaches",
                  "properties": {
                    "score": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "hidden": {
                  "description": "Hidden-field values this response's session was launched with, keyed by the form's own hidden-field variable names (see typeform-form-get's `hidden`). Shape and content depend entirely on the form's own configuration — commonly an email address, a customer id or similar, so this connector never enumerates or exemplifies a value here",
                  "type": "object"
                },
                "landed_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "landing_id": {
                  "description": "Identifies the browsing session that landed on the form — distinct from the response itself",
                  "type": "string"
                },
                "metadata": {
                  "description": "The submission's own browsing context — browser, platform, referer and network id. Not respondent-authored content",
                  "type": "object"
                },
                "response_id": {
                  "description": "The same value as `token`, under Typeform's other name for it",
                  "type": "string"
                },
                "response_type": {
                  "enum": [
                    "started",
                    "partial",
                    "completed"
                  ],
                  "type": "string"
                },
                "submitted_at": {
                  "description": "Present once submitted; absent on a still-open partial response",
                  "format": "date-time",
                  "type": "string"
                },
                "token": {
                  "description": "This response's own opaque id: 32 lowercase hex characters. Pass it as `before` or `after` to page around it",
                  "pattern": "^[0-9a-f]{32}$",
                  "type": "string"
                }
              },
              "required": [
                "response_id",
                "token"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "page_count": {
            "type": "integer"
          },
          "total_items": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total_items",
          "page_count"
        ],
        "type": "object"
      },
      "risk": "low",
      "semantic_effects": [],
      "service": "default"
    },
    {
      "auth": [
        [
          "typeform.access_token"
        ]
      ],
      "description": "Permanently delete one or more of a form's responses by their own token. There is no undelete: once deleted, a response's answers are gone. Deletion is asynchronous — a successful call confirms the request was registered, not that the responses are already gone",
      "direction": "write",
      "expose": true,
      "id": "typeform-response-delete",
      "idempotency": "non_idempotent",
      "params": [
        {
          "description": "The form's own id, from typeform-form-list's `id` field, or the trailing path segment of the form's own URL (the part after `/to/`)",
          "name": "form_id",
          "position": "path",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "description": "Comma-separated list of up to 1000 response tokens (the same value as a response's own `token`/`response_id`, from typeform-response-list) to delete permanently",
          "name": "included_response_ids",
          "position": "query",
          "required": true,
          "schema": {
            "pattern": "^[0-9a-f]{32}(,[0-9a-f]{32})*$",
            "type": "string"
          }
        }
      ],
      "quirks": {
        "error_envelope": {
          "code_pointer": "/code",
          "message_pointer": "/description"
        }
      },
      "request": {
        "method": "DELETE",
        "query": [
          {
            "name": "included_response_ids",
            "value": {
              "$param": "included_response_ids"
            }
          }
        ],
        "url": "{base}/forms/{form_id}/responses"
      },
      "risk": "destructive",
      "semantic_effects": [],
      "service": "default"
    }
  ],
  "runtime": "http",
  "schema_version": 1,
  "services": [
    {
      "base_url": "https://api.typeform.com",
      "name": "default",
      "tags": [
        "forms"
      ]
    }
  ],
  "vendor": "Typeform",
  "verify": "typeform-user-me"
}
{
  "$schema": "https://github.com/codewandler/flux-connectors/catalog/connector-document.schema.json",
