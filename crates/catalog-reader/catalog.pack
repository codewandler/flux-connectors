          "message_pointer": "/error/message"
        }
      },
      "repeatability_condition": "the connector requires an `Idempotency-Key` header on every call, and Stripe replays a keyed POST from its own cache for 24 hours rather than re-executing it, so a retried capture captures once and returns the first result",
      "request": {
        "headers": {
          "Idempotency-Key": {
            "$param": "idempotency_key"
          }
        },
        "method": "POST",
