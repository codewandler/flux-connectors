op babelforce-bulk-delete-business-hours(body: Any) -> Any
  description "Bulk-delete business-hours profiles"
  risk "destructive"
  idempotency "non_idempotent"
  effects ["network"]
  expose false

  base = "https://services.babelforce.com"
  url = fmt("{base}/api/v2/business-hours/bulk")
  content_type = "application/json"
  payload = parse(body, as: "json")
  response = http.request(body: payload, headers: { "content-type": content_type }, method: "DELETE", url)
  return response
